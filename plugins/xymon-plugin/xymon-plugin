#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Install, update and remove the plugins, on the Xymon server, on a
# monitored host's Xymon client or on your own machine, with nothing but a
# POSIX shell and the usual tools: no make.
#
#   XYMONHOME=/usr/lib/xymon/server ./xymon-plugin install --server PLUGIN...|--all
#   XYMONHOME=/usr/lib/xymon/client ./xymon-plugin install --client PLUGIN...|--all
#   ./xymon-plugin install --tools PLUGIN...|--all    on your own machine, under PREFIX (~/.local)
#   ./xymon-plugin update [--server|--client|--tools] [PLUGIN...]
#   ./xymon-plugin enable|disable [--server] [PLUGIN...]   a server task on or off
#   ./xymon-plugin remove [--server|--client|--tools] PLUGIN...|--all
#   ./xymon-plugin status [--server|--client|--tools] [PLUGIN...]  what is installed, and on
#
# --server, --client and --tools name the part a verb acts on, one at a
# time: the tools are the person's, a Xymon part its tree's owner's.
# Without one, on a terminal, the server part is said and acted on, but a
# client's tree named is refused, the command with --client given; off a
# terminal, a verb that changes something needs one; status and verify
# cover every part, outdated the server part and the tools, a standalone
# client's tree too; a server's own client tree with --client named.
# --client takes a standalone client's tree, or, XYMONHOME
# naming a server, that server's own client tree (S36), whose ext/ the
# person running it owns, and installs, updates and removes there only the
# files, manual page and task of a plugin's client-* lines, the task as a
# server part's; no virtualenv yet; status and verify read it, whoever owns it.
# Run as root, a verb that changes the tools is refused unless DESTDIR or
# PREFIX is given; status --tools under sudo reads the tools of the person
# who typed it, SUDO_USER.
#
# install and remove need a plugin named, or --all. install refuses a
# plugin already installed, and update one that is not; --all, and a plugin
# one needs, pass over those installed already, saying so. A server plugin
# whose xymon: line names a newer Xymon than $XYMONHOME/bin/xymon --version
# gives is refused, unless --force. A development version, 4.3.32-dev,
# comes after 4.3.31 and before 4.3.32: a plugin that needs 4.3.32 installs
# on it with a warning, as it may lack what 4.3.32 brought. A plugin that
# needs another installs it first, part by part, and a removal is refused
# while one installed needs the plugin removed. An install starts nothing: a
# server task is on when tasks.d/PLUGIN-server.cfg, a link to it, is there, which
# enable makes and disable removes. update replaces each plugin's directory
# as a whole, and keeps the admin's task files, whether each is on, web
# server snippets and data. Settings come from the environment, or as
# NAME=value arguments: XYMONHOME, PREFIX, MANDIR (/usr/share/man;
# Homebrew's share/man for a Xymon it installed), DESTDIR, which stages
# either part for a package, and PYTHON, the Python a virtualenv is made
# with.
#
# What each plugin installs is in its plugins/NAME/PLUGIN file. On a server
# the plugins go under $XYMONHOME/ext/, one directory each, and a plugin that
# needs another finds it beside itself; elsewhere they go under
# $PREFIX/libexec/xymon-plugins/ the same way, with a command per plugin in
# $PREFIX/bin. Each records its version beside its files, in VERSION, and
# its PLUGIN file, by which it is uninstalled, enabled and updated later;
# the virtualenv they share sits beside them, as venv/. Every path is
# quoted, and escaped before it reaches sed: a directory with a space, an &
# or a | in its name is a directory like any other.

ROOT=$(cd "$(dirname "$0")" && pwd)
# The name it runs as: its own, as a plugin, plugins/$self/ (S1).
self=${0##*/}
# Run as plugins/$self/$self of a checkout or an archive, rather than
# through the link at its top -- where links are not kept: Git for
# Windows, a ZIP unpacked on Windows -- the tree's top is two levels up.
# Only where that top holds this very directory with its own PLUGIN file:
# the copy installed in ext/$self/ has none above it, and stays as it is.
case $ROOT in
*/plugins/"$self")
	root_top=$(cd "$ROOT/../.." && pwd) || root_top=
	root_dir=
	[ -z "$root_top" ] || root_dir=$(cd "$root_top/plugins/$self" 2>/dev/null && pwd) || root_dir=
	if [ -n "$root_dir" ] && [ "$root_dir" = "$ROOT" ] && [ -f "$root_dir/PLUGIN" ] \
		&& [ "$(sed -n 's/^name: *//p' "$root_dir/PLUGIN")" = "$self" ]; then
		ROOT=$root_top
	fi
	;;
esac

die() { printf 'xymon-plugin: %s\n' "$*" >&2; exit 1; }

# What is installed is read by other users -- the Xymon user that runs the
# tasks, the web server that serves /plugins -- whoever installs it: under
# umask 077 a new directory would be its owner's alone. Every file is given
# its mode as it is written; this gives every directory its own.
umask 022
usage() {
	echo "usage: ./xymon-plugin install|update|enable|disable|remove|status|verify|outdated|clean [--server|--client|--tools] [--all] [--venv] [--force] [--yes] [--xymon-home PATH] [PLUGIN...] [NAME=value...]" >&2
	echo "       ./xymon-plugin --version" >&2
	exit 2
}

# The installer is a plugin, plugins/xymon-plugin/ (S1): its version is its
# PLUGIN file's -- beside it once installed; under plugins/ in a checkout or
# an archive, where ./xymon-plugin is a link to it; beside it as
# $self.PLUGIN in the /plugins stage, where a PLUGIN file would make the
# stage look like a plugin installed. Found by the name it is run as, so
# that no plugin's name is written here.
if [ "${1:-}" = --version ]; then
	for f in "$ROOT/PLUGIN" "$ROOT/plugins/$self/PLUGIN" "$ROOT/$self.PLUGIN"; do
		if [ -f "$f" ] && [ "$(sed -n 's/^name: *//p' "$f")" = "$self" ]; then
			echo "$self $(sed -n 's/^version: *//p' "$f")"; exit 0
		fi
	done
	die "no PLUGIN file of $self beside it, under plugins/$self/, nor as $self.PLUGIN"
fi
# No verb: on a terminal, the dialogue; off one, the usage (S17).
if [ $# -eq 0 ]; then
	[ -t 0 ] && [ -t 1 ] || usage
	set -- dialogue
fi
VERB=$1; shift
case $VERB in
	dialogue) ;;
	install|update|enable|disable|remove|status|verify|outdated|clean) ;;
	venv) die "venv is now part of install and update: ./xymon-plugin update --server --venv, or --tools --venv" ;;
	install-server|install-tools|uninstall-server|uninstall-tools|enable-server|disable-server|enable-client|disable-client|status-server|status-tools|venv-server|venv-tools)
		v=${VERB%-*}; [ "$v" = uninstall ] && v=remove
		[ "$v" = venv ] && die "$VERB is now: ./xymon-plugin update --${VERB##*-} --venv"
		die "$VERB is now: ./xymon-plugin $v --${VERB##*-}" ;;
	install-client|uninstall-client|status-client) v=${VERB%-*}; [ "$v" = uninstall ] && v=remove; die "$VERB is now: ./xymon-plugin $v --client" ;;
	*-client) die "$VERB: a client part has no virtualenv; install, update, remove, status and verify take --client" ;;
	*) usage ;;
esac
NAMES=
RUNMSG=
# Set once this run makes, removes or fills a virtualenv (manifest).
VENV_CHANGED=
PS_SAID=
REMEMBER=
CLIENT_CHECKED=
FORCE=
VENV_FETCH=
ALL=
YES=
SEL_SERVER=
SEL_TOOLS=
SEL_CLIENT=
PREFIX_GIVEN=${PREFIX:+1}
XH_OPT=
while [ $# -gt 0 ]; do
	a=$1; shift
	case $a in
		--xymon-home=*) XH_OPT=${a#--xymon-home=} ;;
		--xymon-home) [ $# -gt 0 ] || usage; XH_OPT=$1; shift ;;
		--force) FORCE=1 ;;
		--venv) VENV_FETCH=1 ;;
		--all) ALL=1 ;;
		--yes) YES=1 ;;
		--server) SEL_SERVER=1 ;;
		--tools) SEL_TOOLS=1 ;;
		--client) SEL_CLIENT=1 ;;
		-*) usage ;;
		PREFIX=*) PREFIX_GIVEN=1; export "$a" ;;
		*=*) export "$a" ;;
		*) NAMES="$NAMES $a" ;;
	esac
done
ROOTUSER=
[ "$(id -u)" -ne 0 ] || ROOTUSER=1
# status --tools under sudo reads the tools of the person who typed it.
if [ -z "$PREFIX_GIVEN" ] && [ -n "$ROOTUSER" ] && { [ "$VERB" = status ] || [ "$VERB" = verify ] || [ "$VERB" = outdated ]; } && [ -n "${SUDO_USER:-}" ]; then
	case $SUDO_USER in
		*[!A-Za-z0-9._-]*|-*) ;;
		*) eval "h=~$SUDO_USER"; [ -d "$h" ] && PREFIX=$h/.local ;;
	esac
fi

XYMONHOME=${XYMONHOME:-}
DESTDIR=${DESTDIR:-}
# What chose the installation, said before anything changes: --xymon-home,
# which wins over XYMONHOME, XYMONHOME, or detection, confirmed.
CHOSEN=
# The server whose own client tree XYMONHOME is, once --client chose it (S36).
OWNOF=
if [ -n "$XH_OPT" ]; then
	if [ -n "$XYMONHOME" ] && [ "$XYMONHOME" != "$XH_OPT" ]; then CHOSEN="named by --xymon-home, over XYMONHOME=$XYMONHOME"
	else CHOSEN="named by --xymon-home"; fi
	XYMONHOME=$XH_OPT
elif [ -n "$XYMONHOME" ]; then
	CHOSEN="named by XYMONHOME"
fi
# A tree that is there, absolute and spelt once: the manual page's link and
# MANIFEST are built from it, and . or a trailing slash would make them
# wrong (S25). Logical, not resolved: Homebrew's opt/ link is kept, which
# MANDIR is chosen by. Under DESTDIR it names a path in the stage, as given.
if [ -z "$DESTDIR" ] && [ -d "$XYMONHOME" ]; then
	XYMONHOME=$(CDPATH='' cd -- "$XYMONHOME" && pwd) || exit 1
fi
MANDIR_GIVEN=${MANDIR:+1}
# MANDIR, /usr/share/man by default, which macOS lets no one write: for a
# Xymon that Homebrew installed, XYMONHOME under its prefix, Homebrew's
# share/man, where man looks.
mandir() {
	[ -z "$MANDIR_GIVEN" ] || return 0
	MANDIR=/usr/share/man
	bp=$(brew --prefix 2>/dev/null) || bp=
	if [ -n "$bp" ]; then
		case $XYMONHOME in "$bp"/*) MANDIR=$bp/share/man ;; esac
	fi
}
mandir
PREFIX=${PREFIX:-$HOME/.local}
# PYTHON given is also the one an install makes the virtualenv from, in
# place of its search for one.
PYTHON_GIVEN=${PYTHON:-}
PYTHON=${PYTHON:-python3}

# inside PATH -- where PATH, absolute and without DESTDIR, lies under
# DESTDIR, each part followed inside it: a link to an absolute path taken
# from DESTDIR, a relative one from where it lies, a .. stopping at
# DESTDIR. Xymon's own staged install links $XYMONHOME/etc to INSTALLETCDIR,
# /etc/xymon on Debian and with the RPM, and a packager may link any
# directory of the stage the same way: followed as they are, such links
# lead out of the stage into the build host's directories, and an install
# under DESTDIR writes nothing outside it. A link that cannot be read, or
# forty in a row, stops the run rather than be guessed at. Without
# DESTDIR, PATH as it is. Run in $(...): its variables stay there.
inside() {
	if [ -z "$DESTDIR" ]; then printf '%s\n' "$1"; return; fi
	rest=$1 cur= hops=0
	while [ -n "$rest" ]; do
		case $rest in /*) rest=${rest#/}; continue ;; esac
		part=${rest%%/*}
		if [ "$part" = "$rest" ]; then rest=; else rest=${rest#*/}; fi
		case $part in
			.) continue ;;
			..) cur=${cur%/*}; continue ;;
		esac
		if [ -L "$DESTDIR$cur/$part" ]; then
			hops=$((hops + 1))
			[ "$hops" -le 40 ] || die "more than 40 links under DESTDIR at $cur/$part"
			t=$(readlink "$DESTDIR$cur/$part") && [ -n "$t" ] || die "cannot read the link $DESTDIR$cur/$part"
			case $t in /*) cur= ;; esac
			rest=$t${rest:+/$rest}
		else
			cur=$cur/$part
		fi
	done
	printf '%s\n' "$DESTDIR${cur:-/}"
}

# server_paths -- what the server's part uses, from XYMONHOME: again once
# the installation is chosen.
server_paths() {
	EXTROOT=$(inside "$XYMONHOME/ext") || exit 1
	ETC=$(inside "$XYMONHOME/etc") || exit 1
	# A client's tree has its tasks launched from clientlaunch.d/, which its
	# clientlaunch.cfg reads; a server's from tasks.d/ and tasks.cfg (S6).
	# The first call, before marks is defined, is a server's.
	# A server's own client tree (S36, OWNOF the server) has its tasks
	# launched by that server's xymonlaunch: LAUNCHHOME is the tree whose
	# launcher reads them, XYMONHOME's own but there.
	LAUNCHHOME=${OWNOF:-$XYMONHOME}
	if [ -n "${OWNOF:-}" ]; then
		TPART=client TASKD=tasks.d LAUNCHCFG=tasks.cfg
	elif [ -z "${1:-}" ] && [ -z "${DESTDIR:-}" ] && [ "$(marks "$XYMONHOME")" = client ]; then
		TPART=client TASKD=clientlaunch.d LAUNCHCFG=clientlaunch.cfg
	else
		TPART=server TASKD=tasks.d LAUNCHCFG=tasks.cfg
	fi
	TASKKEY=$TPART-task
	TASKDIR=$(inside "$LAUNCHHOME/etc/$TASKD") || exit 1
	# What other machines install from, which the API serves at /plugins:
	# each plugin installed on the server stages its directory here, as in
	# the repository, beside this script and LICENSE.
	DIST=$EXTROOT/xymon-plugins-dist
}
server_paths early
TOOLSROOT=$(inside "$PREFIX/libexec/xymon-plugins") || exit 1
BIN=$(inside "$PREFIX/bin") || exit 1
TOOLSMAN1=$(inside "$PREFIX/share/man/man1") || exit 1

# field PLUGIN KEY -- the value of KEY in the plugin's PLUGIN file, one line
# for each time the key appears; nothing for a plugin gone from the checkout.
field() { [ ! -f "$ROOT/plugins/$1/PLUGIN" ] || sed -n "s/^$2: //p" "$ROOT/plugins/$1/PLUGIN"; }

# held ROOT PLUGIN KEY -- the value of KEY in the PLUGIN file installed with
# the plugin under ROOT ($EXTROOT or $TOOLSROOT): the record of what that
# install put in place, which uninstall, enable, disable and an update act
# on, rather than on what this checkout would install. An install from
# before the record has none: the checkout's is read, as it was. The record
# lies in a directory the Xymon user can write, so a name read from it is
# used only once plain says it names no other directory.
held() {
	if [ -f "$1/$2/PLUGIN" ] && [ ! -L "$1/$2/PLUGIN" ]; then
		sed -n "s/^$3: //p" "$1/$2/PLUGIN"
	elif [ -f "$ROOT/plugins/$2/PLUGIN" ]; then
		field "$2" "$3"
	fi
}

# sedesc TEXT -- TEXT escaped for the right-hand side of a sed s|||.
sedesc() { printf '%s\n' "$1" | sed -e 's/[\\&|]/\\&/g'; }

# say PLUGIN KEY -- print the plugin's message KEY, its placeholders filled
# with the paths of the installed system, never the stage's under DESTDIR:
# the message is for whoever runs that system.
say() {
	t=$(field "$1" "$2")
	# Xymon's runtime directory, read only for a message that names it; one
	# the install cannot read is named in words, not as a variable a shell
	# would take for set.
	r=
	case $t in *@XYMONRUNDIR@*) r=${RUNDIR:-$(rundir)} || exit 1 ;; esac
	# One the install cannot read: the lines naming it are left out --
	# conf says to put the directory in the snippets -- rather than give a
	# command that cannot be typed as it is.
	[ -z "$t" ] || printf '%s\n' "$t" | { if [ -z "$r" ]; then sed '/@XYMONRUNDIR@/d'; else cat; fi; } | sed -e "s|@ETC@|$(sedesc "$XYMONHOME/etc")|g" -e "s|@TASKDIR@|$(sedesc "$XYMONHOME/etc/tasks.d")|g" \
		-e "s|@XYMONHOME@|$(sedesc "$XYMONHOME")|g" -e "s|@XYMONRUNDIR@|$(sedesc "$r")|g"
}

# Every plugin, by the directories under plugins/ that hold a PLUGIN file.
all_plugins() {
	for f in "$ROOT"/plugins/*/PLUGIN; do
		[ -e "$f" ] && basename "$(dirname "$f")"
	done
}

# known PLUGIN -- refuse a name that is not a plugin here, or that could
# name a directory other than one plugin's.
known() {
	plain "$1" || die "not a plugin name: '$1'"
	[ -f "$ROOT/plugins/$1/PLUGIN" ] || [ -f "$EXTROOT/$1/PLUGIN" ] || [ -f "$TOOLSROOT/$1/PLUGIN" ] \
		|| die "no plugin $1 here: the plugins are $(echo $(all_plugins))"
}

# needs PLUGIN PART [ROOT] -- the plugins its PART part needs, by its
# PART-needs: line, or by the record under ROOT when given: each NAME, the
# same part of it, or NAME:part for another part. A part this run does not
# install -- a server install installs no tools, nor a client part, each
# going elsewhere -- is a need it cannot hold, refused.
needs() {
	if [ -n "${3:-}" ]; then v=$(held "$3" "$1" "$2-needs"); else v=$(field "$1" "$2-needs"); fi
	for n in $v; do
		case $n in
			*:*) want=${n#*:}; n=${n%%:*} ;;
			*) want=$2 ;;
		esac
		case $want in
			server|client|tools) ;;
			*) die "$1's $2-needs: names $n:$want, and $want is no part: server, client or tools" ;;
		esac
		[ "$want" = "$2" ] || die "$1's $2 part needs $n's $want part, which an install of the $2 part cannot hold"
		echo "$n"
	done
}

# depth PLUGIN PART ROOT -- how many plugins deep its PART part stands on,
# by the records of the plugins installed under ROOT: 0 for one that needs
# none, as an uninstall goes from the deepest up among what is installed.
depth() {
	# Always run in $(...): globbing off for this subshell only.
	set -f
	d=0
	for n in $(needs "$1" "$2" "$3"); do
		plain "$n" || continue
		x=$(depth "$n" "$2" "$3"); [ $((x + 1)) -gt $d ] && d=$((x + 1))
	done
	echo $d
}

# older A B -- true when version A is older than B, comparing X.Y.Z by
# number; awk reads 32-dev as 32.
older() {
	awk -v a="$1" -v b="$2" 'BEGIN {
		n = split(a, x, "."); m = split(b, y, ".")
		for (i = 1; i <= (n > m ? n : m); i++) {
			if (x[i] + 0 < y[i] + 0) exit 0
			if (x[i] + 0 > y[i] + 0) exit 1
		}
		exit 1
	}'
}

# declared_ok PLUGIN -- refuse, before anything is installed, a data: or
# writes: line S28 does not allow, in the plugin or one it needs: data: a
# directory $XYMONVAR/NAME/, $XDG_CONFIG_HOME/NAME/, $XDG_CACHE_HOME/NAME/
# or $XDG_STATE_HOME/NAME/, NAME the plugin's own or one it needs; writes:
# one file, then the command that changes it, in parentheses.
DECLARED=
declared_ok() {
	case " $DECLARED " in *" $1 "*) return 0 ;; esac
	DECLARED="$DECLARED $1"
	own=" $1 "
	for n in $(field "$1" server-needs) $(field "$1" tools-needs) $(field "$1" client-needs); do
		own="$own${n%%:*} "
	done
	while IFS= read -r d; do
		[ -n "$d" ] || continue
		case $d in
			'$XYMONVAR/'*/|'$XDG_CONFIG_HOME/'*/|'$XDG_CACHE_HOME/'*/|'$XDG_STATE_HOME/'*/) ;;
			*) die "$1's data: $d is no directory S28 allows: \$XYMONVAR/NAME/, \$XDG_CONFIG_HOME/NAME/, \$XDG_CACHE_HOME/NAME/ or \$XDG_STATE_HOME/NAME/" ;;
		esac
		n=${d#*/}; n=${n%/}
		case $n in ''|*/*) die "$1's data: $d names no single directory" ;; esac
		case $own in *" $n "*) ;; *) die "$1's data: $d is in the name of $n, which is neither $1 nor a plugin it needs" ;; esac
	done <<EOF
$(field "$1" data)
EOF
	while IFS= read -r w; do
		[ -n "$w" ] || continue
		case $w in
			?*' ('?*')') ;;
			*) die "$1's writes: $w is not a file, then the command that changes it in parentheses" ;;
		esac
		f=${w% (*}
		case $f in */|*' '*) die "$1's writes: $w names no single file" ;; esac
	done <<EOF
$(field "$1" writes)
EOF
	for n in $(field "$1" server-needs) $(field "$1" tools-needs) $(field "$1" client-needs); do
		n=${n%%:*}
		[ ! -f "$ROOT/plugins/$n/PLUGIN" ] || declared_ok "$n"
	done
}

# xymon_ok PLUGIN -- refuse the plugin, or one it needs, when its directory
# in ext/ is no install's, or its xymon: line names a newer Xymon than the
# server's, unless --force; say so when the server's cannot be read. Run
# on every plugin to install before any is touched.
CHECKED=
xymon_ok() {
	case " $CHECKED " in *" $1 "*) return 0 ;; esac
	CHECKED="$CHECKED $1"
	# Its directory in ext/ absent, or one an install left: install and
	# update replace it whole, and ext/ may hold anything (S20).
	part_left server "$1"
	aside_ok "$1"
	replaced "$1"
	ns=$(needs "$1" server) || exit 1
	for n in $ns; do xymon_ok "$n"; done
	want=$(field "$1" xymon); [ -n "$want" ] || return 0
	xymon=$(inside "$XYMONHOME/bin/xymon") || exit 1
	have=$("$xymon" --version 2>/dev/null | sed -n 's/^Xymon version \([0-9][0-9.]*[^ ]*\).*/\1/p')
	if [ -z "$have" ]; then
		echo "xymon-plugin: $1 needs Xymon $want or newer, and the version of $xymon could not be read: not checked" >&2
	elif older "$have" "$want"; then
		[ -n "$FORCE" ] || die "$1 needs Xymon $want or newer, and this server's is $have: --force installs it anyway"
		echo "xymon-plugin: $1 needs Xymon $want or newer, and this server's is $have: installed anyway, as --force asks" >&2
	elif [ "$have" != "${have%%-*}" ] && ! older "$want" "${have%%-*}"; then
		echo "xymon-plugin: $1 needs Xymon $want or newer, and this server's is $have, on the way to $want: not checked" >&2
	fi
	return 0
}

# reads_d -- say when the server's xymonserver.cfg does not read
# xymonserver.d/, where the plugins' settings go: a configuration kept from
# before 4.3.31 would ignore them all, without a word.
reads_d() {
	c=$(inside "$XYMONHOME/etc/xymonserver.cfg") || exit 1
	[ -f "$c" ] || return 0
	grep -q '^[[:space:]]*\(optional[[:space:]]\{1,\}\)\{0,1\}directory[[:space:]]\{1,\}\(.*/\)\{0,1\}xymonserver\.d/\{0,1\}[[:space:]]*$' "$c" && return 0
	echo "xymon-plugin: $c does not read xymonserver.d/, where the plugins' settings go: add the line" >&2
	echo "  optional directory $XYMONHOME/etc/xymonserver.d" >&2
	echo "as Xymon's own xymonserver.cfg has it since 4.3.31" >&2
}

# marks TREE -- what TREE is by Xymon's marks, a whole pair counting before
# any single mark: server, when both of a server's are there, a client's
# files with them or not, as where server and client share /etc/xymon;
# else client; else "some MARK..." naming the marks there; else none.
SERVER_MARKS="etc/xymonserver.cfg bin/xymond"
CLIENT_MARKS="etc/xymonclient.cfg bin/xymonclient.sh"
marks() {
	found=
	for m in $SERVER_MARKS $CLIENT_MARKS; do
		if [ -e "$1/$m" ]; then found="$found $m"; fi
	done
	case " $found " in
		*" etc/xymonserver.cfg"*" bin/xymond "*) echo server ;;
		*" etc/xymonclient.cfg"*" bin/xymonclient.sh "*) echo client ;;
		"  ") echo none ;;
		*) echo "some$found" ;;
	esac
}

# canon DIR -- DIR with every link resolved, or nothing when it is no
# directory: one tree reached by two paths, as Homebrew's opt/ and Cellar/,
# is one tree.
canon() { (cd "$1" 2>/dev/null && pwd -P); }

# client_of SERVER -- the client tree SERVER's xymonserver.cfg names as its
# XYMONCLIENTHOME, resolved, or nothing when it names none or a variable.
client_of() {
	c=$(xch "$1")
	case $c in ''|*'$'*) return 0 ;; esac
	canon "$c"
}

# xymon_trees -- the Xymon installations on this machine, "KIND DIR" each:
# those XYMON_PLUGINS_TREES names, colon-separated, the packages' usual
# paths, Homebrew's among them where brew is installed, the trees of a
# running xymonlaunch, and the xymon user's home -- not the current
# directory; with XYMON_PLUGINS_TREES_ONLY set, those it names alone. Each is told once, by its resolved path, shown as found; a
# client tree a server found names as its own is part of that server, not
# told apart. It only tells what is here: nothing is chosen from it.
xymon_trees() {
	# Inside $( ), a case pattern opens with "(": bash 3.2, macOS's /bin/sh,
	# reads a bare "pattern)" there as the end of the substitution.
	trees=$({
		printf '%s\n' "${XYMON_PLUGINS_TREES:-}" | tr ':' '\n'
		# XYMON_PLUGINS_TREES_ONLY, for the tests: the trees named above, and
		# none of this machine's.
		[ -z "${XYMON_PLUGINS_TREES_ONLY:-}" ] || exit 0
		for t in /usr/lib/xymon/server /usr/lib/xymon/client /usr/local/xymon/server \
			/usr/local/xymon/client /home/xymon/server /home/xymon/client; do
			printf '%s\n' "$t"
		done
		bp=$(brew --prefix 2>/dev/null) && [ -n "$bp" ] && printf '%s\n' "$bp/opt/xymon-server/server"
		# A running xymonlaunch: the tree its program, or its --config,
		# lies in.
		ps -A -o args= 2>/dev/null | awk '/xymonlaunch/ {
			if ($1 ~ /\/bin\/xymonlaunch$/) { d = $1; sub(/\/bin\/xymonlaunch$/, "", d); print d }
			for (i = 2; i <= NF; i++) if ($i ~ /^--config=/) { c = substr($i, 10); sub(/\/etc\/[^\/]*$/, "", c); print c }
		}'
		eval "xh=~xymon" 2>/dev/null
		case $xh in ("~xymon"|'') ;; (*) printf '%s\n%s\n%s\n' "$xh" "$xh/server" "$xh/client" ;; esac
	} | while IFS= read -r t; do
		[ -n "$t" ] || continue
		c=$(canon "$t") || continue
		[ -n "$c" ] || continue
		k=$(marks "$t")
		case $k in (server|client) printf '%s %s %s\n' "$c" "$k" "$t" ;; esac
	done | awk '!seen[$1]++ { print }')
	owned=
	while read -r c k t; do
		[ "$k" = server ] || continue
		o=$(client_of "$t"); [ -z "$o" ] || owned="$owned $o "
	done <<EOF
$trees
EOF
	while read -r c k t; do
		[ -n "$c" ] || continue
		case $owned in *" $c "*) continue ;; esac
		printf '%s %s\n' "$k" "$t"
	done <<EOF
$trees
EOF
}

# client_home SERVER -- the client tree SERVER's xymonserver.cfg names as
# its XYMONCLIENTHOME, as written, or nothing.
client_home() {
	c=$(xch "$1")
	case $c in *'$'*) c= ;; esac
	printf '%s\n' "$c"
}
# xch SERVER -- XYMONCLIENTHOME as SERVER's xymonserver.cfg writes it, a
# variable in it or not: the last of that file and its xymonserver.d/, as
# cfgval reads them; "export" before it, quotes, a comment or blanks after
# it taken off.
xch() {
	for f in "$1/etc/xymonserver.cfg" "$1/etc/xymonserver.d"/*; do
		[ -f "$f" ] || continue
		case ${f##*/} in .*|*~|*,v|README*|*.dpkg-new|*.dpkg-orig|*.rpmsave|*.rpmorig|*.rpmnew) continue ;; esac
		sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}XYMONCLIENTHOME[[:space:]]*=[[:space:]]*//p' "$f"
	done | tail -n 1 | sed -e 's/^"\([^"]*\)".*/\1/' -e t -e "s/^'\([^']*\)'.*/\1/" -e t -e 's/[[:space:]#].*$//'
}

# The repository the plugins are released from.
REPO="xymon-monitoring/xymon-plugins"
# How long one request to GitHub may take, in seconds, where curl or GNU
# wget can bound it: a network that answers nothing must not hold outdated
# forever. gh has no such bound; the plugins column's task is bounded by
# xymonlaunch's MAXTIME, and outdated run by hand by an interrupt.
# XYMON_PLUGINS_TIMEOUT, for the tests.
NET_T=${XYMON_PLUGINS_TIMEOUT:-30}
case $NET_T in ''|*[!0-9]*|0) NET_T=30 ;; esac

# releases -- the plugins' published releases, "NAME X.Y.Z" a line, from
# GitHub: with gh when it answers, drafts left out as an anonymous reader
# does not see them; else the API, anonymously, through curl or wget. An
# answer with no release is one, not a failure; when none reaches GitHub it
# says why, and fails (S32).
releases() {
	GHFAILED=
	# XYMON_PLUGINS_NO_GH: not gh, which no time bounds -- for the plugins
	# column's task, which xymonlaunch can stop but not what it started.
	if [ -z "${XYMON_PLUGINS_NO_GH:-}" ] && command -v gh >/dev/null 2>&1 \
		&& tags=$(gh api --hostname github.com "repos/$REPO/releases?per_page=100" --paginate \
			--jq '.[] | select(.draft == false) | .tag_name' 2>/dev/null); then
		:
	else
		[ -z "${XYMON_PLUGINS_NO_GH:-}" ] && command -v gh >/dev/null 2>&1 && GHFAILED=1
		tags=$(anon_releases) || exit 1
	fi
	# A tag is NAME/vX.Y.Z, its name as plain() allows a plugin's, each
	# number of its version one digit or more; any other is no plugin's.
	printf '%s\n' "$tags" | sed -n 's|^\([A-Za-z0-9._+-][A-Za-z0-9._+-]*\)/v\([0-9][0-9]*\(\.[0-9][0-9]*\)*\)$|\1 \2|p'
}

# anon_releases -- the tag names of every release, page after page of
# GitHub's API read anonymously (drafts are not shown to an anonymous
# reader), through curl, else wget. The answer is JSON; a tag name is read
# where a key "tag_name" opens a field, so that the words of a release's
# text, its quotes escaped, are not taken for one.
anon_releases() {
	page=1 all='' tok_said=''
	while :; do
		u="https://api.github.com/repos/$REPO/releases?per_page=100&page=$page"
		if command -v curl >/dev/null 2>&1; then
			# GH_TOKEN, when set and plainly a token, as gh would send it:
			# given on curl's standard input (-K -), never on its command
			# line, where ps shows it to every user.
			case ${GH_TOKEN:-} in
				'') tok= ;;
				*[!A-Za-z0-9_]*)
					tok=
					[ -n "$tok_said" ] || echo "xymon-plugin: GH_TOKEN holds a character no GitHub token has: GitHub is read without it" >&2
					tok_said=1 ;;
				*) tok="header = \"Authorization: Bearer $GH_TOKEN\"" ;;
			esac
			j=$(printf '%s\n' "$tok" | curl -fsSL -K - --connect-timeout 10 --max-time "$NET_T" \
				-H 'Accept: application/vnd.github+json' "$u" 2>&1) || die "cannot read $u: $j"
		elif command -v wget >/dev/null 2>&1; then
			# GNU wget's -T; busybox's has none. No token: wget would show it
			# on its command line.
			if [ -n "${GH_TOKEN:-}" ] && [ -z "$tok_said" ]; then
				echo "xymon-plugin: wget is not given GH_TOKEN, which its command line would show: GitHub is read without it" >&2
				tok_said=1
			fi
			wv=$(wget --version 2>/dev/null) || wv=
			case $wv in *"GNU Wget"*) wt="-T $NET_T -t 1" ;; *) wt= ;; esac
			# shellcheck disable=SC2086 # wt is options or nothing
			j=$(wget -q $wt -O - "$u") || die "cannot read $u: wget failed (exit status $?)"
		elif [ -n "${GHFAILED:-}" ]; then
			die "gh could not read the releases from GitHub, and neither curl nor wget is here to read them"
		elif [ -n "${XYMON_PLUGINS_NO_GH:-}" ]; then
			die "outdated reads the releases from GitHub with curl or wget, gh being left out (XYMON_PLUGINS_NO_GH): neither is here"
		else
			die "outdated reads the releases from GitHub, with gh, curl or wget: none is here"
		fi
		t=$(printf '%s\n' "$j" | tr ',' '\n' \
			| sed -n 's/^[][{[:space:]]*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p')
		[ -n "$t" ] || break
		# ponytail: 60 pages, as many as GitHub answers, from one address,
		# in an hour; a 61st with releases on it is said rather than a
		# partial list -- an empty one, 6000 exactly, is not.
		[ "$page" -le 60 ] || die "github.com/$REPO has more than the 6000 releases outdated reads without gh: read them with gh, logged in"
		all="$all$t
"
		# A page short of a hundred is the last.
		[ "$(printf '%s\n' "$t" | wc -l)" -ge 100 ] || break
		page=$((page + 1))
	done
	printf '%s' "$all"
}

# latest PLUGIN -- the highest version $RELEASES has of PLUGIN, or nothing.
latest() {
	best=
	for lv in $(printf '%s\n' "$RELEASES" | awk -v n="$1" '$1 == n { print $2 }'); do
		if [ -z "$best" ] || older "$best" "$lv"; then best=$lv; fi
	done
	echo "$best"
}

# o_mode PATH, o_owner PATH -- PATH's mode, in octal, and its owner's name
# (or uid), from ls -ld, as GNU, BSD and busybox all print it.
o_mode() {
	# shellcheck disable=SC2012 # one path, its mode
	ls -ld "$1" | awk '{ m = 0; for (i = 2; i <= 10; i++) { m = m * 2; if (substr($1, i, 1) !~ /[-ST]/) m++ } printf "%o", m }'
}
o_owner() {
	# shellcheck disable=SC2012 # one path, its owner
	ls -ld "$1" | awk '{ print $3 }'
}
# o_fix OWNER WHAT -- the chmod WHAT needs, run by OWNER: as is for one's
# own, with sudo for root's, as that user or with sudo for another's.
o_fix() {
	if [ "$1" = "$(id -un)" ]; then echo "chmod $2"
	elif [ "$1" = root ]; then echo "chmod $2, with sudo"
	else echo "chmod $2 as $1, or with sudo"
	fi
}

# o_cmd PART VERB PLUGIN -- the command that does VERB to PLUGIN there, as
# it is to be typed: the server's tree named, the tools' prefix when one
# was given.
o_cmd() {
	if [ "$1" = server ]; then echo "XYMONHOME=$XYMONHOME ./xymon-plugin $2 --server $3"
	elif [ "$1" = client ]; then echo "./xymon-plugin $2 --client$(hx) $3"
	elif [ -n "$PREFIX_GIVEN" ]; then echo "./xymon-plugin $2 --tools $3 PREFIX=$PREFIX"
	else echo "./xymon-plugin $2 --tools $3"
	fi
}

# outdated_closed ROOT -- a line, when this user cannot list ROOT's
# plugins -- ROOT closed, or a directory above it -- which would be silent
# otherwise; false when it can, or when ROOT is not there.
outdated_closed() {
	o_c=$1
	while [ ! -d "$o_c" ] && [ "$o_c" != / ] && [ -n "$o_c" ]; do o_c=$(dirname "$o_c"); done
	[ -d "$o_c" ] || return 1
	if [ "$o_c" = "$1" ]; then
		[ ! -x "$o_c" ] || [ ! -r "$o_c" ] || return 1
	else
		[ ! -x "$o_c" ] || return 1
	fi
	o_o=$(o_owner "$o_c")
	echo "cannot read the plugins in $1: $o_c is mode $(o_mode "$o_c"), owned by $o_o. To fix: $(o_fix "$o_o" "755 '$o_c'")"
}

# outdated_names ROOT -- the plugins outdated reads there, each once: those
# status lists, and every directory it cannot enter, which would be silent
# otherwise -- but the installer's own, the virtualenv and /plugins' stage.
outdated_names() {
	o_l=$(with_installed "$1")
	printf '%s\n' "$o_l"
	# shellcheck disable=SC2086 # the names, split into one list
	o_l=" $(printf '%s ' $o_l)"
	for d in "$1"/*; do
		if [ -d "$d" ] && [ ! -x "$d" ] && plain "${d##*/}"; then
			case ${d##*/} in venv|"${DIST##*/}") continue ;; esac
			case $o_l in *" ${d##*/} "*) ;; *) echo "${d##*/}" ;; esac
		fi
	done
}

# outdated_part PART ROOT INDENT -- outdated's lines for the plugins of
# PART installed in ROOT, each after INDENT: NEWER set when one has a newer
# release, UNCOMPARED when a VERSION, or ROOT, cannot be read.
outdated_part() {
	if l=$(outdated_closed "$2"); then echo "$3$l"; UNCOMPARED=1; fi
	L=$LIST; [ -n "$NAMES" ] || L=$(outdated_names "$2")
	for n in $L; do
		o_rc=0; l=$(outdated_line "$1" "$2" "$n") || o_rc=$?
		case $o_rc in 0) ;; 7) UNCOMPARED=1 ;; *) exit 1 ;; esac
		[ -n "$l" ] || continue
		echo "$3$l"; case $l in *" released: "*) NEWER=1 ;; esac
	done
}

# outdated_line PART ROOT PLUGIN -- the plugin installed there against its
# latest release, one line; ending 7 where its VERSION cannot be compared,
# the line saying why and what fixes it, or how to find why. What VERSION
# holds is never echoed.
outdated_line() {
	o_d=$2/$3 o_v=$2/$3/VERSION
	# Its directory, which this user cannot enter.
	if [ -d "$o_d" ] && [ ! -x "$o_d" ]; then
		o_o=$(o_owner "$o_d")
		echo "$3: cannot read $o_v: $o_d is mode $(o_mode "$o_d"), owned by $o_o. To fix: $(o_fix "$o_o" "755 '$o_d'")"
		return 7
	fi
	# Not installed here -- named, or one of --all: nothing to say.
	if [ ! -e "$o_d" ] && [ ! -L "$o_d" ]; then
		return 0
	fi
	# A VERSION that does not lead to a file is no install, for update
	# too: install again.
	if [ -L "$o_v" ]; then
		if [ -f "$o_v" ]; then o_x=update; else o_x=install; fi
		echo "$3: $o_v is a link, which no install makes. To fix: $(o_cmd "$1" "$o_x" "$3")"
		return 7
	fi
	if [ ! -e "$o_v" ]; then
		echo "$3: $o_v is missing: an install that did not end. To fix: $(o_cmd "$1" install "$3")"
		return 7
	fi
	if [ ! -r "$o_v" ]; then
		o_o=$(o_owner "$o_v")
		echo "$3: cannot read $o_v: it is mode $(o_mode "$o_v"), owned by $o_o. To fix: $(o_fix "$o_o" "644 '$o_v'")"
		return 7
	fi
	# Its version, a bare X.Y.Z or this plugin's tag, checked to be one.
	if ! ov=$(head -n 1 "$o_v" 2>/dev/null); then
		echo "$3: cannot read $o_v. To find why: ls -ld '$o_d' '$o_v', then $(o_cmd "$1" verify "$3")"
		return 7
	fi
	case $ov in "$3"/v*) ov=${ov#"$3"/v} ;; esac
	case $ov in ""|*[!0-9.]*|.*|*.|*..*)
		echo "$3: $o_v holds no version. To fix: $(o_cmd "$1" update "$3")"
		return 7 ;;
	esac
	or=$(latest "$3")
	if [ -z "$or" ]; then
		echo "$3: $ov installed; no release of it is published"
	elif older "$ov" "$or"; then
		echo "$3: $ov installed; $or released: $(o_cmd "$1" update "$3"), from its release's archive"
	elif older "$or" "$ov"; then
		echo "$3: $ov installed; newer than its latest release, $or"
	else
		echo "$3: $ov installed; up to date"
	fi
}

# show_client SERVER -- its client tree's section: where it is, and each
# plugin installed there, or that there is none.
show_client() {
	c=$(client_home "$1")
	if [ -z "$c" ]; then echo "Its client: none named in $1/etc/xymonserver.cfg"; return 0; fi
	echo "Its client $c:"
	any=
	for d in "$c"/ext/*/; do
		[ -f "$d/PLUGIN" ] && [ -f "$d/VERSION" ] || continue
		d=${d%/}; any=1; echo "  ${d##*/}: $(sed -e 's|^.*/v||' "$d/VERSION") installed"
	done
	[ -n "$any" ] || echo "  no plugin"
}

# person_conf -- the directory of the person who typed the command:
# SUDO_USER's under sudo, else the account's that runs it.
person_conf() {
	if [ -n "$ROOTUSER" ] && [ -n "${SUDO_USER:-}" ]; then
		case $SUDO_USER in *[!A-Za-z0-9._-]*|-*) return 1 ;; esac
		eval "h=~$SUDO_USER"; printf '%s\n' "$h/.config/xymon-plugin"
	else
		printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/xymon-plugin"
	fi
}

# choose_tree KIND -- XYMONHOME, from the installations of KIND, server or
# client, detection finds, on a terminal: the one found proposed, Enter for
# yes; several listed, the one used last for KIND as the default, or none,
# said when it is gone. Off a terminal, or with none found, refused, the
# trees found named. The one chosen is remembered as the one used last --
# not under sudo, which only reads it.
choose_tree() {
	trees=$(xymon_trees)
	found=$(printf '%s\n' "$trees" | sed -n 's/^\([a-z]*\) \(.*\)/  \2, a Xymon \1/p')
	servers=$(printf '%s\n' "$trees" | sed -n "s/^$1 //p")
	# A client tree that would be refused -- a server's own, one in doubt,
	# an ext/ not the person's -- is not offered (S25).
	[ "$1" != client ] || servers=$(printf '%s\n' "$servers" | while IFS= read -r t; do
		[ -n "$t" ] && (XYMONHOME=$t; client_home_ok) >/dev/null 2>&1 && printf '%s\n' "$t"
	done)
	conf=$(person_conf) || conf=
	last=; [ -z "$conf" ] || last=$(cat "$conf/installation-used-last-$1" 2>/dev/null) || last=
	# A client may lie anywhere detection does not look: the one used
	# last is offered too, while its marks hold.
	if [ "$1" = client ] && [ -n "$last" ] && [ "$(marks "$last")" = client ] \
		&& (XYMONHOME=$last; client_home_ok) >/dev/null 2>&1; then
		lc=$(canon "$last") seen=
		while IFS= read -r t; do
			[ -z "$t" ] || [ "$(canon "$t")" != "$lc" ] || seen=1
		done <<EOF2
$servers
EOF2
		[ -n "$seen" ] || servers=$(printf '%s\n%s\n' "$servers" "$last" | sed '/^$/d')
	fi
	if ! { [ -t 0 ] && [ -t 1 ]; } || [ -z "$servers" ]; then
		one=; [ "$(printf '%s\n' "$servers" | grep -c .)" -ne 1 ] || one=$servers
		wh="<the Xymon $1 directory>"; [ "$1" != client ] || wh="<the Xymon client directory, or a server's for its own client tree>"
		die "XYMONHOME is not set: XYMONHOME=${one:-$wh} ./xymon-plugin $VERB --$1${NAMES:+ $(echo $NAMES)}${ALL:+ --all}${found:+
Xymon trees found here, none chosen:
$found}"
	fi
	n=$(printf '%s\n' "$servers" | wc -l | tr -d ' ')
	if [ "$n" -eq 1 ]; then
		printf 'Xymon %s: %s (detected). Use it? [Y/n] ' "$1" "$servers"
		read -r ans || ans=n
		case $ans in [Nn]*) none_chosen; return 1 ;; esac
		XYMONHOME=$servers
	else
		def=; i=0
		echo "Xymon ${1}s here:"
		while IFS= read -r t; do
			i=$((i + 1)); echo "  $i) $t"
			[ -n "$last" ] && [ "$(canon "$t")" = "$(canon "$last" 2>/dev/null)" ] && def=$i
		done <<EOF2
$servers
EOF2
		[ -z "$last" ] || [ -n "$def" ] || echo "The one used last, $last, is gone."
		printf 'Which one? [%s] ' "${def:-1-$n}"
		read -r ans || ans=
		[ -n "$ans" ] || ans=$def
		case $ans in ''|*[!0-9]*) none_chosen; return 1 ;; esac
		[ "$ans" -ge 1 ] && [ "$ans" -le "$n" ] || { none_chosen; return 1; }
		XYMONHOME=$(printf '%s\n' "$servers" | sed -n "${ans}p")
	fi
	CHOSEN="detected, confirmed"
	mandir
	server_paths
}

# none_chosen -- no installation taken at the proposal: a verb stops there,
# changing nothing; the dialogue, SOFT set, goes on with the person's tools.
none_chosen() { [ -n "${SOFT:-}" ] || die "no installation chosen: nothing done"; }

# remember_tree KIND -- XYMONHOME as the one used last for KIND, a file
# each, for the person who typed the command; not under sudo, which reads
# it only.
remember_tree() {
	[ -z "$DESTDIR" ] || return 0
	# Not a server's own client tree, which no proposal offers: named by
	# its server always, it would only take the place of the standalone
	# client used last (S25, S36).
	[ -z "$OWNOF" ] || return 0
	{ [ -n "$ROOTUSER" ] && [ -n "${SUDO_USER:-}" ]; } && return 0
	conf=$(person_conf) || return 0
	mkdir -p "$conf" 2>/dev/null && printf '%s\n' "$XYMONHOME" > "$conf/installation-used-last-$1" 2>/dev/null \
		|| echo "xymon-plugin: could not remember $XYMONHOME as the installation used last in $conf" >&2
}

# hx -- --xymon-home and XYMONHOME, for a command printed, which the
# dialogue runs by eval: quoted where a shell would split it, a quote in it
# written '\''.
hx() { printf ' --xymon-home %s' "$(shq "$LAUNCHHOME")"; }

# shq WORD -- WORD for a command printed, to paste or eval: quoted where a
# shell would split it, a quote in it written '\''.
shq() {
	case $1 in
		*[!A-Za-z0-9._/+-]*) printf "'%s'" "$(printf '%s\n' "$1" | sed "s/'/'\\\\''/g")" ;;
		*) printf '%s' "$1" ;;
	esac
}

# beside -- me, XYMONHOME resolved, and s2, the ../server beside it, from
# the resolved path: ., a trailing slash or a link to the tree finds the
# same server. Both empty when it is no directory.
beside() {
	me=$(canon "$XYMONHOME") || me=
	s2=; [ -z "$me" ] || s2=${me%/*}/server
}

# own_server -- the Xymon server whose own client tree XYMONHOME is: the
# ../server beside it, or a server found, naming it as its
# XYMONCLIENTHOME; or nothing.
own_server() {
	beside
	[ -n "$me" ] || return 0
	if [ "$(marks "$s2")" = server ] && [ "$(client_of "$s2")" = "$me" ]; then
		# Named as XYMONHOME spells it, its links kept, where that names the
		# same server: Homebrew's opt/, not the Cellar's version.
		ls2=${XYMONHOME%/*}/server
		if [ "$(canon "$ls2")" = "$(canon "$s2")" ]; then printf '%s\n' "$ls2"; else printf '%s\n' "$s2"; fi
		return 0
	fi
	xymon_trees | sed -n 's/^server //p' | while IFS= read -r t; do
		[ "$(client_of "$t")" = "$me" ] && { printf '%s\n' "$t"; break; }
	done
}

# own_refused -- refuse a server's own client tree, naming that server and
# the command for it.
own_refused() {
	srv=$(own_server)
	[ -z "$srv" ] || die "$XYMONHOME is the client tree of the Xymon server $srv: name the server, ./xymon-plugin $VERB --xymon-home $(shq "$srv") --server, or --client for its client tree"
}

# client_home_ok -- refuse, before anything changes, a client's tree named
# that the client part does not go in as such: a server's own, which its
# server names (S36), or one that may be --
# a ../server beside it, a server's, that names another tree or none this
# command can read, or a xymonserver.cfg in its etc/, as where a server's
# client shares that server's etc/ -- and one whose ext/ is not the
# person's running this: whoever writes a part's files updates and
# removes them, root as any other. Ownership is the uid ls -n gives,
# compared with id -u: find -user takes a name first on BSD, and a user
# named 1000 is not uid 1000. An ext/ that is a link is refused: it would
# take the plugins, and a removal, out of the tree. With read, for status
# and verify, which change nothing, whoever owns ext/ may read it.
client_home_ok() {
	# A server's own first: its ext/ may be a link, as Homebrew's is, which
	# the server's form takes.
	srv=$(own_server)
	# shellcheck disable=SC2086,SC2116 # NAMES, one line
	[ -z "$srv" ] || die "$XYMONHOME is the client tree of the Xymon server $srv: name the server, ./xymon-plugin $VERB --client --xymon-home $(shq "$srv")$(n=$(echo $NAMES); [ -z "$n" ] || printf ' %s' "$n")${ALL:+ --all}"
	[ ! -L "$XYMONHOME/ext" ] || die "$XYMONHOME/ext is a link: a client's plugins go in a directory of its tree, not elsewhere"
	[ -d "$XYMONHOME/ext" ] || die "$XYMONHOME has no directory ext/, where a client's plugins go"
	beside
	if [ -n "$s2" ] && [ "$(marks "$s2")" = server ]; then
		o=$(client_home "$s2")
		die "$XYMONHOME may be a server's own client: the Xymon server $s2 beside it names ${o:-no XYMONCLIENTHOME this command can read}${o:+ as its XYMONCLIENTHOME}; refused while in doubt"
	fi
	# A server found that names its client tree with a variable may name
	# this one: in doubt, as nothing here reads that variable.
	while IFS= read -r t; do
		case $(xch "$t") in *'$'*) die "$XYMONHOME may be a server's own client: the Xymon server $t names its client tree with a variable, which this command does not read; refused while in doubt" ;; esac
	done <<EOF
$(xymon_trees | sed -n 's/^server //p')
EOF
	[ ! -e "$XYMONHOME/etc/xymonserver.cfg" ] \
		|| die "$XYMONHOME may be a server's own client: its etc/ holds a xymonserver.cfg, as a server's client sharing that server's etc/ does; refused while in doubt"
	[ "${1:-}" != read ] || return 0
	# shellcheck disable=SC2012 # ls -n gives one directory's owner
	if [ "$(ls -nd "$XYMONHOME/ext" | awk '{ print $3 }')" != "$(id -u)" ]; then
		# shellcheck disable=SC2012 # ls names one owner
		o=$(ls -ld "$XYMONHOME/ext" | awk '{ print $3 }')
		die "$XYMONHOME/ext is $o's, not $(id -un)'s: run this as $o, who writes, updates and removes its plugins"
	fi
}

# own_client -- --client with XYMONHOME a server's tree: the server's own
# client tree (S36), the one its xymonserver.cfg names as XYMONCLIENTHOME,
# a path, spelt once with its links kept.
# Refused, saying what was read, when it names none, a variable, a path
# not absolute,
# a directory not there, one without a
# client's marks, or the server's own; and, for a verb that changes
# something, when that tree's ext/ is not there, or is the owner's of
# neither the server's ext/ nor root's, giving the commands, or is not the
# person's running this (S35). A verb that reads finds a tree with no
# ext/ empty, saying nothing. XYMONHOME is then that tree, OWNOF the server.
own_client() {
	srv=$XYMONHOME
	c=$(xch "$srv")
	# As Xymon's installs write it, a path: a variable is not read, as
	# nothing here runs the server's programs to read it.
	case $c in *'$'*) die "$srv's XYMONCLIENTHOME, $c, names a variable, which this command does not read: write the client tree's path itself" ;; esac
	[ -n "$c" ] || die "$srv's xymonserver.cfg names no XYMONCLIENTHOME it can read: the server has no client tree of its own to take a client part"
	# Absolute: a relative one would be read against the current directory,
	# and written so into the task file and its link.
	case $c in /*) ;; *) die "$srv's XYMONCLIENTHOME, $c, is not an absolute path: write the client tree's path from /" ;; esac
	cc=$(canon "$c")
	[ -n "$cc" ] || die "$srv's XYMONCLIENTHOME, $c, is not there: the server's client tree it names is missing"
	[ "$cc" != "$(canon "$srv")" ] || die "$srv's XYMONCLIENTHOME, $c, is the server's own tree: a client part does not go there"
	case $(marks "$c") in
		client) ;;
		server) die "$srv's XYMONCLIENTHOME, $c, is a Xymon server's tree ($SERVER_MARKS), not a client's" ;;
		*) die "$srv's XYMONCLIENTHOME, $c, is no Xymon client's tree: it has not $CLIENT_MARKS" ;;
	esac
	# Links are compared as written, so a XYMONCLIENTHOME respelt later
	# shows in verify as a link pointing elsewhere: disable, then enable.
	# Comparing through any spelling of the tree was tried and taken out: a
	# relative target was resolved against the current directory, not the
	# link's, and it served only a respelling no install makes.
	# Spelt once, as the server's XYMONHOME is: its links kept -- Homebrew's
	# opt/ names the package's current version, which a path resolved
	# through it would fix, broken at its next upgrade --, a trailing / or
	# a . taken off, which would otherwise go into the task file, its link
	# and MANIFEST.
	cl=$(CDPATH='' cd -- "$c" && pwd) || exit 1
	OWNOF=$srv XYMONHOME=$cl
	CHOSEN="$CHOSEN, the client tree of the Xymon server $srv"
	case $VERB in status|verify|outdated) return 0 ;; esac
	# The server's ext/, whose owner the client tree's is held to: every
	# Xymon server install makes it, and a server without it is broken.
	# A link to a directory is one, as Homebrew's, which keeps it in var/.
	[ -d "$srv/ext" ] || die "$srv has no directory ext/, which every Xymon server install makes: its install is incomplete; no client part goes in its client tree until it has one"
	# Not the server's own ext/ under another name: the client part would
	# take the server part's directory.
	[ "$(canon "$XYMONHOME/ext")" != "$(canon "$srv/ext")" ] || die "$XYMONHOME/ext is the server's own ext/: the client tree must have its own, or a client part would take the server part's directory"
	# The owner the client tree's ext/ is held to: the server's tasks.d/,
	# where its task's link is written -- one person writes both (S35), and
	# the task runs as the server's launcher, which a tree another may write
	# would have run that one's code. The server's ext/ owner, or root
	# beside it, was the rule first: RPM gives client/ext to xymon and the
	# server's tree to root, which it refused with a chown against the
	# package; and root accepted made a link to any root's directory pass.
	td=$srv/etc/tasks.d; [ -d "$td" ] || td=$srv/etc
	# Owners of what a link names, as the files go there.
	# shellcheck disable=SC2012 # ls -n gives one directory's owner
	tu=$(ls -nLd "$td" | awk '{ print $3 }')
	# shellcheck disable=SC2012 # ls names one owner
	tn_=$(ls -lLd "$td" | awk '{ print $3 }')
	e=$XYMONHOME/ext
	# A link to nothing -- a var/ directory gone, as Homebrew's --: the
	# directory it names to make, not the link's own name.
	if [ -L "$e" ] && [ ! -d "$e" ]; then
		et=$(readlink "$e"); case $et in /*) ;; *) et=$XYMONHOME/$et ;; esac
		die "$e is a link to $et, which is not there, where the server's client parts go: make it, as $tn_,
  mkdir -p $(shq "$et")"
	fi
	[ -d "$e" ] || die "$XYMONHOME has no directory ext/, where the server's client parts go, as Xymon's own installs make it: as root,
  mkdir $(shq "$e") && chown $tn_ $(shq "$e")"
	# shellcheck disable=SC2012 # ls -n gives one directory's owner
	cu=$(ls -nLd "$e" | awk '{ print $3 }')
	# shellcheck disable=SC2012 # ls names one owner
	cn=$(ls -lLd "$e" | awk '{ print $3 }')
	if [ "$cu" != "$tu" ]; then
		# No chown given for what a link names: whoever owns the client
		# tree chose it.
		[ ! -L "$e" ] || die "$e is a link to $(readlink "$e"), $cn's, not $tn_'s, who owns the server's $td: one person writes both, and the client parts' tasks run as the server's launcher"
		die "$e is $cn's, not $tn_'s, who owns the server's $td: one person writes both, and the client parts' tasks run as the server's launcher; make them one owner's, as Xymon's own installs do"
	fi
	[ "$cu" = "$(id -u)" ] || die "$e is $cn's, not $(id -un)'s: run this as $cn, who writes, updates and removes its plugins"
}

# own_self PLUGIN -- true when PLUGIN is xymon-plugin and XYMONHOME a
# server's own client tree, where its client part does not go: the
# server's copy, the same installer, manages that tree (S36). Named, it was
# refused before anything changed (own_named); among those not named, or
# needed by another, it is passed over, said once: the server's copy
# stands for it, a need on it met.
own_self() {
	[ -n "$OWNOF" ] && [ "$1" = "$self" ] || return 1
	case " $DONE " in *" $self "*) return 0 ;; esac
	DONE="$DONE $self"
	if [ -f "$OWNOF/ext/$self/VERSION" ]; then
		echo "$self is passed over: the server's copy stands for its client part in the client tree of a Xymon server"
	else
		echo "$self is passed over: its client part does not go in the client tree of a Xymon server"
	fi
}
# own_named -- refuse, before anything changes, a verb that changes
# something naming xymon-plugin in a server's own client tree (S36), with
# the commands that remove a copy left there: its directory and a task
# link in the client's clientlaunch.d/ by hand, and what else it left --
# a task link in the server's tasks.d/, its manual page's link -- by
# clean, as for any plugin gone.
own_named() {
	[ -n "$OWNOF" ] || return 0
	# shellcheck disable=SC2086,SC2116 # NAMES, one line
	case " $(echo $NAMES) " in *" $self "*) ;; *) return 0 ;; esac
	rmc=
	if [ -e "$EXTROOT/$self" ] || [ -L "$EXTROOT/$self" ]; then
		# Its task link from its life as a standalone client, in the
		# client's clientlaunch.d/, which clean on a server does not read.
		cl=
		for l in "$XYMONHOME/etc/clientlaunch.d"/*; do
			case $(readlink "$l" 2>/dev/null) in "$XYMONHOME/ext/$self/"*) cl="$cl $(shq "$l")" ;; esac
		done
		rmc="; a copy left there is removed, as its owner, by:
  rm -rf $(shq "$EXTROOT/$self")$cl
  ./xymon-plugin clean --client$(hx) $self"
	fi
	die "$self's client part does not go in the client tree of the Xymon server $OWNOF: the server's copy manages that tree$rmc"
}

# need_home KIND -- a part goes in the tree XYMONHOME names, and only in
# one of its KIND: a server's for the server part, a client's for the
# client part (S18): without XYMONHOME, the trees found are named, none
# chosen; a tree of the other kind, named with the part it takes, part of
# a pair and no marks at all are refused before anything changes. Under
# DESTDIR, a staging target, no marks are read, the host's included.
need_home() {
	if [ -z "$XYMONHOME" ]; then
		[ -z "$DESTDIR" ] || die "XYMONHOME is not set: under DESTDIR it names the installation, XYMONHOME=<the Xymon server directory> ./xymon-plugin $VERB --server [PLUGIN...]"
		choose_tree "$1" || exit 1
	fi
	[ -z "$DESTDIR" ] || return 0
	k=$1
	set -- $(marks "$XYMONHOME")
	if [ "$k" = server ]; then
		case $1 in
			client)
				# A server's own client tree: that server named, and what to type.
				own_refused
				die "$XYMONHOME is a Xymon client's tree ($CLIENT_MARKS), not a server's: a client's tree takes the client part, --client" ;;
			some) shift; die "$XYMONHOME is not a whole Xymon server's tree: it has $*, and a server's has $SERVER_MARKS" ;;
			none) die "$XYMONHOME is no Xymon server's tree: none of $SERVER_MARKS is there; to stage one for a package, set DESTDIR" ;;
		esac
	else
		case $1 in
			# A server's tree: its own client tree (S36).
			server) own_client ;;
			some) shift; die "$XYMONHOME is not a whole Xymon client's tree: it has $*, and a client's has $CLIENT_MARKS" ;;
			none) die "$XYMONHOME is no Xymon client's tree: none of $CLIENT_MARKS is there" ;;
		esac
		[ -n "${OWNOF:-}" ] || case $VERB in status|verify) client_home_ok read ;; *) client_home_ok ;; esac
	fi
	# Its paths again, now its kind is known: a client's launches its tasks
	# from clientlaunch.d/.
	server_paths
	# Before anything changes: the target, the part, and what chose them.
	# It is remembered once the run has done its work, and not by a verb
	# that changes nothing: a refusal leaves no trace (S25).
	if [ "$VERB" != status ] && [ "$VERB" != outdated ]; then
		echo "Target: $XYMONHOME ($CHOSEN), part: $k"
		REMEMBER=$k
	fi
}

# fresh DIR [KEEP] -- DIR, emptied: an install replaces a plugin's directory
# as a whole, so that a file a newer version no longer ships does not stay
# behind to be imported. It holds only what the plugin ships, its VERSION
# and its PLUGIN file -- and KEEP, names in it left in place: the task file
# tasks.d/ links to, which xymonlaunch would otherwise find gone, drop the
# task and stop it, and not notice it back; the file in progress (PROG),
# which makes one cut short an install cut short; PLUGIN, which a run
# resuming reads what the install before put in place from; and MANIFEST,
# a plain file only, which the command's end leaves or replaces (manifest).
fresh() {
	if [ -z "${2:-}" ] || [ ! -d "$1" ] || [ -L "$1" ]; then
		rm -rf "$1" && mkdir -p "$1"
		return
	fi
	for f in "$1"/* "$1"/.[!.]* "$1"/..?*; do
		{ [ -e "$f" ] || [ -L "$f" ]; } || continue
		case " $2 " in *" ${f##*/} "*)
			[ "${f##*/}" = MANIFEST ] && { [ -L "$f" ] || [ ! -f "$f" ]; } || continue ;;
		esac
		rm -rf "$f" || return 1
	done
}

# progress PLUGIN -- PROG in ext/PLUGIN, made, before anything there
# changes: it names the plugin and this run's process, and goes once
# VERSION is written (progress_done). A directory holding it is an
# install cut short (cut_short), which the next install or update resumes
# (S20); fresh keeps it. Made with noclobber, in one step with the check
# that it is not there: one there of a run still going stops this one;
# one of a run gone is removed, the name only -- a link or a hard link
# there is never written through -- and made anew, the same way. A first
# install's says "first", and a resume of it keeps saying it: nothing of
# the admin's is there, and remove may take it (removable).
PROG=.xymon-plugin-in-progress
progress() {
	pf=$EXTROOT/$1/$PROG pfirst=
	if [ ! -e "$EXTROOT/$1" ] && [ ! -L "$EXTROOT/$1" ]; then pfirst=' first'
	elif cut_short "$1" && grep -q ' first$' "$pf"; then pfirst=' first'; fi
	mkdir -p "$EXTROOT/$1" || exit 1
	for try_ in 1 2; do
		if (set -C; printf 'xymon-plugin in progress: %s %s%s\n' "$1" "$$" "$pfirst" > "$pf") 2>/dev/null; then return 0; fi
		running_ok "$1"
		[ "$try_" = 1 ] && rm -f "$pf" || die "$pf came back while this run made it: another run of $1 is going on"
	done
}
# progress_done PLUGIN -- PROG removed, if it is this run's.
progress_done() {
	pf=$EXTROOT/$1/$PROG
	if [ -f "$pf" ] && [ ! -L "$pf" ] && [ "$(sed -n 's/^xymon-plugin in progress: [^ ]* \([0-9]*\).*/\1/p' "$pf")" = "$$" ]; then rm -f "$pf"; fi
}

# aside_ok PLUGIN -- before anything changes, refuse a run on PLUGIN that
# another run is making (running_ok); and one beside a set-aside
# directory it cannot resume with: a link or no directory, one not marked
# as PLUGIN's, another user's, or one beside a complete install, or none
# -- stale, the admin's to compare and remove.
aside_ok() {
	running_ok "$1"
	sa=$EXTROOT/.xymon-plugin.$1
	{ [ -e "$sa" ] || [ -L "$sa" ]; } || return 0
	if [ -L "$sa" ] || [ ! -d "$sa" ]; then
		die "$sa is a link, or no directory: left as it is; move it away to install or update $1"
	elif ! marked "$sa" "$1"; then
		die "$sa is not set aside by xymon-plugin for $1: left as it is; move it away to install or update $1"
	elif ! mine "$sa"; then
		# shellcheck disable=SC2012 # ls -ld names one directory's owner
		die "$sa, set aside by an install of $1 cut short, is $(ls -ld "$sa" | awk '{ print $3 }')'s: left as it is; an install or update of $1 by that user resumes it"
	elif cut_short "$1"; then
		return 0
	else
		die "$(stale "$sa" "$1"); then install or update $1"
	fi
}
# running_ok PLUGIN -- refuse a run on PLUGIN while another one runs
# (running).
running_ok() {
	if running "$1"; then die "$RUNMSG"; fi
}
# running PLUGIN [quiet] -- another run on PLUGIN is going on, RUNMSG
# saying it, for the caller to say: the process
# PROG names, alive by kill -0, and an xymon-plugin by what ps says it
# runs. One that is another program -- its number taken again -- is no
# run; one ps cannot tell of is taken for none, said.
running() {
	ip=$EXTROOT/$1/$PROG
	[ -f "$ip" ] && [ ! -L "$ip" ] || return 1
	pid=$(sed -n "s/^xymon-plugin in progress: $1 \([0-9][0-9]*\)\( first\)\{0,1\}\$/\1/p" "$ip")
	[ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null || return 1
	# ps -p where it has it; busybox's lists every process with -o.
	args=$(ps -p "$pid" -o args= 2>/dev/null) || args=$(ps -o pid,args 2>/dev/null | awk -v p="$pid" '$1 == p { $1 = ""; print }')
	case $args in
		*xymon-plugin*) RUNMSG="an install or update of $1 is running, process $pid: wait for it to end; if no such run is going on, remove $ip and run this again"; return 0 ;;
		# Said once a run: running_ok asks more than once (the check first,
		# then the file in progress), in this shell, so PS_SAID keeps it;
		# installs, listing in a subshell of its own, passes QUIET.
		"") case " $PS_SAID ${2:-} " in
			*" $1 "*|*" quiet "*) ;;
			*) PS_SAID="$PS_SAID $1"; echo "xymon-plugin: process $pid, which $ip names, runs, and ps cannot say what it is: taken for no run of $1" >&2 ;;
		esac ;;
	esac
	return 1
}

# aside PLUGIN -- AS, ext/.xymon-plugin.PLUGIN, where an install or an
# update of PLUGIN sets aside what outlives its directory, by the same
# paths: the task file, the snippets, .shipped/, each NAME.old. Made by
# mkdir, which fails on what is there, so nothing there is written
# through or over; in ext/, so a file moved back is renamed within one
# file system (S13); marked by MARK, naming the plugin and the date it was
# made. One there, which aside_ok let through, is that of the install cut
# short this run resumes: what it holds is the admin's files as they were
# (S7), and the snippets may have changed: RESUMED.
MARK=.xymon-plugin-set-aside
AS='' RESUMED=''
aside() {
	AS=$EXTROOT/.xymon-plugin.$1 ASN=$1 RESUMED=''
	trap 'aside_end' EXIT
	trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
	if [ -d "$AS" ] && [ ! -L "$AS" ]; then
		echo "Resuming the install of $1 cut short, with what it set aside in $AS"
		RESUMED=1
		rm -f "${AS:?}"/*.this "${AS:?}"/*.merged
		[ -d "$AS/.shipped" ] || mkdir "$AS/.shipped" || exit 1
		return 0
	fi
	mkdir -m 700 "$AS" || { AS=; die "could not make $EXTROOT/.xymon-plugin.$1 to set files aside in"; }
	printf 'xymon-plugin set aside: %s\ndate: %s\n' "$1" "$(date '+%Y-%m-%d %H:%M')" > "$AS/$MARK" && mkdir "$AS/.shipped" || exit 1
}
# marked DIR PLUGIN -- DIR is a set-aside directory of PLUGIN's: a real
# directory, its MARK a real file whose first line names PLUGIN. mine DIR
# -- of the person running.
marked() {
	[ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/$MARK" ] && [ ! -L "$1/$MARK" ] \
		&& [ "$(sed -n 1p "$1/$MARK" 2>/dev/null)" = "xymon-plugin set aside: $2" ]
}
# shellcheck disable=SC2012 # ls -n gives one directory's owner, as client_home_ok reads it
mine() { [ "$(ls -nd "$1" | awk '{ print $3 }')" = "$(id -u)" ]; }
# stale DIR PLUGIN -- what to say of ext/.xymon-plugin.PLUGIN that no run
# takes up: marked, with the date its marker records, to compare with the
# plugin's directory or, that gone, to take back from; else not one of
# the installer's.
stale() {
	if ! marked "$1" "$2"; then
		echo "$1 is not set aside by xymon-plugin: left as it is"
		return
	fi
	sd=$(sed -n 's/^date: //p' "$1/$MARK"); [ -n "$sd" ] || sd="a date it does not say"
	if [ -e "$EXTROOT/$2" ] || [ -L "$EXTROOT/$2" ]; then
		echo "$1, set aside on $sd by an install of $2 cut short, is left: compare it with $EXTROOT/$2, then remove it"
	else
		echo "$1, set aside on $sd by an install of $2 cut short, is left, $EXTROOT/$2 gone: take back what you want from it, then remove it"
	fi
}
# aside_empty PLUGIN -- ext/.xymon-plugin.PLUGIN not there, or marked and
# holding nothing of the admin's: what a first install cut short early
# leaves, which remove may take.
aside_empty() {
	ae=$EXTROOT/.xymon-plugin.$1
	if [ ! -e "$ae" ] && [ ! -L "$ae" ]; then return 0; fi
	marked "$ae" "$1" && [ -z "$(cd "$ae" && find . \( -type f -o -type l \) ! -name "$MARK" -print)" ]
}

# aside_end -- on the way out, AS kept while it holds anything of the
# admin's, said; else removed.
aside_end() {
	[ -n "$AS" ] || return 0
	af=$(cd "$AS" && find . \( -type f -o -type l \) ! -name "$MARK" ! -name '*.this' ! -name '*.merged' -print | sed -e 's|^\./||' | tr '\n' ' ')
	if [ -n "$af" ]; then
		echo "xymon-plugin: the install of $ASN was cut short, with ${af% } set aside in $AS: the next install or update of $ASN resumes, and puts them back" >&2
	else
		rm -rf "${AS:?}"
	fi
	AS=
}

# old_name FILE -- FILE.old, or, that taken, FILE.N.old, the first N
# free; FILE's own .old left out first, so that one is NAME.N.old.
old_name() {
	ob=${1%.old}
	if [ ! -e "$ob.old" ] && [ ! -L "$ob.old" ]; then printf '%s\n' "$ob.old"; return; fi
	ko=1
	while [ -e "$ob.$ko.old" ] || [ -L "$ob.$ko.old" ]; do ko=$((ko + 1)); done
	printf '%s\n' "$ob.$ko.old"
}

# put_aside PATH NAME [cp] -- PATH -- a file, a link or a directory --
# into AS as NAME, a path under it, moved, or with cp copied; where AS
# holds a NAME already, that is the admin's, as it was before a run cut
# short: PATH, unless the same file, changed since, goes beside it as a
# .old, said, never lost.
put_aside() {
	if [ ! -e "$AS/$2" ] && [ ! -L "$AS/$2" ]; then pa=$AS/$2
	elif [ -f "$1" ] && [ ! -L "$1" ] && [ -f "$AS/$2" ] && [ ! -L "$AS/$2" ] && cmp -s "$1" "$AS/$2"; then return 0
	else
		pa=$(old_name "$AS/$2")
		printf '%s\n' "$1 differs from the copy the run cut short set aside, which is put back: it is kept as ${pa##*/}"
	fi
	mkdir -p "${pa%/*}" || exit 1
	if [ -n "${3:-}" ]; then cp "$1" "$pa"; else mv "$1" "$pa"; fi || exit 1
}

# olds DIR -- each NAME.old under DIR, one a line, its path from DIR: a
# file, a link, or a directory whole, hidden or not, at any depth; not in
# .shipped/. ponytail: read a line each, a name with a newline is not
# one, and goes with the update.
olds() {
	(cd "$1" && find . -path ./.shipped -prune -o -name '*.old' -print -prune) | sed -e 's|^\./||'
}

# aside_back -- what is left in AS once the plugin is in place goes back
# into its directory: any file of its top this version no longer ships,
# as a .old, said, unless as the install before wrote it; a link, said;
# then each NAME.old, beside one written now as NAME.N.old. AS goes once
# it holds nothing else.
aside_back() {
	for f in "$AS"/* "$AS"/.[!.]*; do
		[ -f "$f" ] || [ -L "$f" ] || continue
		n=${f##*/}
		case $n in "$MARK"|*.old) continue ;; *.this|*.merged) rm -f "$f"; continue ;; esac
		if [ -L "$f" ]; then
			printf '%s\n' "$ext/$n, a link to $(readlink "$f"), is no longer shipped: the link is removed, what it names left as it is"
			rm -f "$f"; continue
		fi
		if [ -f "$AS/.shipped/$n" ] && cmp -s "$f" "$AS/.shipped/$n"; then rm -f "$f"; continue; fi
		o=$(old_name "$ext/$n")
		mv "$f" "$o" || exit 1
		if [ -f "$AS/.shipped/$n" ]; then printf '%s\n' "$ext/$n is no longer shipped: your edited copy is kept as ${o##*/}"
		else printf '%s\n' "$ext/$n is no longer shipped: it is kept as ${o##*/}, as it could not be told unedited"; fi
	done
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		case $f in */*) mkdir -p "$ext/${f%/*}" || exit 1 ;; esac
		mv "$AS/$f" "$(old_name "$ext/$f")" || exit 1
	done <<EOF
$(olds "$AS")
EOF
	for f in "$AS"/.shipped/* "$AS"/.shipped/.[!.]*; do
		if [ -f "$f" ] || [ -L "$f" ]; then rm -f "$f"; fi
	done
	# The directories left empty, the deepest first.
	(cd "$AS" && find . -depth -type d ! -name . -exec rmdir {} \; 2>/dev/null)
	if [ "$(ls -A "$AS")" = "$MARK" ]; then rm -f "${AS:?}/$MARK" && rmdir "$AS" && AS=; fi
	[ -z "$AS" ] || { echo "xymon-plugin: $AS holds what was not put back: compare it with $ext" >&2; AS=; }
}

# open_dir [-1] DIR -- what is closed to other users in DIR, or with -1 in
# DIR alone, opened to them as far as its owner may use it: a directory
# its owner can read and enter, read and entered; a regular file its owner
# can read, read, and run where its owner can run it. What an install
# keeps from one to the next on the server -- ext/, tasks.d/, /plugins'
# stage, the virtualenv -- may come from one made under umask 077. Nothing
# else is touched: no link, DIR itself included (chmod follows one on
# macOS); no fifo, socket or device; no setuid or setgid file, nor one with
# another hard link; and nothing already open, so a directory of another
# user, a packaged Xymon's ext/, is left and nothing said. What cannot be
# opened is said, with its owner, who can.
open_dir() {
	open_p=''; [ "$1" != -1 ] || { open_p=-prune; shift; }
	{ [ -d "$1" ] && [ ! -L "$1" ]; } || return 0
	# shellcheck disable=SC2086,SC2012 # open_p is -prune or nothing; ls names one owner
	find "$1" $open_p \( \
		\( -type d -perm -0500 ! -perm -0055 -exec chmod go+rx {} + \) -o \
		\( -type f -links 1 ! -perm -4000 ! -perm -2000 -perm -0500 ! -perm -0055 -exec chmod go+rx {} + \) -o \
		\( -type f -links 1 ! -perm -4000 ! -perm -2000 -perm -0400 ! -perm -0100 ! -perm -0044 -exec chmod go+r {} + \) \
		\) || echo "xymon-plugin: could not open all of $1 to every user: run the update as its owner, $(ls -ld "$1" | awk '{ print $3 }'), to open it" >&2
}

# copy PLUGIN SIDE DIR -- the side's files into DIR, executable or not.
copy() {
	exe=" $(field "$1" executable) "
	set -f
	for f in $(field "$1" "$2-files"); do
		plain "$f" || die "$1's PLUGIN file names '$f' to install, which is no file of its own directory"
		[ ! -L "$ROOT/plugins/$1/$f" ] || die "$1's $f is a link, which is not installed"
		cp -f "$ROOT/plugins/$1/$f" "$3/" || exit 1
		case $exe in *" $f "*) chmod 755 "$3/$f" ;; *) chmod 644 "$3/$f" ;; esac || exit 1
	done
	set +f
}

# version PLUGIN DIR -- the plugin's version, X.Y.Z, in DIR/VERSION: the
# PLUGIN file's, from a checkout or a release's archive alike (S2). Whether
# the code is exactly a release's is for status and verify to say, and an
# archive's attestation.
version() {
	printf '%s\n' "$(field "$1" version)" > "$2/VERSION" && chmod 644 "$2/VERSION"
}

# twin PLUGIN -- the plugin's directory in the other Xymon tree of this
# server, where its other Xymon part goes (S36): the server's own client
# tree for a server part, the server for a client part there; nothing for
# a standalone client, the tools, or under DESTDIR. The two parts share one
# manual page, NAME.8 (S20).
twin() {
	[ -z "$DESTDIR" ] || return 0
	if [ -n "$OWNOF" ]; then printf '%s\n' "$OWNOF/ext/$1"
	elif [ "$TPART" = server ]; then
		tw=$(xch "$XYMONHOME")
		case $tw in /*) ;; *) return 0 ;; esac
		case $tw in *'$'*) return 0 ;; esac
		tw=$(CDPATH='' cd -- "$tw" 2>/dev/null && pwd) || return 0
		printf '%s\n' "$tw/ext/$1"
	fi
}

# manual PLUGIN PAGE DIR MANROOT FINAL -- the page kept in the plugin's
# directory DIR, and linked from its section's directory under MANROOT,
# without DESTDIR, found inside it -- with MANROOT empty, not linked; the
# link names FINAL, that directory as installed, without DESTDIR too. Removing
# the directory leaves a link that points nowhere, and a removal knows the
# page is the plugin's by the link, not by what its record says. The page's
# name there free, or the link an install of this plugin made, it is
# linked; anything else there -- a page of the administrator's, another's
# link, a directory -- is left as it is, said, the install going on.
manual() {
	[ -n "$2" ] || return 0
	plain "$2" || die "$1's PLUGIN file names '$2' as its manual page, which is no file of its own directory"
	[ ! -L "$ROOT/plugins/$1/$2" ] || die "$1's $2 is a link, which is not installed"
	cp -f "$ROOT/plugins/$1/$2" "$3/$2" && chmod 644 "$3/$2" || exit 1
	[ -n "$4" ] || return 0
	sec=$(inside "$4/man${2##*.}") || exit 1
	if { [ -e "$sec/$2" ] || [ -L "$sec/$2" ]; } && [ "$(readlink "$sec/$2" 2>/dev/null)" != "$5/$2" ]; then
		# The same page of its other part, in the server's other tree:
		# shared, left as it is.
		tw=$(twin "$1")
		[ -z "$tw" ] || [ "$(readlink "$sec/$2" 2>/dev/null)" != "$tw/$2" ] || return 0
		echo "$4/man${2##*.}/$2 is another's, left as it is: $1's manual page is read as man $5/$2"
		return 0
	fi
	mkdir -p "$sec" || exit 1
	rm -f "$sec/$2" && ln -s "$5/$2" "$sec/$2" || exit 1
}

# mf_file ACTUAL NAME [admin] -- a MANIFEST line for a file written: its
# cksum and size, and NAME, its path as installed (S29).
mf_file() {
	c=$(cksum < "$1") || exit 1
	printf 'file\t%s\t%s' "$c" "$2"
	[ -z "${3:-}" ] || printf '\t%s' "$3"
	echo
}

# mf_link ACTUAL NAME -- a MANIFEST line for a link made: NAME, and where
# it points.
mf_link() { printf 'link\t%s\t%s\n' "$2" "$(readlink "$1")"; }

# mf_dir DIR ADMIN -- the lines for every file and link under the plugin's
# directory DIR, MANIFEST aside, by their path from it; the names in ADMIN,
# the task file and the snippets, marked the administrator's to edit.
mf_dir() {
	(cd "$1" && find . \( -type f -o -type l \) ! -name MANIFEST ! -name .MANIFEST.new) \
		| sed -e 's|^\./||' | LC_ALL=C sort | while IFS= read -r f; do
		case " $2 " in *" ${f%.new} "*|*" ${f%.old} "*) [ "$f" = "${f%.new}" ] && [ "$f" = "${f%.old}" ] || continue ;; esac
		# And every other .old the version does not ship: the admin's.
		case $f in *.old|*.old/*) case " $(field "${1##*/}" server-files) $(field "${1##*/}" client-files) $(field "${1##*/}" tools-files) " in *" $f "*) ;; *) continue ;; esac ;; esac
		if [ -L "$1/$f" ]; then mf_link "$1/$f" "$f"
		else case " $2 " in *" $f "*) mf_file "$1/$f" "$f" admin ;; *) mf_file "$1/$f" "$f" ;; esac
		fi
	done
}

# manifest DIR -- write what the lines on standard input say into
# DIR/MANIFEST, the command's last step (manifests): a new file, moved in
# place. The same lines as the one there, and no virtualenv changed, the
# code is the same: that one is left, so that a program watching it goes
# on rather than restart for nothing.
manifest() {
	cat > "$1/.MANIFEST.new" && chmod 644 "$1/.MANIFEST.new" || exit 1
	if [ -z "$VENV_CHANGED" ] && cmp -s "$1/.MANIFEST.new" "$1/MANIFEST"; then
		rm -f "$1/.MANIFEST.new"; return 0
	fi
	mv -f "$1/.MANIFEST.new" "$1/MANIFEST" || exit 1
}

# manifest_ext PLUGIN -- S29 for a Xymon part, PART: the plugin's
# directory, the copy /plugins serves of a server part, and the manual
# page's link, by their paths as installed, without DESTDIR. The task link
# and a SELinux module loaded are states, not files, and stay out.
manifest_ext() {
	{
		if [ "$PART" = server ]; then
			mf_dir "$EXTROOT/$1" "tasks.cfg $(field "$1" conf)"
			for f in $(cd "$DIST/plugins/$1" && ls); do
				mf_file "$DIST/plugins/$1/$f" "$XYMONHOME/ext/xymon-plugins-dist/plugins/$1/$f"
			done
		else
			mf_dir "$EXTROOT/$1" "tasks.cfg"
		fi
		pg=$(field "$1" "$PART-manual")
		if [ -n "$pg" ]; then
			sec=$(inside "$MANDIR/man${pg##*.}") || exit 1
			# The link only when it is ours: the page's name may be
			# another's, left as it is (S29).
			if [ -L "$sec/$pg" ] && [ "$(readlink "$sec/$pg")" = "$XYMONHOME/ext/$1/$pg" ]; then
				mf_link "$sec/$pg" "$MANDIR/man${pg##*.}/$pg"
			fi
		fi
	} | manifest "$EXTROOT/$1"
}

# manifest_tools PLUGIN -- S29 for your tools: the plugin's directory, its
# command and its manual page's link.
manifest_tools() {
	{
		mf_dir "$TOOLSROOT/$1" ""
		set -- "$1" $(field "$1" command)
		# The command only when it is ours: its name may be another's (S4).
		[ $# -ne 3 ] || ! our_command "$1" "$2" "$3" || mf_file "$BIN/$2" "$PREFIX/bin/$2"
		pg=$(field "$1" tools-manual)
		[ -z "$pg" ] || [ "$(readlink "$TOOLSMAN1/$pg" 2>/dev/null)" != "$PREFIX/libexec/xymon-plugins/$1/$pg" ] \
			|| mf_link "$TOOLSMAN1/$pg" "$PREFIX/share/man/man1/$pg"
	} | manifest "$TOOLSROOT/$1"
}

# declared PLUGINFILE -- the names a PLUGIN file gives to stage, one per
# line: itself, README.md, each side's files and manual page, the task and
# the snippets. Read with globbing off; the callers check each is a plain
# name of the plugin's own directory.
declared() {
	echo PLUGIN
	echo README.md
	for k in server-files tools-files server-manual tools-manual server-task conf; do
		sed -n "s/^$k: //p" "$1" | tr ' ' '\n'
	done
}

# plain NAME -- true when NAME is a file name of a plugin's own directory:
# letters, digits, ., _, + and - only, and not . or ..: no /, and nothing a
# shell would expand or split.
plain() {
	case $1 in ""|.|..|*[!A-Za-z0-9._+-]*) return 1 ;; esac
	return 0
}

# self_sources -- the installer to stage for /plugins and its PLUGIN file,
# self_src and self_meta, from the tree it runs from: its directory under
# plugins/ in a checkout or an archive -- the script itself, not
# ./xymon-plugin, which is only a text file where links are not kept -- or
# beside it in a /plugins stage it was fetched from. No script at all is
# said, false, before a server install changes anything.
self_sources() {
	self_src=$ROOT/plugins/$self/$self; [ -f "$self_src" ] || self_src=$ROOT/$self
	self_meta=$ROOT/plugins/$self/PLUGIN; [ -f "$self_meta" ] || self_meta=$ROOT/$self.PLUGIN
	[ -f "$self_src" ] && return 0
	echo "xymon-plugin: no installer to stage for /plugins: neither $ROOT/plugins/$self/$self nor $ROOT/$self is a file" >&2
	return 1
}

# dist PLUGIN -- stage under $DIST/plugins what a machine needs to install
# the plugin, with this script and LICENSE beside: a machine unpacking it
# runs ./xymon-plugin install --tools there, at the server's versions. Only
# what the PLUGIN file names is staged, each a plain file of the plugin's
# directory and no link, so that a file left beside them in the checkout,
# a note, a key, a build's leftover, is not served to anyone by /plugins.
# The stage is pruned first, then the plugin built beside its old copy
# and moved into place, so that a failure leaves the old copy whole.
dist() {
	prune_dist
	open_dir "$DIST"
	d=$DIST/plugins/$1
	new=$DIST/plugins/.$1.new
	exe=" $(field "$1" executable) "
	mkdir -p "$new" || exit 1
	set -f
	for f in $(declared "$ROOT/plugins/$1/PLUGIN"); do
		plain "$f" || die "$1's PLUGIN file names '$f' to stage, which is no file of its own directory"
		src=$ROOT/plugins/$1/$f
		if [ "$f" = README.md ] && [ ! -e "$src" ]; then continue; fi
		[ ! -L "$src" ] || die "$1's $f is a link, which /plugins does not serve"
		cp -f "$src" "$new/" || exit 1
		case $exe in *" $f "*) chmod 755 "$new/$f" ;; *) chmod 644 "$new/$f" ;; esac || exit 1
	done
	set +f
	rm -rf "$d" || die "could not replace $d"
	mv "$new" "$d" || die "could not replace $d"
	# The installer, its PLUGIN file beside it as xymon-plugin.PLUGIN -- so
	# that it knows its version, staged as a plugin or not; a file named
	# PLUGIN there would make the stage look like a plugin installed -- and
	# LICENSE.
	self_sources || exit 1
	rm -f "$DIST/xymon-plugin" "$DIST/xymon-plugin.PLUGIN" "$DIST/LICENSE" || die "could not replace $DIST/xymon-plugin, xymon-plugin.PLUGIN and LICENSE"
	cp -f "$self_src" "$DIST/xymon-plugin" && cp -f "$ROOT/LICENSE" "$DIST/" || exit 1
	chmod 755 "$DIST/xymon-plugin" && chmod 644 "$DIST/LICENSE" || exit 1
	if [ -f "$self_meta" ]; then
		cp -f "$self_meta" "$DIST/xymon-plugin.PLUGIN" && chmod 644 "$DIST/xymon-plugin.PLUGIN" || exit 1
	else
		echo "xymon-plugin: no PLUGIN file of $self under $ROOT/plugins/$self/ nor as $ROOT/$self.PLUGIN: the installer /plugins serves will not know its version" >&2
	fi
}

# prune_dist -- what /plugins serves holds nothing else: at the top only
# xymon-plugin and LICENSE, files, and plugins/, a directory, none a link; in
# plugins/ only the directories of plugins installed here, each with a
# PLUGIN file holding plain names, and holding only the files it names.
# An install before this one staged a plugin's whole source directory,
# whatever lay in it, and a plugin since renamed or gone leaves a copy that
# no install of this one rewrites. A removal that fails stops the run: a
# file left would still be served.
prune_dist() {
	[ -e "$DIST" ] || [ -L "$DIST" ] || return 0
	if [ -L "$DIST" ] || [ ! -d "$DIST" ]; then
		rm -rf "$DIST" || die "could not remove $DIST"
		return 0
	fi
	for e in "$DIST"/* "$DIST"/.[!.]* "$DIST"/..?*; do
		[ -e "$e" ] || [ -L "$e" ] || continue
		case ${e##*/} in
			xymon-plugin|xymon-plugin.PLUGIN|LICENSE) [ -f "$e" ] && [ ! -L "$e" ] && continue ;;
			plugins) [ -d "$e" ] && [ ! -L "$e" ] && continue ;;
		esac
		rm -rf "$e" || die "could not remove $e, which /plugins would serve"
	done
	for p in "$DIST"/plugins/* "$DIST"/plugins/.[!.]* "$DIST"/plugins/..?*; do
		[ -e "$p" ] || [ -L "$p" ] || continue
		if [ -L "$p" ] || [ ! -d "$p" ] || [ ! -f "$p/PLUGIN" ] || [ -L "$p/PLUGIN" ] \
			|| { [ ! -f "$EXTROOT/${p##*/}/VERSION" ] && [ ! -f "$EXTROOT/${p##*/}/PLUGIN" ]; }; then
			rm -rf "$p" || die "could not remove $p, which /plugins would serve"
			continue
		fi
		set -f
		keep=" "
		for f in $(declared "$p/PLUGIN"); do
			if plain "$f"; then keep="$keep$f "; else keep=; break; fi
		done
		set +f
		if [ -z "$keep" ]; then
			rm -rf "$p" || die "could not remove $p, which /plugins would serve"
			continue
		fi
		for e in "$p"/* "$p"/.[!.]* "$p"/..?*; do
			[ -e "$e" ] || [ -L "$e" ] || continue
			case $keep in *" ${e##*/} "*) [ -f "$e" ] && [ ! -L "$e" ] && continue ;; esac
			rm -rf "$e" || die "could not remove $e, which /plugins would serve"
		done
	done
}

# ours PLUGIN -- refuse its task link (tn) that is a link to something
# other than the plugin's task file: it is not ours to change.
ours() {
	l=$TASKDIR/$(tn "$1").cfg
	if [ -L "$l" ] && [ "$(readlink "$l")" != "$XYMONHOME/ext/$1/tasks.cfg" ]; then
		die "$l is a link to $(readlink "$l"), not $1's task: left alone"
	fi
}

# tn PLUGIN -- the name of its task in this tree, its link's in TASKDIR
# (with .cfg) and its file's one section's (S6): NAME-server for a server
# part, NAME-client for a client part; the installer's own server task,
# xymon-plugin.
tn() {
	if [ "$TPART" = client ]; then echo "$1-client"
	elif [ "$1" = "$self" ]; then echo "$1"
	else echo "$1-server"; fi
}
# is_on PLUGIN -- true when its task link is there.
is_on() { [ -L "$TASKDIR/$(tn "$1").cfg" ]; }

# reads_tasks -- true when the tree's LAUNCHCFG reads TASKD/ -- a server's
# tasks.cfg tasks.d/, a client's clientlaunch.cfg clientlaunch.d/ -- by a
# directory line naming it, as Xymon's own has it: xymonlaunch then has a
# task whose link is there. With no tasks.cfg, and under DESTDIR, there is
# nothing to look at.
reads_tasks() {
	[ -z "$DESTDIR" ] || return 0
	c=$(inside "$LAUNCHHOME/etc/$LAUNCHCFG") || exit 1
	[ -f "$c" ] || return 0
	grep -q '^[[:space:]]*\(optional[[:space:]]\{1,\}\)\{0,1\}directory[[:space:]]\{1,\}\(.*/\)\{0,1\}'"$(echo "$TASKD" | sed 's/\./\\./g')"'/\{0,1\}[[:space:]]*$' "$c"
}

# task PLUGIN -- its xymonlaunch task file, @XYMONHOME@ replaced, kept in
# the plugin's directory as ext/PLUGIN/tasks.cfg. The task is on when
# its link in tasks.d/ (tn) is there: removing ext/PLUGIN by hand
# then takes the task with it, since xymonlaunch skips a link that points
# nowhere and stops the task at its next reload, where a copy in tasks.d
# would have it log that it cannot start the task, forever. A first install
# makes no link. A later one keeps the task file as the admin left it --
# install_server sets it aside before it replaces the directory -- and
# whether the task is on. A regular file at the link's name wins over the
# one set aside, as it is the one xymonlaunch was reading: the copy an older
# install made there, or what an editor that writes by renaming, "sed -i"
# among them, left where the link was. It is moved into the directory, and
# linked. Older installs said off with a DISABLED line in the file: a file
# with one is off, its line taken out and its link removed.
# merge PLUGIN NAME NEW -- the administrator's file NAME in the plugin's
# directory, kept as it was, met with NEW, this version's, and with the
# version it started from, set aside as .shipped/NAME: unedited, it
# takes this version's; edited, and this version's the same as before, it
# stays; both changed, with no conflict, on a terminal both changes are
# shown and merged on y, the file before kept as NAME.old; on N, off a
# terminal, under DESTDIR, on a conflict, or with no diff3 or no version to
# start from, it stays, and this version's is written beside it as
# NAME.new. .shipped/NAME is left the version it now starts from. MCHANGED
# is set when the file changed.
merge() {
	md=$EXTROOT/$1/$2 mb=$AS/.shipped/$2 ms=$EXTROOT/$1/.shipped/$2
	mkdir -p "$EXTROOT/$1/.shipped" || exit 1
	rm -f "$md.new" || exit 1
	if cmp -s "$md" "$3"; then
		cp -f "$3" "$ms" && rm -f "$mb" || exit 1
	elif [ ! -f "$mb" ]; then
		cp -f "$3" "$md.new" && chmod 644 "$md.new" && cp -f "$3" "$ms" || exit 1
		echo "$md is kept as yours; this version's differs, and is beside it: diff $md $md.new"
	elif cmp -s "$md" "$mb"; then
		# Written as a new file renamed over it: never into one a hard
		# link shares with a file outside the plugin's directory, and never
		# missing, for a link tasks.d/ has to it.
		rm -f "$md.tmp" && cp -f "$3" "$md.tmp" && chmod 644 "$md.tmp" && mv -f "$md.tmp" "$md" && cp -f "$3" "$ms" && rm -f "$mb" || exit 1
		echo "$md, unedited, is replaced by this version's"
		MCHANGED=1
	elif cmp -s "$mb" "$3"; then
		mv -f "$mb" "$ms" || exit 1
	else
		mm=$AS/$2.merged
		if command -v diff3 >/dev/null 2>&1 && diff3 -m -E "$md" "$mb" "$3" > "$mm" 2>/dev/null; then
			# Yours has this version's change already: nothing to merge, and
			# this version's is the one it now starts from.
			if cmp -s "$mm" "$md"; then
				rm -f "$mm" "$mb" && cp -f "$3" "$ms" || exit 1
				return 0
			fi
			if [ -z "$DESTDIR" ] && [ -t 0 ] && [ -t 1 ]; then
				echo "$md: you edited it, and this version changes it too."
				echo "  Your change:"
				diff "$mb" "$md" | sed -e 's/^/    /'
				echo "  This version's change:"
				diff "$mb" "$3" | sed -e 's/^/    /'
				if offer "  They merge without conflict. Apply both?"; then
					rm -f "$md.old" && cp "$md" "$md.old" && chmod 644 "$mm" && mv -f "$mm" "$md" \
						&& cp -f "$3" "$ms" && rm -f "$mb" || exit 1
					echo "$md has both changes; yours before is $md.old: remove it once checked"
					MCHANGED=1
					return 0
				fi
			fi
			rm -f "$mm"
			cp -f "$3" "$md.new" && chmod 644 "$md.new" && mv -f "$mb" "$ms" || exit 1
			echo "$md is kept as yours; this version's, which merges with it without conflict, is beside it: diff $md $md.new"
		else
			rm -f "$mm"
			cp -f "$3" "$md.new" && chmod 644 "$md.new" && mv -f "$mb" "$ms" || exit 1
			echo "$md is kept as yours; this version's changes the same lines, and is beside it: diff $md $md.new"
		fi
	fi
}

task() {
	t=$(field "$1" "$TASKKEY"); [ -n "$t" ] || return 0
	tf=$EXTROOT/$1/tasks.cfg
	link=$TASKDIR/$(tn "$1").cfg
	ours "$1"
	# The server's tasks.d/ made at once; a client's clientlaunch.d/ only
	# for a link, its etc/ maybe the system's, not its owner's.
	[ "$TPART" != server ] || { mkdir -p "$TASKDIR" && open_dir -1 "$TASKDIR"; }
	on=
	this=$AS/tasks.cfg.this
	# @LOGDIR@, a client task's log directory (S6): the client's on a client.
	ld=XYMONSERVERLOGS; [ "$TPART" != client ] || [ -n "${OWNOF:-}" ] || ld=XYMONCLIENTLOGS
	sed -e "s|@XYMONHOME@|$(sedesc "$XYMONHOME")|g" -e "s|@LOGDIR@|\$$ld|g" "$ROOT/plugins/$1/$t" > "$this" || exit 1
	if [ -f "$link" ] && [ ! -L "$link" ]; then
		on=1
		# The task file it replaced, edited too -- neither as this file
		# nor as the install before wrote it --, is kept as a .old.
		if [ -f "$AS/tasks.cfg" ] && ! cmp -s "$AS/tasks.cfg" "$link" && ! cmp -s "$AS/tasks.cfg" "$AS/.shipped/tasks.cfg"; then
			to_=$(old_name "$AS/tasks.cfg.old")
			mv "$AS/tasks.cfg" "$to_" || exit 1
			echo "$tf, edited too, is kept as a .old of it: $link, the one xymonlaunch read, is the task file now"
		fi
		rm -f "$AS/tasks.cfg"
		# Copied, not moved: it stays where xymonlaunch reads it until the
		# link is renamed over it.
		rm -f "$tf.tmp" && cp "$link" "$tf.tmp" && mv -f "$tf.tmp" "$tf" || exit 1
		echo "keeping $link, copied to $tf, and linked"
		merge "$1" tasks.cfg "$this"
	elif [ -f "$AS/tasks.cfg" ]; then
		[ -L "$link" ] && on=1
		mv "$AS/tasks.cfg" "$tf" || exit 1
		merge "$1" tasks.cfg "$this"
	else
		cp -f "$this" "$tf" && chmod 644 "$tf" || exit 1
		mkdir -p "$EXTROOT/$1/.shipped" && cp -f "$this" "$EXTROOT/$1/.shipped/tasks.cfg" || exit 1
	fi
	rm -f "$this" "$AS/.shipped/tasks.cfg"
	if grep -q '^[[:space:]]*DISABLED[[:space:]]*$' "$tf"; then
		on=
		sed -e '/^[[:space:]]*DISABLED[[:space:]]*$/d' "$tf" > "$tf.new" && mv "$tf.new" "$tf" && chmod 644 "$tf" || exit 1
		echo "$1's task was DISABLED: it is off from now on, by its link"
	fi
	# A link already right is left: removed and made again, xymonlaunch
	# could read tasks.d/ between the two, and stop the task.
	if [ -n "$on" ] && [ -L "$link" ] && [ "$(readlink "$link")" = "$XYMONHOME/ext/$1/tasks.cfg" ]; then
		echo "$1's task is on, as it was"
	elif [ -n "$on" ]; then
		# Made under a name xymonlaunch skips, a dot first, and renamed
		# over what is there: tasks.d/ never lacks it.
		# The directory made only for a link: a task off writes nothing
		# there, where a client's etc/ may be the system's, not its owner's.
		mkdir -p "$TASKDIR" && open_dir -1 "$TASKDIR"
		lt=$TASKDIR/.$(tn "$1").cfg.tmp
		# mv would put it inside a directory, or one a link names: a link
		# goes first, a directory stops the install.
		if [ -d "$link" ]; then rm -f "$link" || exit 1; fi
		rm -f "$lt" && ln -s "$XYMONHOME/ext/$1/tasks.cfg" "$lt" && mv -f "$lt" "$link" || exit 1
		echo "$1's task is on, as it was"
	else
		rm -f "$link" || die "could not remove $link: $1's task stays on"
		echo "$1's task is off: $(enable_cmd "$1") turns it on"
	fi
}

# enable_cmd PLUGIN -- the command that turns its task on in this tree.
enable_cmd() {
	if [ "$TPART" = client ]; then echo "./xymon-plugin enable --client$(hx) $1"
	else echo "XYMONHOME=$XYMONHOME ./xymon-plugin enable --server $1"; fi
}

# enable PLUGIN, disable PLUGIN -- its task on or off, by its link.
enable() {
	own_self "$1" && return 0
	[ -n "$(held "$EXTROOT" "$1" "$TASKKEY")" ] || die "$1 has no task to enable"
	[ -f "$EXTROOT/$1/tasks.cfg" ] || die "$1 is not installed in $EXTROOT"
	ours "$1"
	l=$TASKDIR/$(tn "$1").cfg
	[ -L "$l" ] || [ ! -d "$l" ] || die "$l is a directory, not $1's task: left alone"
	# On already: for xymon-plugin, the way to have the column sent now,
	# a release published since its last run among what it says (S33).
	[ -L "$TASKDIR/$(tn "$1").cfg" ] && { echo "$1 is on already"; [ "$1" != "$self" ] || COLUMN=1; return 0; }
	# Before the link: a tree whose tasks.cfg, or clientlaunch.cfg, does
	# not read the directory would not have the task, whatever is linked.
	if ! reads_tasks; then
		[ -n "$FORCE" ] || die "$LAUNCHHOME/etc/$LAUNCHCFG does not read $TASKD/, so xymonlaunch would not have $1's task: add the line
  directory $LAUNCHHOME/etc/$TASKD
as Xymon's own $LAUNCHCFG has it; --force makes the link all the same, where xymonlaunch reads $TASKD/ another way"
		echo "xymon-plugin: $LAUNCHHOME/etc/$LAUNCHCFG does not read $TASKD/: $1's link is made all the same, as --force asks, and its task may not start" >&2
	fi
	# Its own task file linked from TASKD/ under another name, which
	# xymonlaunch reads all the same: a second link would read it twice.
	k=$(tn "$1")
	while IFS= read -r o; do
		[ -z "$o" ] || [ "$(readlink "$o")" != "$XYMONHOME/ext/$1/tasks.cfg" ] \
			|| die "$o is $1's task file linked under another name: mv $o $TASKDIR/$k.cfg"
	done <<EOF
$(find "$TASKDIR" -type l 2>/dev/null)
EOF
	# A task of its name the launcher reads already: xymonlaunch would
	# make one task of both, unsaid (S6). Read as xymonlaunch reads it,
	# through Xymon's xymoncfg, its include and directory lines followed;
	# without it, or under DESTDIR, the file itself and every file of TASKD/
	# xymonlaunch would read. A name as xymonlaunch takes it: after "[", up
	# to the first "]".
	lc=$(inside "$LAUNCHHOME/etc/$LAUNCHCFG") || exit 1
	if [ -z "$DESTDIR" ] && [ -x "$LAUNCHHOME/bin/xymoncfg" ] && [ -f "$lc" ]; then
		read_by=$("$LAUNCHHOME/bin/xymoncfg" "$lc" 2>/dev/null)
	else
		read_by=$(cat "$lc" 2>/dev/null
			find "$TASKDIR" \( -type f -o -type l \) ! -name '.*' ! -name '*~' ! -name '*,v' ! -name 'README*' ! -name '*.dpkg-*' ! -name '*.rpm*' -exec cat {} + 2>/dev/null)
	fi
	NL='
'
	case "$NL$(printf '%s\n' "$read_by" | sed -n -e 's/^[[:space:]]*\[\([^]]*\)\].*/\1/p')$NL" in
		*"$NL$k$NL"*) die "xymonlaunch reads a task named [$k] already, in $LAUNCHHOME/etc/$LAUNCHCFG or a file it reads, which it would merge with $1's, unsaid: $1 stays off" ;;
	esac
	{ mkdir -p "$TASKDIR" && open_dir -1 "$TASKDIR" && ln -s "$XYMONHOME/ext/$1/tasks.cfg" "$TASKDIR/$(tn "$1").cfg"; } \
		|| die "could not make $TASKDIR/$(tn "$1").cfg: $1 stays off"
	# xymonlaunch watches a directory line's directory only if it was there
	# when it read LAUNCHCFG (Xymon's lib/stackio.c): one made since -- by
	# this enable, an install or by hand -- is not read until LAUNCHCFG
	# changes. Its time changed, not its content, it is read again; the
	# tasks that did not change go on running.
	lc=$LAUNCHHOME/etc/$LAUNCHCFG
	if [ -z "$DESTDIR" ] && [ -f "$lc" ] && ! touch "$lc" 2>/dev/null; then
		echo "$1 is on, but $lc cannot be written to have xymonlaunch read $TASKD/ again: it starts the task within half a minute only if $TASKD/ was there when it started; else restart Xymon"
	else
		echo "$1 is on: xymonlaunch reads it within half a minute and starts it; one that keeps failing it holds for ten minutes after five restarts"
	fi
	[ "$1" != "$self" ] || COLUMN=1
}
disable() {
	own_self "$1" && return 0
	[ -n "$(held "$EXTROOT" "$1" "$TASKKEY")" ] || die "$1 has no task to disable"
	ours "$1"
	is_on "$1" || { echo "$1 is off already"; return 0; }
	rm -f "$TASKDIR/$(tn "$1").cfg" || die "could not remove $TASKDIR/$(tn "$1").cfg: $1 stays on"
	echo "$1 is off: xymonlaunch stops it within half a minute"
}

# column -- the plugins column sent at once, its task on, after a run that
# changed the tree's part, or enable of this plugin (S33): not up to 30
# hours later. The installed reporter, with no wait, under the tree's
# environment, says what it sent or why not; never the command's result.
# A client's environment lacks the host's name, which runclient.sh gives
# its tasks: the one the task wrote in XYMONTMP, or, before any run, the
# one in runclient.sh's pid file.
COLUMN=
column() {
	[ -n "$COLUMN" ] && [ -z "$DESTDIR" ] && [ -L "$TASKDIR/$(tn "$self").cfg" ] || return 0
	r=$EXTROOT/$self/$self-report.sh
	[ -f "$r" ] || { echo "The plugins column is not sent: $r is gone"; return 0; }
	xc=$XYMONHOME/bin/xymoncmd
	[ -x "$xc" ] || { echo "The plugins column is not sent: no $xc to give it the $TPART's environment"; return 0; }
	if [ "$TPART" = server ]; then
		echo "The plugins column, sent now:"
		XYMON_PLUGINS_WAIT=0 "$xc" --env="$XYMONHOME/etc/xymonserver.cfg" /bin/sh "$r" </dev/null 2>&1 | sed -e 's/^/  /'
		return 0
	fi
	ce=$XYMONHOME/etc/xymonclient.cfg
	# Read from env's output: a xymoncmd before Xymon's #920 expands its
	# arguments before it reads the file, which a $XYMONTMP given would be.
	ct=$("$xc" --env="$ce" env </dev/null 2>/dev/null | sed -n 's/^XYMONTMP=//p' | tail -n 1)
	ch=; [ -z "$ct" ] || ch=$(sed -n 1p "$ct/xymon-plugin.host" 2>/dev/null)
	if [ -z "$ch" ]; then
		set -- "$XYMONHOME"/logs/clientlaunch.*.pid
		if [ $# -eq 1 ] && [ -f "$1" ]; then ch=${1##*/clientlaunch.}; ch=${ch%.pid}; fi
	fi
	[ -n "$ch" ] || { echo "The plugins column is not sent: its task has not run yet to give the host's name, nor is there one $XYMONHOME/logs/clientlaunch.NAME.pid"; return 0; }
	echo "The plugins column, sent now for $ch:"
	MACHINEDOTS=$ch XYMON_PLUGINS_AT_ONCE=1 XYMON_PLUGINS_WAIT=0 "$xc" --env="$ce" /bin/sh "$r" --client </dev/null 2>&1 | sed -e 's/^/  /'
	return 0
}

# status SIDE ROOT PLUGIN -- one line for the plugin on that side: the
# version installed, from its VERSION -- a release tag, NAME/vX.Y.Z, read as
# its X.Y.Z -- or that it is not; whether its task is on, when it has one; and
# the version in this copy -- a checkout or unpacked releases --, with "newer" when it is, or that the
# checkout has it no more. The side and the task are read from the
# installed copy of its PLUGIN file. A plugin that has nothing on that
# side says nothing.
# other_code PART ROOT PLUGIN -- true when the checkout's code of the
# plugin is not what its MANIFEST says was installed: the files copied as
# they are, its PLUGIN, the part's files and manual page, compared by
# cksum. False with no MANIFEST, which verify says.
other_code() {
	[ -f "$2/$3/MANIFEST" ] || return 1
	T=$(printf '\t')
	for f in PLUGIN $(field "$3" "$1-files") $(field "$3" "$1-manual"); do
		c=$(cksum < "$ROOT/plugins/$3/$f" 2>/dev/null) || return 0
		grep -qxF "file$T$c$T$f" "$2/$3/MANIFEST" || return 0
	done
	return 1
}

status() {
	[ -n "$(held "$2" "$3" "$1-files")" ] || return 0
	here=$(field "$3" version)
	if [ "$1" != tools ] && cut_short "$3"; then
		echo "$3: cut short: ./xymon-plugin update --$1 $3 resumes it; this copy has $here"
		return 0
	fi
	if [ ! -f "$2/$3/VERSION" ]; then
		echo "$3: not installed; this copy has $here"
		return 0
	fi
	v=$(sed -e 's|^.*/v||' "$2/$3/VERSION")
	state=
	if [ "$1" != tools ] && [ -n "$(held "$2" "$3" "$1-task")" ]; then
		if is_on "$3"; then state=", on"; else state=", off"; fi
	fi
	# A server part whose Python lacks its modules is said, as enable
	# refuses it.
	lack=
	if [ "$1" = server ]; then
		m=$(missing_modules "$3"); [ -z "$m" ] || lack="; its Python lacks $m"
	fi
	if [ -z "$here" ]; then
		echo "$3: $v installed$state$lack; not in this copy"
		return 0
	fi
	newer=
	if older "$v" "$here"; then newer=", newer"
	elif [ "$v" = "$here" ] && other_code "$1" "$2" "$3"; then newer=", with other code: ./xymon-plugin update --$1 $3"
	fi
	echo "$3: $v installed$state$lack; this copy has $here$newer"
}

# installed_tasks -- the plugins named, or every one installed with a task.
installed_tasks() {
	for n in $LIST; do
		if [ -n "$NAMES" ] || { [ -n "$(held "$EXTROOT" "$n" "$TASKKEY")" ] && [ -d "$EXTROOT/$n" ]; }; then echo "$n"; fi
	done
}

# conf PLUGIN -- its web server snippets, in the plugin's directory, which
# the web server includes in a way that skips a file that is not there --
# Apache's IncludeOptional, a wildcard include for nginx -- so that removing
# ext/PLUGIN takes them with it, and the web server still starts. The one an
# admin edited is kept: install_server set it aside; one an older version
# shipped, unedited, takes this version's.

# cfgval NAME -- NAME's value in the server's configuration, as written:
# the last NAME= line, quotes and comment taken off, of xymonserver.cfg and
# then of the files in xymonserver.d/, which Xymon reads after it, leaving
# out what it leaves out: dot-files, editor backups, README and packaging
# leftovers.
# ponytail: one level of xymonserver.d/, as the plugins write it; Xymon also
# reads its subdirectories.
cfgval() {
	c=$(inside "$XYMONHOME/etc/xymonserver.cfg") || exit 1
	d=$(inside "$XYMONHOME/etc/xymonserver.d") || exit 1
	[ -f "$c" ] || return 0
	for f in "$c" "$d"/*; do
		[ -f "$f" ] || continue
		case ${f##*/} in .*|*~|*,v|README*|*.dpkg-new|*.dpkg-orig|*.rpmsave|*.rpmorig|*.rpmnew) continue ;; esac
		sed -n -e "s/^[[:space:]]*$1=\"\([^\"]*\)\".*/\1/p" -e "s/^[[:space:]]*$1=\([^\"#[:space:]]*\).*/\1/p" "$f"
	done | tail -n 1
}

# rundir -- Xymon's directory for runtime files, where a plugin's sockets
# go: XYMONRUNDIR, or XYMONSERVERLOGS when it is empty, as Xymon does. Asked
# of Xymon itself first: xymoncmd loads xymonserver.cfg as xymonlaunch does
# for the plugins' tasks -- its includes and directories, its variables
# expanded, Xymon's defaults -- so the snippets name the socket the API
# makes; with a clean environment, so that nothing of this shell's slips
# in. Under DESTDIR the stage's xymoncmd is not run, being the installed
# system's, and where it is missing or fails, the files are read here, as
# cfgval reads them. Empty when that gives no absolute path -- one that names
# a variable, read here -- which the install cannot know.
rundir() {
	if [ -z "$DESTDIR" ] && [ -x "$XYMONHOME/bin/xymoncmd" ]; then
		# xymoncmd expands a $ in its own arguments: it runs env, and the
		# two settings are read from what env prints.
		e=$(env -i PATH=/usr/bin:/bin "$XYMONHOME/bin/xymoncmd" --env="$XYMONHOME/etc/xymonserver.cfg" env 2>/dev/null) || e=
		r=$(printf '%s\n' "$e" | sed -n 's/^XYMONRUNDIR=//p' | tail -n 1)
		[ -n "$r" ] || r=$(printf '%s\n' "$e" | sed -n 's/^XYMONSERVERLOGS=//p' | tail -n 1)
		case $r in /*\$*) ;; /*) echo "$r"; return 0 ;; esac
	fi
	r=$(cfgval XYMONRUNDIR) || exit 1
	[ -n "$r" ] || r=$(cfgval XYMONSERVERLOGS) || exit 1
	case $r in /*\$*) ;; /*) echo "$r" ;; esac
}

# stock PLUGIN SNIPPET -- the snippet as this version ships it, @XYMONHOME@
# and @XYMONRUNDIR@ filled in, as the task file's is: what it names lies
# under the server's tree, which only the install knows. @XYMONRUNDIR@ stays
# where rundir is empty.
stock() {
	sed -e "s|@XYMONHOME@|$(sedesc "$XYMONHOME")|g" ${RUNDIR:+-e "s|@XYMONRUNDIR@|$(sedesc "$RUNDIR")|g"} "$ROOT/plugins/$1/$2"
}

# shipped PLUGIN SNIPPET FILE -- true when FILE is, byte for byte, the
# snippet as an older version shipped it: its cksum is among the plugin's
# conf-stock lines, this version's or the installed one's, as it is, or
# with $XYMONHOME put back as @XYMONHOME@, or $RUNDIR as @XYMONRUNDIR@ and
# then $XYMONHOME, so that the same snippet installed under any tree gives
# the same one. As it is first: a snippet without a placeholder is then
# recognised whatever the tree, though $XYMONHOME may also be part of its
# text (/xymon in /xymon/api/). Where that putting back cannot tell, the
# snippet is taken for edited: kept, and said to differ, never overwritten.
shipped() {
	list="
$(field "$1" conf-stock)
$(held "$EXTROOT" "$1" conf-stock)
"
	for way in raw home ${RUNDIR:+run}; do
		sum=$(awk -v way="$way" -v h="$XYMONHOME" -v r="$RUNDIR" '
		function back(s, p, name,    out, i) {
			out = ""
			while ((i = index(s, p)) > 0) { out = out substr(s, 1, i - 1) name; s = substr(s, i + length(p)) }
			return out s
		}
		{ s = $0
		  if (way == "run") s = back(s, r, "@XYMONRUNDIR@")
		  if (way != "raw") s = back(s, h, "@XYMONHOME@")
		  print s }' "$3" | cksum | cut -d' ' -f1,2)
		case $list in *"
$2 $sum
"*) return 0 ;; esac
	done
	return 1
}

# dropped PLUGIN -- the snippets the install in place wrote that this
# version no longer ships, there as files, plain names only: the installed
# PLUGIN copy lies where the Xymon user can write.
dropped() {
	for c in $(held "$EXTROOT" "$1" conf); do
		case " $(field "$1" conf) " in *" $c "*) continue ;; esac
		plain "$c" && { [ -f "$EXTROOT/$1/$c" ] || [ -f "$EXTROOT/.xymon-plugin.$1/$c" ]; } && echo "$c"
	done
	return 0
}

# conf_edited PLUGIN SNIPPET [DIR] -- true when DIR/SNIPPET, ext/PLUGIN's
# by default, is the admin's: a real file, neither as the install before
# wrote it, kept in DIR/.shipped/, nor as a version shipped it (S7, S16).
conf_edited() {
	cd_=${3:-$EXTROOT/$1} ce=${3:-$EXTROOT/$1}/$2
	[ -f "$ce" ] && [ ! -L "$ce" ] || return 1
	if [ -f "$cd_/.shipped/$2" ] && [ ! -L "$cd_/.shipped/$2" ] && cmp -s "$cd_/.shipped/$2" "$ce"; then return 1; fi
	RUNDIR=$(rundir) || exit 1
	! shipped "$1" "$2" "$ce"
}

# replaced PLUGIN -- refuse, before anything changes, an update that would
# drop a snippet the admin edited while this version ships another for
# the same web server, by its -apache, -nginx or -lighttpd: the new one
# would go live without the edits, an access restriction say. Moved out of
# the plugin's directory, the edited one is no longer in the way.
replaced() {
	{ [ -n "${UPDATING:-}" ] && server_installed "$1"; } || cut_short "$1" || return 0
	for rc_ in $(dropped "$1"); do
		case $rc_ in *-apache.conf) rw=apache ;; *-nginx.conf) rw=nginx ;; *-lighttpd.conf) rw=lighttpd ;; *) continue ;; esac
		for rn in $(field "$1" conf); do
			case $rn in *-"$rw".conf) ;; *) continue ;; esac
			# In its directory, or set aside by a run cut short.
			if conf_edited "$1" "$rc_"; then rd=$EXTROOT/$1
			elif conf_edited "$1" "$rc_" "$EXTROOT/.xymon-plugin.$1"; then rd=$EXTROOT/.xymon-plugin.$1
			else continue; fi
			die "$rd/$rc_, which you edited, is no longer shipped: this version's $rn replaces it, and would go live without your edits. Move $rd/$rc_ away, run the update again, then carry your edits into $EXTROOT/$1/$rn before the web server reloads"
		done
	done
	return 0
}

# same PLUGIN SNIPPET FILE -- true when FILE is this version's snippet. The
# x keeps the last newlines a command substitution drops.
same() {
	[ "$(stock "$1" "$2"; echo x)" = "$(cat "$3"; echo x)" ]
}

conf() {
	# The snippets name a path under $XYMONHOME and Xymon's runtime
	# directory; one a web server's configuration cannot take as it is is
	# said, for the admin to write, and so is a runtime directory the
	# install cannot know.
	RUNDIR=$(rundir) || exit 1
	case $XYMONHOME$RUNDIR in
		*[!A-Za-z0-9._/+-]*) echo "The web server snippets in $EXTROOT/$1 name $XYMONHOME${RUNDIR:+ and $RUNDIR}, which hold characters a web server's configuration may not take as they are: check the path in the snippet you include." ;;
	esac
	[ -n "$RUNDIR" ] || echo "The web server snippets in $EXTROOT/$1 name @XYMONRUNDIR@: $XYMONHOME/etc/xymonserver.cfg gives XYMONRUNDIR, or XYMONSERVERLOGS, as no path the install can read; put Xymon's runtime directory in its place in the snippet you include."
	# Each snippet as written is kept in .shipped/, beside it in the
	# plugin's directory, where no include pattern reaches it: the next
	# install takes a snippet still byte for byte that one for unedited,
	# whatever it names -- a runtime directory moved since, say.
	base=$EXTROOT/$1/.shipped
	# A run resumed may have changed a snippet before it was cut short.
	changed=${GONE:-}${RESUMED:-}
	for c in $(field "$1" conf); do
		dst=$EXTROOT/$1/$c
		old=$AS/.shipped/$c
		mkdir -p "$base" || exit 1
		if [ -f "$AS/$c" ]; then
			mv "$AS/$c" "$dst" || exit 1
		else
			stock "$1" "$c" > "$dst" && chmod 644 "$dst" || exit 1
			cp -f "$dst" "$base/$c" || exit 1
			rm -f "$old"
			changed=1
			continue
		fi
		# A kept snippet as an earlier install wrote it, or as an older
		# version shipped it, unedited, takes this version's; one that
		# differs from both is the admin's, and kept, said to be.
		if same "$1" "$c" "$dst"; then
			cp -f "$dst" "$base/$c" || exit 1
		elif { [ -f "$old" ] && cmp -s "$old" "$dst"; } || shipped "$1" "$c" "$dst"; then
			# Unlinked first: written as a new file, never into one a hard
			# link shares with a file outside the plugin's directory.
			rm -f "$dst" || exit 1
			stock "$1" "$c" > "$dst" && chmod 644 "$dst" || exit 1
			cp -f "$dst" "$base/$c" || exit 1
			echo "$dst, unedited, is replaced by this version's"
			changed=1
		else
			this=$AS/$c.this
			stock "$1" "$c" > "$this" || exit 1
			MCHANGED=
			merge "$1" "$c" "$this"
			rm -f "$this"
			[ -z "$MCHANGED" ] || changed=1
			# Kept, it may name a runtime directory moved since.
			if [ -n "$RUNDIR" ] && grep -q '@XYMONRUNDIR@' "$ROOT/plugins/$1/$c" && ! grep -qF "$RUNDIR/" "$dst"; then
				echo "$dst does not name $RUNDIR, Xymon's runtime directory: a socket it names may be one that is no more"
			fi
		fi
		rm -f "$old"
	done
	# A web server reads its configuration when it starts or reloads: one
	# that runs goes on with the snippets it read. Not reloaded from here --
	# it is not the plugin's to run, nor to choose.
	[ -z "$changed" ] || [ -n "$DESTDIR" ] || echo "The web server snippets in $EXTROOT/$1 changed: reload the web server that includes them (apachectl graceful, nginx -s reload, or restart lighttpd)."
}

# selinux PLUGIN -- where SELinux is active, load the plugin's SELinux
# module, PLUGIN.cil in its installed directory, which semodule takes as it
# is; what it grants lies behind booleans, off until the admin sets them,
# as its message says (S23). Named after the plugin, never otherwise, so
# that an uninstall, which reads the installed PLUGIN copy, removes that
# module and no other. Under DESTDIR nothing is loaded: it is the installed
# system's.
selinux() {
	m=$(field "$1" selinux); [ -n "$m" ] || return 0
	[ "$m" = "$1.cil" ] || die "$1: its SELinux module must be $1.cil, not $m"
	if [ -n "$DESTDIR" ]; then
		echo "Under DESTDIR no SELinux module is loaded: on the installed system, where SELinux is active, semodule -i $XYMONHOME/ext/$1/$m"
		return 0
	fi
	command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled && command -v semodule >/dev/null 2>&1 || return 0
	if semodule -i "$EXTROOT/$1/$m"; then
		say "$1" selinux-loaded
	else
		echo "Could not load the SELinux module $EXTROOT/$1/$m: semodule -i it as root" >&2
	fi
}

# fetch_ok QUESTION -- true when fetching modules from PyPI is allowed:
# --venv given, or, on a terminal, QUESTION answered y.
fetch_ok() { [ -n "$VENV_FETCH" ] || offer "$1"; }

# old_modules PYTHON REQUIREMENTS -- the modules PYTHON has in a version
# older than a "NAME>=X.Y" line of REQUIREMENTS asks, each as
# "NAME>=X.Y (has V)": a plugin is tested from those versions on, and an
# older one may start and then fail. A module PYTHON cannot say the
# version of, a line of another form, a file that is not there and a
# Python that fails say nothing: this adds to the check that the modules
# import, and never stands in for it.
old_modules() {
	[ -f "$2" ] || return 0
	"$1" -c 'import re, sys
try:
    from importlib.metadata import version
except Exception:
    sys.exit(0)
def t(v): return tuple(int(x) for x in re.findall("[0-9]+", v)[:3])
old = []
for line in open(sys.argv[1]):
    m = re.match("[ \t]*([A-Za-z0-9_.-]+)[ \t]*>=[ \t]*([0-9][0-9.]*)[ \t]*$", line)
    if not m: continue
    try: have = version(m.group(1))
    except Exception: continue
    if t(have) < t(m.group(2)): old.append("%s>=%s (has %s)" % (m.group(1), m.group(2), have))
sys.stdout.write(", ".join(old))' "$2" 2>/dev/null || :
}

# plugin_python ROOT -- the Python a plugin of the part at ROOT runs with
# (S26): XYMONAPI_PYTHON, else the virtualenv beside the plugins, else
# python3.
plugin_python() {
	if [ -n "${XYMONAPI_PYTHON:-}" ]; then printf '%s\n' "$XYMONAPI_PYTHON"
	elif [ -x "$1/venv/bin/python3" ]; then printf '%s\n' "$1/venv/bin/python3"
	else echo python3; fi
}

# lacking PYTHON MODULE... -- the modules, by their import names, PYTHON
# cannot import; all of them when it does not run.
lacking() {
	lp=$1; shift
	"$lp" -c 'import importlib.util as u, sys; print(" ".join(m for m in sys.argv[1:] if u.find_spec(m) is None))' "$@" 2>/dev/null || echo "$*"
}

# missing_modules PLUGIN -- the server modules its PLUGIN copy names that
# the Python its launcher runs with lacks, and those it has older than the
# plugin's requirements.txt asks: XYMONAPI_PYTHON, else the virtualenv
# beside the plugins, else python3. Nothing under DESTDIR, where no Python
# of the installed system is there to ask.
missing_modules() {
	[ -z "$DESTDIR" ] || return 0
	mods=$(held "$EXTROOT" "$1" server-modules)
	[ -n "$mods" ] || return 0
	py=$(plugin_python "$EXTROOT")
	# shellcheck disable=SC2086
	lacks=$(lacking "$py" $mods)
	olds=$(old_modules "$py" "$EXTROOT/$1/requirements.txt")
	printf '%s\n' "$lacks${lacks:+${olds:+, }}$olds"
}

# offer QUESTION -- on a terminal, ask it; true on y. Without one, false.
offer() {
	[ -t 0 ] && [ -t 1 ] || return 1
	printf '%s [y/N] ' "$1"
	read -r yn
	case $yn in [yY]*) return 0 ;; esac
	return 1
}

# venv_auto PLUGIN ROOT MODULES TARGET NOTE -- the last step of installing a
# plugin that needs the Python modules MODULES (their import names), which
# downloads nothing unless asked. With no virtualenv at ROOT/venv yet: the
# newest Python 3.9 or later on this machine that has them already --
# PYTHON when given, else python3.14 down to python3.9 and python3, on PATH
# and in Homebrew's and pyenv's directories -- is made the virtualenv's,
# with --system-site-packages, so that it is only pinned beside the plugins
# and nothing is copied or fetched; with no such Python, the hint says which
# ./xymon-plugin venv TARGET would use. A candidate is named by the interpreter it
# runs (sys.executable), not a shim or link found on PATH. With a virtualenv
# there, the modules it lacks are named. On a terminal the hint is an offer:
# on "y", ./xymon-plugin venv TARGET -- --server or --tools -- installs the modules
# from PyPI there and then. NOTE says in the offer what the modules are for.
venv_auto() {
	plugin=$1 root=$2 modules=$3 target=$4 note=$5
	[ -n "$modules" ] || return 0
	if [ -n "$DESTDIR" ]; then
		echo "Under DESTDIR no virtualenv is made or used: on the installed system, ./xymon-plugin update $target --venv makes one for $plugin's modules ($modules)."
		return 0
	fi
	# A virtualenv -- its pyvenv.cfg there -- whose Python does not run goes,
	# said, and is made as on a first install: from a Python that has the
	# modules, before any is fetched. Anything else named venv is left.
	if [ -f "$root/venv/pyvenv.cfg" ] && ! "$root/venv/bin/python3" -c 'import sys' 2>/dev/null; then
		echo "The virtualenv $root/venv has no Python that runs: it is made anew."
		VENV_CHANGED=1; rm -rf "$root/venv" || die "could not remove $root/venv"
	fi
	if [ "$target" = --server ] && [ -f "$root/venv/pyvenv.cfg" ]; then open_dir "$root/venv"; fi
	if [ -x "$root/venv/bin/python3" ]; then
		# shellcheck disable=SC2086
		missing=$(lacking "$root/venv/bin/python3" $modules)
		olds=$(old_modules "$root/venv/bin/python3" "$root/$plugin/requirements.txt")
		missing=$missing${missing:+${olds:+, }}$olds
		[ -z "$missing" ] && return 0
		if fetch_ok "The virtualenv $root/venv lacks $missing, which $plugin needs${note:+ ($note)}. Install them into it, from PyPI?"; then
			venv "$root"
		else
			echo "The virtualenv $root/venv lacks $missing, which this plugin needs: ./xymon-plugin update $target --venv installs them."
		fi
		return 0
	fi
	py= newest=
	for c in ${PYTHON_GIVEN:-python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3}; do
		for d in "" /opt/homebrew/bin /usr/local/bin /opt/homebrew/opt/python@3.*/bin "$HOME"/.pyenv/versions/*/bin; do
			case $c in
				/*) p=$c ;;
				*) if [ -n "$d" ]; then p=$d/$c; else p=$(command -v "$c" 2>/dev/null); fi ;;
			esac
			[ -n "$p" ] && [ -x "$p" ] || continue
			"$p" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null || continue
			# One that prints no interpreter is none, whatever its exit
			# status: an empty file runs as an empty script, and exits 0.
			real=$("$p" -c 'import sys; print(sys.executable)' 2>/dev/null)
			[ -n "$real" ] || continue
			[ -x "$real" ] && p=$real
			[ -n "$newest" ] || newest=$p
			# shellcheck disable=SC2086
			[ -z "$(lacking "$p" $modules)" ] || continue
			# One that has them, but older than the plugin is tested
			# with, is not one that has them.
			[ -z "$(old_modules "$p" "$root/$plugin/requirements.txt")" ] || continue
			py=$p; break 2
		done
	done
	if [ -n "$py" ]; then
		# It has the modules: where it cannot make a virtualenv -- Debian
		# without python3-venv -- the plugins can still run with it.
		if ! "$py" -m venv --system-site-packages "$root/venv" || [ ! -x "$root/venv/bin/python3" ]; then
			echo "Could not make a virtualenv at $root/venv with $py (on Debian and Ubuntu, python3-venv provides what it needs): the plugins run with the python3 on PATH, or XYMONAPI_PYTHON=$py, which has the modules ($modules)."
			return 0
		fi
		# A Python that is itself a virtualenv gives one made from it its
		# base Python's modules, not its own: none of them, it may be.
		# shellcheck disable=SC2086
		if [ -n "$(lacking "$root/venv/bin/python3" $modules)" ]; then
			rm -rf "$root/venv" || die "could not remove $root/venv"
			echo "Made no virtualenv at $root/venv from $py: it is itself one, whose modules one made from it does not see; the plugins run with it as it is, XYMONAPI_PYTHON=$py, which has the modules ($modules)."
			return 0
		fi
		VENV_CHANGED=1
		echo "Made $root/venv from $py ($("$py" -V 2>&1)), which has the modules this plugin needs ($modules): the plugins there run with it."
	elif [ -n "$newest" ] && fetch_ok "$plugin needs $modules, which no Python here has${note:+ ($note)}. Make a virtualenv at $root/venv with $newest, and install them from PyPI?"; then
		was=$PYTHON; PYTHON=$newest; venv "$root"; PYTHON=$was
	else
		echo "No virtualenv at $root/venv, and no Python with the modules this plugin needs ($modules): ./xymon-plugin update $target --venv${newest:+ PYTHON=$newest} makes one and installs them; without it, the python3 on PATH must have them."
	fi
}

# venv ROOT -- a virtualenv at ROOT/venv, beside the plugins installed in
# ROOT, with the modules of each, from the requirements.txt installed with
# it: what every launcher runs with when XYMONAPI_PYTHON names no other. Run
# again, it adds the modules of a plugin installed since.
venv() {
	[ -z "$DESTDIR" ] || return 0
	VENV_CHANGED=1
	# One whose Python does not run -- moved, or the Python it was made
	# from gone -- is made anew: it is the plugins', beside them (S26).
	if [ -f "$1/venv/pyvenv.cfg" ] && ! "$1/venv/bin/python3" -c 'import sys' 2>/dev/null; then
		echo "The virtualenv $1/venv has no Python that runs: it is made anew."
		rm -rf "$1/venv" || die "could not remove $1/venv"
	fi
	if [ ! -x "$1/venv/bin/python3" ]; then
		"$PYTHON" -m venv "$1/venv" || exit 1
		[ -x "$1/venv/bin/python3" ] || die "$PYTHON made no virtualenv at $1/venv"
	fi
	for r in "$1"/*/requirements.txt; do
		[ -e "$r" ] || continue
		echo "installing the modules of $r"
		"$1/venv/bin/python3" -m pip install -q -r "$r" \
			|| die "pip could not install the modules of $r into $1/venv: what it said is above"
	done
	echo "The plugins in $1 run with $1/venv/bin/python3 ($("$1/venv/bin/python3" -V))."
}

DONE=
# The plugins this command installed, whose MANIFEST it writes at its end.
MANIFESTS=
# manifests -- write them, the command's last step (S29).
manifests() {
	for n in $MANIFESTS; do
		if [ "$PART" = tools ]; then manifest_tools "$n"; else manifest_ext "$n"; fi
	done
}
# passed_over ROOT PLUGIN -- true, said, for a plugin installed already
# under ROOT, and not updating: --all, or a plugin needed, passes over it,
# with a note when this copy's is newer.
passed_over() {
	[ -z "${UPDATING:-}" ] && v=$(installed "$1" "$2") || return 1
	# One cut short is resumed, not passed over.
	case $1 in "$EXTROOT") ! cut_short "$2" || return 1 ;; esac
	here=$(field "$2" version)
	if [ -n "$here" ] && older "$v" "$here"; then w="; this copy has $here: ./xymon-plugin update"; else w=; fi
	echo "$2 is installed already ($v): left as it is$w"
	DONE="$DONE $2"
}

install_server() {
	case " $DONE " in *" $1 "*) return 0 ;; esac
	passed_over "$EXTROOT" "$1" && return 0
	self_sources || exit 1
	ns=$(needs "$1" server) || exit 1
	for n in $ns; do known "$n"; install_server "$n"; done
	[ -n "$(field "$1" server-files)" ] || die "$1 has nothing to install on the server"
	ext=$EXTROOT/$1
	# What the install in place put outside its directory, by its record,
	# for what this one no longer does.
	was_manual=$(held "$EXTROOT" "$1" server-manual)
	was_task=$(held "$EXTROOT" "$1" server-task)
	was_selinux=$(held "$EXTROOT" "$1" selinux)
	# Refused before anything is replaced, not halfway through.
	[ -z "$(field "$1" server-task)" ] || ours "$1"
	task_writes "$1"
	# The task file an admin may have enabled, the web server snippets an
	# admin may have edited, and each NAME.old outlive the directory: set
	# aside in AS, the one a run cut short left taken up (aside), and
	# only what it lacks set aside from the directory (put_aside).
	# A real file is copied aside and stays, so that the link tasks.d/ has
	# to it never points nowhere; task puts the copy back over it.
	# A link come since the check before anything changed: not followed.
	[ ! -L "$ext" ] || die "$ext is a link: left as it is"
	# From before the PLUGIN copy, its manual page was copied into MANDIR,
	# not linked: the link takes its place.
	legacy=; [ ! -f "$ext/VERSION" ] || [ -e "$ext/PLUGIN" ] || [ -L "$ext/PLUGIN" ] || legacy=1
	progress "$1"
	aside "$1"
	keep="$PROG PLUGIN MANIFEST"
	if [ -f "$ext/tasks.cfg" ] && [ ! -L "$ext/tasks.cfg" ] && [ -n "$(field "$1" server-task)" ]; then
		put_aside "$ext/tasks.cfg" tasks.cfg cp
		keep="$keep tasks.cfg"
	elif [ -f "$ext/tasks.cfg" ]; then
		put_aside "$ext/tasks.cfg" tasks.cfg
	fi
	# And the task file as the install before wrote it, which merge meets
	# it with: a real directory and a real file only.
	if [ -d "$ext/.shipped" ] && [ ! -L "$ext/.shipped" ] && [ -f "$ext/.shipped/tasks.cfg" ] && [ ! -L "$ext/.shipped/tasks.cfg" ] && [ ! -e "$AS/.shipped/tasks.cfg" ]; then
		mv "$ext/.shipped/tasks.cfg" "$AS/.shipped/tasks.cfg" || exit 1
	fi
	# Each NAME.old: a file at any depth, a link as a link, a directory
	# whole.
	while IFS= read -r f; do
		[ -z "$f" ] || put_aside "$ext/$f" "$f"
	done <<EOF
$(olds "$ext")
EOF
	# A snippet the install before wrote that this version has no more goes
	# with fresh: a change the web server has to reload for, as conf says.
	# One the admin edited is kept, set aside, as NAME.old (aside_back):
	# out of reach of the include lines, which end in .conf (S16).
	GONE=''
	for c in $(dropped "$1"); do
		GONE=1
		[ -f "$ext/$c" ] && conf_edited "$1" "$c" || continue
		put_aside "$ext/$c" "$c"
		if [ ! -L "$ext/.shipped" ] && [ -f "$ext/.shipped/$c" ] && [ ! -L "$ext/.shipped/$c" ] && [ ! -e "$AS/.shipped/$c" ]; then
			mv "$ext/.shipped/$c" "$AS/.shipped/$c" || exit 1
		fi
	done
	for c in $(field "$1" conf); do
		# A real file only: one a link stands for is written anew, never
		# written through, wherever it points.
		if [ -f "$ext/$c" ] && [ ! -L "$ext/$c" ]; then put_aside "$ext/$c" "$c"; fi
		# And what the install before wrote of it, which conf compares the
		# snippet with: a real directory and a real file only, the plugin's
		# directory being one the Xymon user may write.
		if [ -d "$ext/.shipped" ] && [ ! -L "$ext/.shipped" ] && [ -f "$ext/.shipped/$c" ] && [ ! -L "$ext/.shipped/$c" ] && [ ! -e "$AS/.shipped/$c" ]; then
			mv "$ext/.shipped/$c" "$AS/.shipped/$c" || exit 1
		fi
	done
	fresh "$ext" "$keep" || exit 1
	# Kept, not made anew, it may be one made under umask 077.
	open_dir -1 "$EXTROOT"
	open_dir -1 "$ext"
	# PLUGIN first, VERSION last: a plugin's directory with its PLUGIN file
	# and no VERSION is an install that did not end, which outdated says.
	record "$1" "$ext"
	copy "$1" server "$ext"
	dist "$1"
	[ "$was_manual" = "$(field "$1" server-manual)" ] && [ -z "$legacy" ] || drop_manual "$was_manual" "$MANDIR" "$XYMONHOME/ext/$1" "$legacy"
	manual "$1" "$(field "$1" server-manual)" "$ext" "$MANDIR" "$XYMONHOME/ext/$1"
	task_gone "$1"
	task "$1"
	conf "$1"
	# What is left set aside goes back, the .old files among it, last: one
	# cut short keeps them set aside, for the next to resume with.
	aside_back
	version "$1" "$ext"
	progress_done "$1"
	if [ -n "${UPDATING:-}" ]; then w=Updated; else w=Installed; fi
	echo "$w $1 $(sed -e 's|^.*/v||' "$ext/VERSION") in $XYMONHOME/ext/$1."
	[ -n "${UPDATING:-}" ] || say "$1" installed
	# A module the installed version loaded and this one has not goes.
	if [ -n "$was_selinux" ] && [ -z "$(field "$1" selinux)" ] && [ -z "$DESTDIR" ] && command -v semodule >/dev/null 2>&1; then
		semodule -r "$1" >/dev/null 2>&1 || :
	fi
	selinux "$1"
	venv_auto "$1" "$EXTROOT" "$(field "$1" server-modules)" --server ""
	# MANIFEST is written once the whole command is done (S29): what
	# watches it to take up new code -- the API stops, and xymonlaunch
	# starts it again (S7) -- then finds every plugin of the command and
	# the virtualenv they share in place. No process is looked for.
	MANIFESTS="$MANIFESTS $1"
	DONE="$DONE $1"
}

install_tools() {
	case " $DONE " in *" $1 "*) return 0 ;; esac
	passed_over "$TOOLSROOT" "$1" && return 0
	ns=$(needs "$1" tools) || exit 1
	for n in $ns; do known "$n"; install_tools "$n"; done
	[ -n "$(field "$1" tools-files)" ] || die "$1 has nothing to install on your own machine"
	dir=$TOOLSROOT/$1
	if [ -L "$dir" ]; then rm -f "$dir" || exit 1; fi
	was_manual=$(held "$TOOLSROOT" "$1" tools-manual)
	was_command=$(held "$TOOLSROOT" "$1" command)
	fresh "$dir" MANIFEST || exit 1
	mkdir -p "$BIN" "$TOOLSMAN1"
	# PLUGIN first, VERSION last, as on the server.
	record "$1" "$dir"
	copy "$1" tools "$dir"
	set -f
	# shellcheck disable=SC2086
	[ "$was_command" = "$(field "$1" command)" ] || drop_command "$1" $was_command
	set +f
	[ "$was_manual" = "$(field "$1" tools-manual)" ] \
		|| drop_manual "$was_manual" "$PREFIX/share/man" "$PREFIX/libexec/xymon-plugins/$1" ""
	set -- "$1" $(field "$1" command)
	# The name free, or the command an install of this plugin wrote --
	# the old version's for another script went with drop_command above --
	# it is written; anything else there is the person's, left and said.
	if [ $# -eq 3 ] && { [ -e "$BIN/$2" ] || [ -L "$BIN/$2" ]; } && ! our_command "$1" "$2" "$3"; then
		echo "$PREFIX/bin/$2 is another's, left as it is: run $1's command as $PREFIX/libexec/xymon-plugins/$1/$3"
	elif [ $# -eq 3 ]; then
		rm -f "$BIN/$2" || exit 1
		wrapper "$1" "$3" > "$BIN/$2"
		chmod 755 "$BIN/$2"
	fi
	manual "$1" "$(field "$1" tools-manual)" "$dir" "$PREFIX/share/man" "$PREFIX/libexec/xymon-plugins/$1"
	version "$1" "$dir"
	venv_auto "$1" "$TOOLSROOT" "$(echo $(field "$1" tools-modules) $(field "$1" tools-optional-modules))" --tools "$(field "$1" venv-note)"
	MANIFESTS="$MANIFESTS $1"
	if [ -n "${UPDATING:-}" ]; then w=Updated; else w=Installed; fi
	echo "$w $1 $(sed -e 's|^.*/v||' "$dir/VERSION") in $PREFIX/libexec/xymon-plugins/$1."
	# Said once, and not under DESTDIR, where PATH is the build machine's.
	if [ -n "$(field "$1" command)" ] && [ -z "$DESTDIR" ] && [ -z "${PATHSAID:-}" ]; then
		case ":$PATH:" in *":$PREFIX/bin:"*) ;; *) echo "The commands are in $PREFIX/bin, which is not on PATH: add it, as export PATH=\"$PREFIX/bin:\$PATH\" in your shell's profile."; PATHSAID=1 ;; esac
	fi
	[ -n "${UPDATING:-}" ] || say "$1" installed-tools
	DONE="$DONE $1"
}

# task_writes PLUGIN -- refused before anything is replaced, rather than
# cut short halfway, and every resume with it: this version changes what
# TASKDIR holds -- a file in the link's place made a link, the link or the
# file of a task gone taken -- and nothing can be made there, as in a
# client's etc/ that is the system's. Tried, not read from a mode bit,
# which stops nothing for root.
task_writes() {
	l=$TASKDIR/$(tn "$1").cfg
	tw=$(field "$1" "$TASKKEY")
	# The server's tasks.d/, made for any task, made now.
	if [ -n "$tw" ] && [ "$TPART" = server ] && [ ! -d "$TASKDIR" ]; then
		mkdir -p "$TASKDIR" 2>/dev/null || die "could not make $TASKDIR, where $1's task goes: nothing is replaced"
	fi
	dis='^[[:space:]]*DISABLED[[:space:]]*$'
	if [ -n "$tw" ]; then
		# A file in the link's place made a link; a task DISABLED, in
		# this version's file or the one in place, its link taken.
		{ [ -f "$l" ] && [ ! -L "$l" ]; } \
			|| { is_on "$1" && { grep -q "$dis" "$ROOT/plugins/$1/$tw" || grep -q "$dis" "$EXTROOT/$1/tasks.cfg"; } 2>/dev/null; } \
			|| return 0
	elif [ -L "$l" ]; then
		[ "$(readlink "$l")" = "$XYMONHOME/ext/$1/tasks.cfg" ] || return 0
	else
		[ -f "$l" ] && [ -n "$(held "$EXTROOT" "$1" "$TASKKEY")" ] || return 0
	fi
	lt=$TASKDIR/.$(tn "$1").cfg.tmp
	{ rm -f "$lt" && ln -s "$l" "$lt" && rm -f "$lt"; } 2>/dev/null \
		|| die "$TASKDIR cannot be written, where $1's update must change $l: nothing is replaced"
}

# link_left PLUGIN -- drop_task could not remove $l, the plugin's
# directory gone: said, with what takes it.
link_left() {
	if [ -L "$l" ]; then die "could not remove $l: left, pointing to the removed task file; ./xymon-plugin clean --$TPART$(hx) $1 takes it once it can be written"
	else die "could not remove $l: left, xymonlaunch reading it still; remove it once it can be written"; fi
}

# task_gone PLUGIN -- a task this version has no more, by the record
# (was_task) or the link to it, the record a run cut short may have written
# anew: its link goes; the task file, set aside, is kept by aside_back,
# edited; and so is a file in the link's place, xymonlaunch's, edited.
task_gone() {
	[ -z "$(field "$1" "$TASKKEY")" ] || return 0
	[ -n "$was_task" ] || [ "$(readlink "$TASKDIR/$(tn "$1").cfg" 2>/dev/null)" = "$XYMONHOME/ext/$1/tasks.cfg" ] || return 0
	l=$TASKDIR/$(tn "$1").cfg
	if [ -f "$l" ] && [ ! -L "$l" ] && ! cmp -s "$l" "$AS/.shipped/tasks.cfg"; then
		put_aside "$l" tasks.cfg
		echo "$l, edited, read by xymonlaunch in the link's place, is kept with $1's task file"
	fi
	drop_task "$1" || die "could not remove $l: $1's task stays on"
}

# install_client PLUGIN -- its client part in the client's tree: its
# files, VERSION, PLUGIN copy, and its manual page, linked from MANDIR only
# when that can be written; its task, off until enabled, as the server's.
# Nothing else: no stage for /plugins,
# no virtualenv, no snippet, no SELinux module.
install_client() {
	case " $DONE " in *" $1 "*) return 0 ;; esac
	own_self "$1" && return 0
	passed_over "$EXTROOT" "$1" && return 0
	ns=$(needs "$1" client) || exit 1
	# In a server's own client tree, a need on xymon-plugin is met by the
	# server's copy (S36): refused while the server has none.
	if [ -n "$OWNOF" ]; then
		case " $ns " in *" $self "*)
			[ -f "$OWNOF/ext/$self/VERSION" ] || die "$1 needs $self, whose part in the client tree of a Xymon server is the server's copy, which $OWNOF has not: ./xymon-plugin install --server --xymon-home $(shq "$OWNOF") $self first" ;;
		esac
	fi
	for n in $ns; do known "$n"; install_client "$n"; done
	[ -n "$(field "$1" client-files)" ] || die "$1 has no client part"
	dir=$EXTROOT/$1 ext=$EXTROOT/$1
	was_manual=$(held "$EXTROOT" "$1" client-manual)
	was_task=$(held "$EXTROOT" "$1" client-task)
	# Refused before anything is replaced, not halfway through.
	[ -z "$(field "$1" client-task)" ] || ours "$1"
	task_writes "$1"
	[ ! -L "$dir" ] || die "$dir is a link: left as it is"
	progress "$1"
	# The task file, which the admin may have edited and enabled, and each
	# NAME.old, set aside as on the server (install_server, S7).
	aside "$1" || exit 1
	keep="$PROG PLUGIN MANIFEST"
	if [ -f "$dir/tasks.cfg" ] && [ ! -L "$dir/tasks.cfg" ] && [ -n "$(field "$1" client-task)" ]; then
		put_aside "$dir/tasks.cfg" tasks.cfg cp
		keep="$keep tasks.cfg"
	elif [ -f "$dir/tasks.cfg" ]; then
		put_aside "$dir/tasks.cfg" tasks.cfg
	fi
	if [ -d "$dir/.shipped" ] && [ ! -L "$dir/.shipped" ] && [ -f "$dir/.shipped/tasks.cfg" ] && [ ! -L "$dir/.shipped/tasks.cfg" ] && [ ! -e "$AS/.shipped/tasks.cfg" ]; then
		mv "$dir/.shipped/tasks.cfg" "$AS/.shipped/tasks.cfg" || exit 1
	fi
	while IFS= read -r f; do
		[ -z "$f" ] || put_aside "$dir/$f" "$f"
	done <<EOF
$(olds "$dir")
EOF
	fresh "$dir" "$keep" || exit 1
	# PLUGIN first, VERSION last, as on the server.
	record "$1" "$dir"
	copy "$1" client "$dir"
	pg=$(field "$1" client-manual)
	[ "$was_manual" = "$pg" ] || drop_manual "$was_manual" "$MANDIR" "$XYMONHOME/ext/$1" ""
	# A client's MANDIR is often the system's, which its owner, not root,
	# cannot write: the page then stays in the directory alone, said.
	mr=$MANDIR
	if [ -n "$pg" ]; then
		sec=$MANDIR/man${pg##*.}
		# The section a directory that can be written, or none yet under a
		# MANDIR that can; manual leaves the page's name to another's.
		if [ -d "$sec" ]; then [ -w "$sec" ] || mr=
		elif [ -e "$sec" ] || [ -L "$sec" ]; then mr=
		else [ -d "$MANDIR" ] && [ -w "$MANDIR" ] || mr=
		fi
		[ -n "$mr" ] || echo "$sec cannot be written: $1's manual page is not linked from it, and is read as man $XYMONHOME/ext/$1/$pg"
	fi
	manual "$1" "$pg" "$dir" "$mr" "$XYMONHOME/ext/$1"
	task_gone "$1"
	task "$1" || exit 1
	aside_back || exit 1
	version "$1" "$dir"
	progress_done "$1"
	MANIFESTS="$MANIFESTS $1"
	if [ -n "${UPDATING:-}" ]; then w=Updated; else w=Installed; fi
	echo "$w $1 $(sed -e 's|^.*/v||' "$dir/VERSION") in $XYMONHOME/ext/$1."
	DONE="$DONE $1"
}

# needed PLUGIN PART DIR [SKIP] -- refuse to remove the plugin's PART part
# while one installed in DIR, and not among SKIP, needs it beside it:
# removing it would leave that one broken.
needed() {
	for p in "$3"/*; do
		# An install is what client_installed or server_installed asks, a
		# tools part's its VERSION: any other directory there is no
		# plugin's, and needs nothing (S3); nor does one removed in the
		# same run, SKIP.
		case $2 in
			client|server) "$2_installed" "${p##*/}" || cut_short "${p##*/}" || continue ;;
			*) [ -d "$p" ] && [ -f "$p/VERSION" ] || continue ;;
		esac
		case " ${4:-} " in *" ${p##*/} "*) continue ;; esac
		ns=$(needs "${p##*/}" "$2" "$3") || exit 1
		case " $ns " in
			*" $1 "*) die "$1 is needed by ${p##*/}, installed in $3: ./xymon-plugin remove --$2 ${p##*/} first" ;;
		esac
	done
	return 0
}

# record PLUGIN DIR -- keep the plugin's PLUGIN file in DIR, its installed
# directory, as the record held reads.
record() {
	# A new file renamed over one kept by fresh: never written through.
	rm -f "$2/.PLUGIN.new" && cp "$ROOT/plugins/$1/PLUGIN" "$2/.PLUGIN.new" && chmod 644 "$2/.PLUGIN.new" \
		&& mv -f "$2/.PLUGIN.new" "$2/PLUGIN" || exit 1
}

# drop_manual NAME MANROOT FINAL LEGACY -- remove the manual page NAME from
# its section under MANROOT, without DESTDIR, when it is the link an install made into FINAL,
# the plugin's directory as installed; or, for an install from before the
# record, LEGACY set, the page copied there, its name the checkout's.
drop_manual() {
	[ -n "$1" ] && plain "$1" || return 0
	m=$(inside "$2/man${1##*.}") || exit 1
	m=$m/$1
	if [ -L "$m" ]; then
		if [ "$(readlink "$m")" = "$3/$1" ]; then
			# The page its other part shares, still there in the server's
			# other tree: the link points at that copy, not gone.
			tw=; [ "$2" != "$MANDIR" ] || tw=$(twin "${3##*/}")
			if [ -n "$tw" ] && [ -f "$tw/$1" ]; then rm -f "$m" && ln -s "$tw/$1" "$m"; else rm -f "$m"; fi
		fi
	elif [ -n "$4" ]; then
		rm -f "$m"
	fi
	return 0
}

# wrapper PLUGIN SCRIPT -- the command an install writes in $BIN: it runs
# the script from where it is installed, PREFIX as given, without DESTDIR.
# Every version has written this one: a change here leaves the commands
# written before another's (our_command), unless it still knows them.
wrapper() {
	printf '#!/bin/sh\nexec "%s/libexec/xymon-plugins/%s/%s" "$@"\n' "$PREFIX" "$1" "$2"
}

# our_command PLUGIN NAME SCRIPT -- true when $BIN/NAME is, byte for byte,
# the command an install of PLUGIN wrote for SCRIPT, and not a command of
# someone else's, a wrapper of their own among them, nor a link (S4, S20).
our_command() {
	[ -n "$2" ] && plain "$2" && plain "$3" && [ -f "$BIN/$2" ] && [ ! -L "$BIN/$2" ] || return 1
	# The x keeps the trailing newlines a command substitution drops.
	[ "$(cat "$BIN/$2"; echo x)" = "$(wrapper "$1" "$3"; echo x)" ]
}

# drop_command PLUGIN NAME SCRIPT -- remove $BIN/NAME when it is ours.
drop_command() {
	! our_command "$@" || rm -f "$BIN/$2"
	return 0
}

# drop_task PLUGIN -- remove its task link in tasks.d/ (tn): the link to
# the plugin's task file, or
# the file there, a copy an older install made or the task an editor left
# in the link's place; never a link to something else. With ABSENT, the
# plugin's directory not there, a file there is no install's surely, and
# is left, said.
drop_task() {
	l=$TASKDIR/$(tn "$1").cfg
	if [ -L "$l" ]; then
		[ "$(readlink "$l")" != "$XYMONHOME/ext/$1/tasks.cfg" ] || rm -f "$l" || return 1
	elif [ -n "${2:-}" ] && [ -f "$l" ]; then
		echo "$l is left as it is: $1 is not installed, so it may be no install's"
	elif [ ! -d "$l" ]; then
		rm -f "$l" || return 1
	fi
	rm -f "$TASKDIR/.$(tn "$1").cfg.tmp"
}

# installed_as NAME PART -- NAME is a PART part an install left in ext/: a
# directory, not a link, with VERSION and PLUGIN as an install writes
# them, plain files, the PLUGIN naming NAME and a PART part; VERSION is
# written after the files, so an install cut short before it has none.
# Not MANIFEST, which decides nothing alone (S29): an update cut short
# after VERSION is put right by the next. Read from that PLUGIN alone,
# never the checkout's: a removal takes the directory whole, and must not
# take one that only looks like an install.
installed_as() {
	plain "$1" || return 1
	ci=$EXTROOT/$1
	[ -d "$ci" ] && [ ! -L "$ci" ] && [ -f "$ci/VERSION" ] && [ ! -L "$ci/VERSION" ] \
		&& [ -f "$ci/PLUGIN" ] && [ ! -L "$ci/PLUGIN" ] \
		&& [ "$(sed -n 's/^name: *//p' "$ci/PLUGIN")" = "$1" ] \
		&& [ -n "$(sed -n "s/^$2-files: *//p" "$ci/PLUGIN")" ] && ! cut_short "$1"
}
# cut_short NAME -- ext/NAME holds PROG, as a plain file naming NAME: an
# install or update that did not end, which the next resumes (S20),
# whatever else the directory holds. Nothing else is taken for one.
cut_short() {
	plain "$1" && [ -d "$EXTROOT/$1" ] && [ ! -L "$EXTROOT/$1" ] && [ -f "$EXTROOT/$1/$PROG" ] && [ ! -L "$EXTROOT/$1/$PROG" ] \
		&& [ "$(sed -n 's/^xymon-plugin in progress: \([^ ]*\).*/\1/p' "$EXTROOT/$1/$PROG")" = "$1" ]
}
client_installed() { installed_as "$1" client; }

# server_installed NAME -- the same for a server part; or, with no PLUGIN
# at all, a directory with a plain VERSION, an install from before the
# copy, of a plugin of this checkout, whose PLUGIN file manages it (S20).
server_installed() {
	plain "$1" || return 1
	if [ -e "$EXTROOT/$1/PLUGIN" ] || [ -L "$EXTROOT/$1/PLUGIN" ]; then installed_as "$1" server
	else [ -d "$EXTROOT/$1" ] && [ ! -L "$EXTROOT/$1" ] && [ -f "$EXTROOT/$1/VERSION" ] && [ ! -L "$EXTROOT/$1/VERSION" ] \
		&& [ -f "$ROOT/plugins/$1/PLUGIN" ] && ! cut_short "$1"; fi
}

# no_install PART NAME -- why ext/NAME is no install of NAME's PART part,
# and what to do: an install cut short is resumed by install or update;
# anything else, by hand, as nothing here takes it.
no_install() {
	if cut_short "$2"; then
		if removable "$2"; then
			echo "$EXTROOT/$2 is an install of $2's $1 part cut short, nothing set aside: ./xymon-plugin update --$1 $2 resumes it, or ./xymon-plugin remove --$1 $2 takes it"
		else
			echo "$EXTROOT/$2 is an install of $2's $1 part cut short: ./xymon-plugin update --$1 $2 resumes it, with what it set aside"
		fi
		return
	fi
	o=; [ "$1" = client ] || o=", or VERSION alone from before the PLUGIN copy"
	echo "$EXTROOT/$2 is not $2's $1 part as an install leaves it (VERSION and PLUGIN, plain files, naming $2 and a $1 part$o): left as it is; if nothing in it is wanted, remove it by hand: rm -rf $(shq "$EXTROOT/$2")"
}

# part_left PART NAME -- refuse ext/NAME when it is there and no install's
# of PART: install, update and remove would replace or take it whole. An
# install cut short is taken by install and update, RESUME set, which
# resume it.
RESUME=
part_left() {
	{ [ ! -e "$EXTROOT/$2" ] && [ ! -L "$EXTROOT/$2" ]; } || takes "$1" "$2" || die "$(no_install "$1" "$2")"
}
# takes PART NAME -- ext/NAME is one this run may take whole: an install,
# or one cut short -- by install or update, RESUME set, which resume it;
# by remove only a first install's (removable).
takes() {
	"$1_installed" "$2" || { cut_short "$2" && { [ -n "$RESUME" ] || removable "$2"; }; }
}
# removable NAME -- ext/NAME, cut short, holds nothing of the admin's: a
# first install's, as its file in progress says, nothing set aside.
removable() {
	grep -q ' first$' "$EXTROOT/$1/$PROG" && aside_empty "$1"
}

# ext_names -- what in ext/ may be a plugin's, one name a line: a plugin of
# this checkout's name, or a directory holding a PLUGIN or a VERSION. The
# rest -- the site's own scripts, the virtualenv, the stage /plugins
# serves, the dot files an install keeps beside a directory -- is not read.
ext_names() {
	for d in "$EXTROOT"/*; do
		{ [ -e "$d" ] || [ -L "$d" ]; } || continue
		case ${d##*/} in venv|xymon-plugins-dist) continue ;; esac
		[ -f "$ROOT/plugins/${d##*/}/PLUGIN" ] \
			|| { [ -d "$d" ] && { [ -e "$d/PLUGIN" ] || [ -L "$d/PLUGIN" ] || [ -e "$d/VERSION" ] || [ -L "$d/VERSION" ]; }; } \
			|| continue
		printf '%s\n' "${d##*/}"
	done
}

# installs PART [ABSENT] -- for an action given no names, every directory
# in ext/ an install left, and with ABSENT the plugins of LIST with none;
# anything else there is passed over, said -- one another run is making
# as such (running), not as no install.
installs() {
	if [ -n "${2:-}" ]; then
		for n in $LIST; do [ -e "$EXTROOT/$n" ] || [ -L "$EXTROOT/$n" ] || echo "$n"; done
	fi
	while IFS= read -r n; do
		[ -n "$n" ] || continue
		if plain "$n" && running "$n" quiet; then echo "$RUNMSG" >&2
		elif takes "$1" "$n"; then echo "$n"
		else echo "$EXTROOT/$n is no install of $n's: left as it is" >&2; fi
	done <<EOX
$(ext_names)
EOX
}

# client_ok NAME -- before anything changes, NAME and every client part it
# needs: a plugin of this checkout with a client part, its needs ones the
# client part can hold (S3), and its directory in ext/ either absent or
# one an install left (client_installed): install and update replace that
# directory whole, and ext/ may hold anything (S28).
client_ok() {
	case " $CLIENT_CHECKED " in *" $1 "*) return 0 ;; esac
	CLIENT_CHECKED="$CLIENT_CHECKED $1"
	known "$1"
	[ -n "$(field "$1" client-files)" ] || die "$1 has no client part"
	# Every file it names, there to copy: one missing would stop the
	# install halfway, a plugin installed before it.
	set -f
	for f in $(field "$1" client-files) $(field "$1" client-manual); do
		plain "$f" && [ -f "$ROOT/plugins/$1/$f" ] && [ ! -L "$ROOT/plugins/$1/$f" ] \
			|| { set +f; die "$1's PLUGIN file names '$f' for its client part, which is no file of its own directory, or a link"; }
	done
	set +f
	ns=$(needs "$1" client) || exit 1
	for m in $ns; do client_ok "$m"; done
	part_left client "$1"
	aside_ok "$1"
}

uninstall_client() {
	own_self "$1" && return 0
	# Its directory gone (S9): the task link into it alone goes.
	if [ ! -d "$EXTROOT/$1" ]; then
		if [ "$(readlink "$TASKDIR/$(tn "$1").cfg" 2>/dev/null)" = "$XYMONHOME/ext/$1/tasks.cfg" ]; then
			drop_task "$1" absent || link_left "$1"
			echo "$1 is not installed in $XYMONHOME/ext: its task link, left, is removed."
		else
			echo "$1 is not installed in $XYMONHOME/ext: nothing removed."
		fi
		sa=$EXTROOT/.xymon-plugin.$1
		if [ -e "$sa" ] || [ -L "$sa" ]; then stale "$sa" "$1"; fi
		return 0
	fi
	needed "$1" client "$EXTROOT"
	m=$(held "$EXTROOT" "$1" client-manual)
	t=$(held "$EXTROOT" "$1" client-task)
	sa=$EXTROOT/.xymon-plugin.$1
	if cut_short "$1" && marked "$sa" "$1" && aside_empty "$1"; then rm -rf "${sa:?}"; fi
	rm -rf "$EXTROOT/$1" || die "could not remove all of $EXTROOT/$1: what is left is listed above"
	REMOVED=1
	if [ -e "$sa" ] || [ -L "$sa" ]; then stale "$sa" "$1"; fi
	REMEMBER=client
	drop_manual "$m" "$MANDIR" "$XYMONHOME/ext/$1" ""
	[ -z "$t" ] || drop_task "$1" || link_left "$1"
	echo "Uninstalled $1 from $XYMONHOME/ext/$1."
}

# with_installed ROOT -- LIST, and the plugins installed under ROOT with a
# record the checkout no longer has, for an action given no names.
with_installed() {
	echo $LIST
	for d in "$1"/*; do
		[ -f "$d/PLUGIN" ] && [ ! -L "$d/PLUGIN" ] || continue
		n=${d##*/}
		plain "$n" || continue
		case " $(echo $LIST) " in *" $n "*) ;; *) echo "$n" ;; esac
	done
}

uninstall_server() {
	needed "$1" server "$EXTROOT"
	m=$(held "$EXTROOT" "$1" server-manual)
	t=$(held "$EXTROOT" "$1" server-task)
	se=$(held "$EXTROOT" "$1" selinux)
	cf=
	for c in $(held "$EXTROOT" "$1" conf); do
		if [ -f "$EXTROOT/$1/$c" ]; then cf=1; fi
	done
	# Legacy, the page copied, only for a directory there with no copy: with
	# none, a page in MANDIR is no install's to take.
	legacy=; [ ! -f "$EXTROOT/$1/VERSION" ] || [ -f "$EXTROOT/$1/PLUGIN" ] || legacy=1
	# Its directory gone (S9), only what is surely an install's goes: the
	# task link into it, not a file at its name, nor a SELinux module.
	absent=1; [ ! -d "$EXTROOT/$1" ] || { REMOVED=1 absent=; }
	# A set-aside directory of it holding nothing, an install cut short
	# early's, goes with it (takes).
	sa=$EXTROOT/.xymon-plugin.$1
	if cut_short "$1" && marked "$sa" "$1" && aside_empty "$1"; then rm -rf "${sa:?}"; fi
	rm -rf "$EXTROOT/$1" "$DIST/plugins/$1"
	# Any other: the admin's, said, never taken.
	if [ -e "$sa" ] || [ -L "$sa" ]; then stale "$sa" "$1"; fi
	drop_manual "$m" "$MANDIR" "$XYMONHOME/ext/$1" "$legacy"
	[ -z "$t" ] || drop_task "$1" "$absent" || link_left "$1"
	# Its SELinux module, the one named after it (S23).
	if [ -n "$se" ] && [ -z "$absent" ] && [ -z "$DESTDIR" ] && command -v semodule >/dev/null 2>&1; then
		semodule -r "$1" >/dev/null 2>&1 || :
	fi
	if [ -f "$ROOT/plugins/$1/PLUGIN" ]; then say "$1" uninstalled; else echo "Uninstalled $1."; fi
	[ -z "$cf" ] || [ -n "$DESTDIR" ] || [ -d "$EXTROOT/$1" ] || echo "Its web server snippets went with $EXTROOT/$1: reload the web server that included them (apachectl graceful, nginx -s reload, or restart lighttpd)."
}

uninstall_tools() {
	needed "$1" tools "$TOOLSROOT"
	c=$(held "$TOOLSROOT" "$1" command)
	m=$(held "$TOOLSROOT" "$1" tools-manual)
	legacy=; [ ! -d "$TOOLSROOT/$1" ] || [ -f "$TOOLSROOT/$1/PLUGIN" ] || legacy=1
	rm -rf "$TOOLSROOT/$1"
	set -f
	# shellcheck disable=SC2086
	drop_command "$1" $c
	set +f
	drop_manual "$m" "$PREFIX/share/man" "$PREFIX/libexec/xymon-plugins/$1" "$legacy"
	if [ -f "$ROOT/plugins/$1/PLUGIN" ]; then say "$1" uninstalled-tools; else echo "Uninstalled $1."; fi
}

# S30. verify: what differs from what was installed, said one line each,
# changing nothing. BROKEN and UNTIDY count what was found; edited and ok
# lines count for neither.
BROKEN=0 UNTIDY=0
v_broken() { echo "broken: $1"; BROKEN=$((BROKEN + 1)); }
v_untidy() { echo "untidy: $1"; UNTIDY=$((UNTIDY + 1)); }

# v_actual PATH -- where PATH, as installed, lies now: under DESTDIR, inside it.
v_actual() { d=$(inside "${1%/*}") || exit 1; printf '%s/%s\n' "$d" "${1##*/}"; }

# v_runs NAME -- true when a file of that name, not in MANIFEST, can run or
# be imported.
v_runs() { case $1 in *.py|*.pyc|*.pth|*.so|*.sh) return 0 ;; esac; [ -x "$2" ]; }

# verify_plugin PART ROOT PLUGIN -- the lines for one plugin installed.
verify_plugin() {
	part=$1 root=$2 n=$3 dir=$2/$3 fix="./xymon-plugin update --$1 $3" bad=0 before=$((BROKEN + UNTIDY))
	# A set-aside directory beside a complete install, which no run takes
	# up (S7): untidy, to compare and remove.
	if [ "$part" != tools ] && "${part}_installed" "$n" && { [ -e "$EXTROOT/.xymon-plugin.$n" ] || [ -L "$EXTROOT/.xymon-plugin.$n" ]; }; then
		v_untidy "$n: $(stale "$EXTROOT/.xymon-plugin.$n" "$n")"
	fi
	if [ "$part" != tools ] && ! "${part}_installed" "$n"; then
		# No install's: update and remove refuse it (S20), nor is it read.
		v_broken "$n: $(no_install "$part" "$n")"
		return 0
	elif [ ! -f "$dir/MANIFEST" ]; then
		v_untidy "$n: no MANIFEST, installed before it was kept: $fix"
	else
		# The paths MANIFEST names, one a line between newlines.
		NL='
'
		named=$NL
		while IFS="$(printf '\t')" read -r kind a b c; do
			case $kind in
				file)
					case $b in /*) f=$(v_actual "$b") ;; *) f=$dir/$b; named="$named$b$NL" ;; esac
					case $b in "$XYMONHOME/ext/xymon-plugins-dist/plugins/$n/"*) named="${named}dist/${b##*/}$NL" ;; esac
					if [ ! -f "$f" ] || [ -L "$f" ]; then v_broken "$n: $b missing: $fix"
					elif [ "$(cksum < "$f")" != "$a" ]; then
						if [ "$c" = admin ]; then echo "edited: $n: $b, the administrator's"
						else v_broken "$n: $b changed: $fix"; fi
					fi ;;
				link)
					case $a in /*) f=$(v_actual "$a") ;; *) f=$dir/$a; named="$named$a$NL" ;; esac
					if [ ! -L "$f" ]; then v_broken "$n: the link $a missing: $fix"
					elif [ "$(readlink "$f")" != "$b" ]; then v_broken "$n: the link $a points to $(readlink "$f"), not $b: $fix"; fi ;;
			esac
		done < "$dir/MANIFEST"
		# What the directory holds that MANIFEST does not name: a
		# __pycache__, bytecode no install wrote, broken (the launchers
		# write none); a file that runs or is imported, broken; any other,
		# untidy.
		while IFS= read -r f; do
			[ -n "$f" ] || continue
			case $named in *"$NL$f$NL"*) continue ;; esac
			# A client part's one file of the administrator's is its task's,
			# when it has one.
			adm=" tasks.cfg $(held "$root" "$n" conf) "
			[ "$part" != client ] || { adm=' '; [ -z "$(held "$root" "$n" client-task)" ] || adm=' tasks.cfg '; }
			case $adm in
				*" ${f%.new} "*) [ "$f" != "${f%.new}" ] && { v_untidy "$n: $f, this version's beside yours: compare, then remove it"; continue; } ;;
			esac
			case $adm in
				*" ${f%.old} "*) [ "$f" != "${f%.old}" ] && [ -e "$dir/${f%.old}" ] && { v_untidy "$n: $f, yours before the merge: compare, then remove it"; continue; } ;;
			esac
			# Any other .old, which an update keeps (S7).
			case $part$f in tools*) ;; *.old|*.old/*) v_untidy "$n: $f, yours, kept by an update: compare, then remove it"; continue ;; esac
			case $f in
				__pycache__|*/__pycache__) v_broken "$n: $f, bytecode no install wrote: $fix" ;;
				*/__pycache__/*|__pycache__/*) ;;
				*) if v_runs "${f##*/}" "$dir/$f"; then v_broken "$n: $f, which can run, is not what was installed: $fix"
				   else v_untidy "$n: $f is not what was installed: $fix"; fi ;;
			esac
		done <<EOF
$(cd "$dir" && find . \( -type f -o -type l -o -type d -name __pycache__ \) ! -name MANIFEST -print | sed -e 's|^\./||' | LC_ALL=C sort)
EOF
		# The copy /plugins serves: nothing in it but what was staged.
		if [ "$part" = server ] && [ -d "$DIST/plugins/$n" ]; then
			for f in "$DIST/plugins/$n"/* "$DIST/plugins/$n"/.[!.]*; do
				[ -e "$f" ] || [ -L "$f" ] || continue
				case $named in *"${NL}dist/${f##*/}$NL"*) continue ;; esac
				v_broken "$n: $XYMONHOME/ext/xymon-plugins-dist/plugins/$n/${f##*/}, served at /plugins, is not what was staged: $fix"
			done
		fi
	fi
	if [ "$part" != tools ]; then
		# The task link, a state MANIFEST leaves out (S29): there, it is the
		# plugin's.
		l=$TASKDIR/$(tn "$n").cfg
		if [ -L "$l" ] && [ "$(readlink "$l")" != "$XYMONHOME/ext/$n/tasks.cfg" ]; then
			v_broken "$n: its task link ${l##*/} points to $(readlink "$l"), not its task file: ./xymon-plugin disable --$part $n, then enable"
		fi
		# Its task file linked under another name, as before the names by
		# part (S6): read all the same, but not the plugin's link.
		for o in "$TASKDIR"/*; do
			if ! [ -L "$o" ] || [ "$o" = "$l" ] || [ "$(readlink "$o")" != "$XYMONHOME/ext/$n/tasks.cfg" ]; then continue; fi
			v_untidy "$n: its task linked as ${o##*/}, not $(tn "$n").cfg: mv $o $l"
		done
	fi
	if [ "$part" = server ]; then
		# Its SELinux module, loaded where SELinux is active.
		if [ -n "$(held "$root" "$n" selinux)" ] && [ -z "$DESTDIR" ] && command -v selinuxenabled >/dev/null 2>&1 \
			&& selinuxenabled && command -v semodule >/dev/null 2>&1; then
			loaded=$(semodule -l 2>/dev/null | awk '{print $1}')
			case " $(echo $loaded) " in *" $n "*) ;; *) v_broken "$n: its SELinux module is not loaded: $fix" ;; esac
		fi
	fi
	# The Python modules it needs: there, and not older than requirements.txt asks.
	mods=$(held "$root" "$n" "$part-modules")
	if [ -n "$mods" ] && [ -z "$DESTDIR" ]; then
		py=$(plugin_python "$root")
		# shellcheck disable=SC2086
		lacks=$(lacking "$py" $mods)
		[ -z "$lacks" ] || v_broken "$n: the Python modules $lacks are missing from $py: ./xymon-plugin update --$part --venv $n"
	fi
	# Those it does without: missing, a note, counted for nothing.
	opt=$(held "$root" "$n" "$part-optional-modules")
	if [ -n "$opt" ] && [ -z "$DESTDIR" ]; then
		py=$(plugin_python "$root")
		# shellcheck disable=SC2086
		lacks=$(lacking "$py" $opt)
		vn=$(held "$root" "$n" venv-note)
		[ -z "$lacks" ] || echo "note: $n: without the Python modules $lacks${vn:+, $vn}: ./xymon-plugin update --$part --venv $n"
	fi
	# Any it has, needed or not, older than requirements.txt asks: broken.
	if [ -n "$mods$opt" ] && [ -z "$DESTDIR" ]; then
		olds=$(old_modules "$py" "$dir/requirements.txt")
		[ -z "$olds" ] || v_broken "$n: older Python modules than it is tested with, $olds: ./xymon-plugin update --$part --venv $n"
	fi
	[ $((BROKEN + UNTIDY)) -ne "$before" ] || echo "ok: $n"
}

# present NAME -- ext/NAME is an install, complete or cut short: what
# left PART takes for a plugin's that is gone is not.
present() { [ -f "$EXTROOT/$1/VERSION" ] || cut_short "$1"; }

# left PART -- what is left in the part that no plugin installed owns (S9),
# one per line, tab-separated: the plugin it was, or * for what the
# plugins shared; where it lies; its path as installed; what it is; and
# "proved" when it is provably that plugin's (S20), the only ones clean
# takes away.
left() {
	T=$(printf '\t')
	if [ "$1" = client ]; then
		left_task
		left_man
	elif [ "$1" = server ]; then
		left_task
		left_man
		for d in "$DIST/plugins"/*; do
			[ -d "$d" ] && [ ! -L "$d" ] || continue
			plain "${d##*/}" && ! present "${d##*/}" \
				&& echo "${d##*/}$T$d$T$XYMONHOME/ext/xymon-plugins-dist/plugins/${d##*/}${T}the staged copy of ${d##*/}${T}proved"
		done
		any=; for d in "$EXTROOT"/*; do present "${d##*/}" && any=1; done
		if [ -z "$any" ]; then
			[ ! -d "$DIST" ] || echo "*$T$DIST$T$XYMONHOME/ext/xymon-plugins-dist${T}the stage /plugins serves, with no plugin installed${T}proved"
			[ ! -d "$EXTROOT/venv" ] || echo "*$T$EXTROOT/venv$T$XYMONHOME/ext/venv${T}the virtualenv, with no plugin installed${T}proved"
		fi
	else
		for c in "$BIN"/*; do
			[ -f "$c" ] && [ ! -L "$c" ] || continue
			t=$(sed -n '2s|^exec "'"$(sedesc "$PREFIX")"'/libexec/xymon-plugins/\([^/]*\)/\([^/"]*\)" "\$@"$|\1/\2|p' "$c" 2>/dev/null)
			[ -n "$t" ] && [ "$(sed -n 1p "$c")" = '#!/bin/sh' ] || continue
			sc=${t#*/}; t=${t%%/*}
			plain "$t" && [ ! -f "$TOOLSROOT/$t/VERSION" ] || continue
			# The x keeps the trailing newlines a command substitution drops.
			if [ "$(cat "$c"; echo x)" = "$(wrapper "$t" "$sc"; echo x)" ]; then pr=proved; else pr=; fi
			echo "$t$T$c$T$PREFIX/bin/${c##*/}${T}the command of $t$T$pr"
		done
		for l in "$TOOLSMAN1"/*; do
			[ -L "$l" ] || continue
			case $(readlink "$l") in
				"$PREFIX/libexec/xymon-plugins/"*/*) t=$(readlink "$l"); t=${t#"$PREFIX/libexec/xymon-plugins/"}; t=${t%%/*}
					plain "$t" && [ ! -f "$TOOLSROOT/$t/VERSION" ] \
						&& echo "$t$T$l$T$PREFIX/share/man/man1/${l##*/}${T}a manual page's link of $t${T}proved" ;;
			esac
		done
		any=; for d in "$TOOLSROOT"/*; do [ -f "$d/VERSION" ] && any=1; done
		[ -n "$any" ] || [ ! -d "$TOOLSROOT/venv" ] \
			|| echo "*$T$TOOLSROOT/venv$T$PREFIX/libexec/xymon-plugins/venv${T}the virtualenv, with no plugin installed${T}proved"
	fi
}

# left_task -- left's lines for the task links in tasks.d/, or a client's
# clientlaunch.d/, that point into the directory, gone, of a plugin of
# this tree.
left_task() {
	for l in "$TASKDIR"/*; do
		[ -L "$l" ] || continue
		case $(readlink "$l") in
			"$XYMONHOME/ext/"*/tasks.cfg) t=$(readlink "$l"); t=${t#"$XYMONHOME/ext/"}; t=${t%/tasks.cfg}
				plain "$t" && ! present "$t" \
					&& echo "$t$T$l$T$LAUNCHHOME/etc/$TASKD/${l##*/}${T}the task link of $t${T}proved" ;;
		esac
	done
	# A server's own client tree: its clientlaunch.d/, from a life as a
	# standalone client, which the server's launcher does not read (S36):
	# a task link an install made there, NAME-client.cfg to that plugin's
	# task file, is left. Only that: a link of the administrator's own, to
	# a hook script of theirs in ext/, is theirs.
	[ -n "$OWNOF" ] || return 0
	for l in "$XYMONHOME/etc/clientlaunch.d"/*-client.cfg; do
		[ -L "$l" ] || continue
		t=${l##*/}; t=${t%-client.cfg}
		plain "$t" && [ "$(readlink "$l")" = "$XYMONHOME/ext/$t/tasks.cfg" ] \
			&& echo "*$T$l$T$l${T}a task link in clientlaunch.d/, which the server's xymonlaunch does not read${T}proved"
	done
}

# left_man -- left's lines for the manual page links in MANDIR that point
# into the directory, gone, of a plugin of this Xymon tree, server or client.
left_man() {
	for l in "$(inside "$MANDIR")"/man[1-9]/*; do
		[ -L "$l" ] || continue
		case $(readlink "$l") in
			"$XYMONHOME/ext/"*/*) t=$(readlink "$l"); t=${t#"$XYMONHOME/ext/"}; t=${t%%/*}
				sec=${l%/*}
				plain "$t" && ! present "$t" \
					&& echo "$t$T$l$T$MANDIR/${sec##*/}/${l##*/}${T}a manual page's link of $t${T}proved" ;;
		esac
	done
}

# verify_left PART -- what is left, untidy, each naming clean.
verify_left() {
	# A set-aside directory of a plugin whose directory is gone (S7).
	if [ "$1" != tools ]; then
		for sa in "$EXTROOT"/.xymon-plugin.*; do
			{ [ -e "$sa" ] || [ -L "$sa" ]; } || continue
			sn=${sa##*/.xymon-plugin.}
			plain "$sn" && marked "$sa" "$sn" || continue
			[ -e "$EXTROOT/$sn" ] || [ -L "$EXTROOT/$sn" ] || v_untidy "$sn: $(stale "$sa" "$sn")"
		done
	fi
	while IFS="$(printf '\t')" read -r t at shown what pr; do
		[ -n "$t" ] || continue
		xh=; [ -z "$OWNOF" ] || xh=$(hx)
		if [ "$t" = '*' ]; then v_untidy "$shown, $what: ./xymon-plugin clean --$1$xh --all"
		else v_untidy "$shown, $what, which is gone: ./xymon-plugin clean --$1$xh $t"; fi
	done <<EOF
$(left "$1")
EOF
}

# clean_part PART -- S31: what is left of the plugins named, or with --all
# of every one and what they shared, listed, then, confirmed, taken away;
# only what is proved a plugin's. Exits 0 when nothing is left after it, 4
# when something is.
clean_part() {
	if [ "$1" = tools ]; then echo "Target: your tools, $PREFIX"; fi
	go= kept=0
	while IFS="$(printf '\t')" read -r t at shown what pr; do
		[ -n "$t" ] || continue
		if [ -z "$ALL" ]; then case " $(echo $NAMES) " in *" $t "*) ;; *) continue ;; esac; fi
		if [ "$pr" = proved ]; then go="$go$(printf '%s\t%s' "$at" "$shown, $what")
"
		else echo "Left: $shown, $what: not, byte for byte, what an install writes, so maybe not its own"; kept=$((kept + 1)); fi
	done <<EOF
$(left "$1")
EOF
	if [ -z "$go" ]; then
		[ "$kept" -eq 0 ] || exit 4
		echo "Nothing is left that no plugin installed owns."
		exit 0
	fi
	echo "To remove:"
	printf '%s' "$go" | cut -f2 | sed -e 's/^/  /'
	if [ -z "${YES:-}" ]; then
		if [ -t 0 ] && [ -t 1 ]; then
			offer "Proceed?" || { echo "Nothing removed."; exit 4; }
		else
			echo "Nothing removed: off a terminal, --yes removes it."
			exit 4
		fi
	fi
	while IFS="$(printf '\t')" read -r at what; do
		[ -n "$at" ] || continue
		rm -rf "$at" || die "could not remove $at"
		echo "Removed ${what%%, *}."
	done <<EOF
$go
EOF
	# It removed something: the installation it changed is remembered.
	[ -z "$REMEMBER" ] || remember_tree "$REMEMBER"
	[ "$kept" -eq 0 ] || exit 4
	exit 0
}

# verify_part PART ROOT -- every plugin installed in the part, or those
# named; with none named, what is left too.
verify_part() {
	# One a line: in a Xymon tree, with none named, every name in ext/.
	# shellcheck disable=SC2086 # the names, one a line
	if [ -n "$NAMES" ]; then L=$(printf '%s\n' $NAMES)
	elif [ "$1" != tools ]; then L=$(ext_names)
	else L=$(for d in "$2"/*; do [ -f "$d/VERSION" ] && echo "${d##*/}"; done); fi
	while IFS= read -r n; do
		[ -n "$n" ] || continue
		# In a Xymon tree, anything there is an install or none, said (S20).
		if [ -f "$2/$n/VERSION" ] || { [ "$1" != tools ] && { [ -e "$2/$n" ] || [ -L "$2/$n" ]; }; }; then verify_plugin "$1" "$2" "$n"
		else
			echo "$n: not installed"
			# What a run cut short set aside, its directory gone since.
			if [ "$1" != tools ] && { [ -e "$EXTROOT/.xymon-plugin.$n" ] || [ -L "$EXTROOT/.xymon-plugin.$n" ]; }; then
				v_untidy "$n: $(stale "$EXTROOT/.xymon-plugin.$n" "$n")"
			fi
		fi
	done <<EOX
$L
EOX
	# A part with nothing installed says so, as status does, rather than a
	# heading with nothing under it.
	[ -n "$L" ] || echo "no plugin"
	[ -n "$NAMES" ] || verify_left "$1"
}

# installed ROOT PLUGIN -- its VERSION there, read as X.Y.Z, or nothing.
installed() { [ -f "$1/$2/VERSION" ] && sed -e 's|^.*/v||' "$1/$2/VERSION"; }

# dialogue -- with no verb, on a terminal: where things stand, then what
# applies, nothing by default; the command those answers spell printed,
# confirmed and run, and nothing else; after an install, enabling offered
# as a second command, [y/N]; then it stops.
# findings PART ROOT PLUGIN -- what verify finds broken or untidy in the
# plugin, its words without the plugin's name and the command, "; "
# between; REPAIR set when an update puts it right.
findings() {
	verify_plugin "$1" "$2" "$3" | sed -n -e "s/^broken: $3: /broken: /p" -e "s/^untidy: $3: /untidy: /p" \
		| sed -e 's/: \.\/xymon-plugin [^:]*$//' | awk 'NR > 1 { printf "; " } { printf "%s", $0 } END { if (NR) print "" }'
}

# left_by PART -- what is left in the part, one line per plugin gone, "T	what, what".
left_by() {
	left "$1" | awk -F '\t' '{ x = $4; if ($1 != "*") sub(" of " $1 "$", "", x); w[$1] = (($1 in w) ? w[$1] ", " : "") x } END { for (t in w) print t "\t" w[t] }' | LC_ALL=C sort
}

dialogue() {
	me=$0
	if [ -n "$XYMONHOME" ] || [ -n "$(xymon_trees | sed -n 's/^server //p')" ]; then
		if [ -z "$XYMONHOME" ]; then
			SOFT=1
			choose_tree server || { XYMONHOME=; echo "No Xymon server chosen: what follows is your tools'."; }
			SOFT=
		fi
		[ -z "$XYMONHOME" ] || server_paths
	fi
	echo
	REPAIR_S= REPAIR_T= LEFT_S=
	if [ -n "$XYMONHOME" ]; then
		echo "Xymon server: $XYMONHOME"
		for n in $(all_plugins); do
			v=$(installed "$EXTROOT" "$n") || continue
			st=
			if [ -n "$(held "$EXTROOT" "$n" server-task)" ]; then
				if is_on "$n"; then st=", on"; else st=", off"; fi
			fi
			f=$(findings server "$EXTROOT" "$n")
			echo "  $n $v$st${f:+ -- $f}"
			# One no install left is no update's to repair (S20).
			[ -z "$f" ] || ! server_installed "$n" || REPAIR_S="$REPAIR_S $n"
		done
		LEFT_S=$(left_by server)
		printf '%s\n' "$LEFT_S" | while IFS='	' read -r t w; do
			[ -n "$t" ] || continue
			if [ "$t" = '*' ]; then echo "  left: $w"; else echo "  left by $t, gone: $w"; fi
		done
		show_client "$XYMONHOME"
	else
		echo "No Xymon server here."
	fi
	echo "Your tools, $PREFIX:"
	for n in $(all_plugins); do
		v=$(installed "$TOOLSROOT" "$n") || continue
		f=$(findings tools "$TOOLSROOT" "$n")
		echo "  $n $v${f:+ -- $f}"
		[ -z "$f" ] || REPAIR_T="$REPAIR_T $n"
	done
	LEFT_T=$(left_by tools)
	printf '%s\n' "$LEFT_T" | while IFS='	' read -r t w; do
		[ -n "$t" ] || continue
		if [ "$t" = '*' ]; then echo "  left: $w"; else echo "  left by $t, gone: $w"; fi
	done
	# What applies, one line each, its command after a tab.
	opts=
	add() { opts="$opts$1	$2
"; }
	# The installation, in the command printed, by --xymon-home; quoted
	# where a shell would split it.
	hx=; [ -z "$XYMONHOME" ] || hx=$(hx)
	# The plugins, those others need first.
	ordered() { for p in $(all_plugins); do echo "$(depth "$p" "$1" "") $p"; done | sort -n | cut -d' ' -f2; }
	short() { v=$(field "$1" "$2-short"); [ -n "$v" ] || v=$(field "$1" summary); printf '%s\n' "$v"; }
	if [ -n "$XYMONHOME" ]; then
		for n in $(ordered server); do
			[ -n "$(field "$n" server-files)" ] || continue
			# Anything there, an install or not, is no install's to offer.
			{ [ -e "$EXTROOT/$n" ] || [ -L "$EXTROOT/$n" ]; } && continue
			w=; for d in $(needs "$n" server 2>/dev/null); do installed "$EXTROOT" "$d" >/dev/null || w="$w $d"; done
			add "install $n on the server${w:+, with$w}: $(short "$n" server)" "$me install --server$hx $n"
		done
		any=
		for n in $(all_plugins); do
			server_installed "$n" || continue
			any=1
			[ -n "$(held "$EXTROOT" "$n" server-task)" ] || continue
			if is_on "$n"; then add "turn $n off" "$me disable --server$hx $n"
			else add "turn $n on" "$me enable --server$hx $n"; fi
		done
		[ -z "$any" ] || add "update the server's plugins${REPAIR_S:+, which repairs$REPAIR_S}" "$me update --server$hx"
		for n in $(all_plugins); do
			server_installed "$n" || continue
			by=
			for p in $(all_plugins); do
				server_installed "$p" || continue
				case " $(needs "$p" server "$EXTROOT" 2>/dev/null) " in *" $n "*) by="$by $p" ;; esac
			done
			[ -z "$by" ] || continue
			add "remove $n from the server" "$me remove --server$hx $n"
		done
		ga=
		for t in $(printf '%s\n' "$LEFT_S" | cut -f1); do
			if [ "$t" = '*' ]; then ga=1; else add "take away what $t left on the server" "$me clean --server$hx --yes $t"; fi
		done
		[ -z "$ga" ] || add "take away what no plugin uses on the server" "$me clean --server$hx --all --yes"
	fi
	tany=
	for n in $(ordered tools); do
		[ -n "$(field "$n" tools-files)" ] || continue
		if installed "$TOOLSROOT" "$n" >/dev/null; then tany=1; continue; fi
		add "install $n for you: $(short "$n" tools)" "$me install --tools $n"
	done
	[ -z "$tany" ] || add "update your tools${REPAIR_T:+, which repairs$REPAIR_T}" "$me update --tools"
	ga=
	for t in $(printf '%s\n' "$LEFT_T" | cut -f1); do
		if [ "$t" = '*' ]; then ga=1; else add "take away what $t left in your tools" "$me clean --tools --yes $t"; fi
	done
	[ -z "$ga" ] || add "take away what no plugin uses in your tools" "$me clean --tools --all --yes"
	echo
	echo "What do you want to do?"
	echo "  0) nothing"
	i=0
	printf '%s' "$opts" | while IFS='	' read -r label cmd; do
		i=$((i + 1)); echo "  $i) $label"
	done
	n=$(printf '%s' "$opts" | grep -c .)
	printf 'What do you want to do? [0] '
	read -r ans || ans=
	case $ans in ''|0) echo "Nothing done."; return 0 ;; *[!0-9]*) die "no such choice: $ans" ;; esac
	[ "$ans" -le "$n" ] || die "no such choice: $ans"
	cmd=$(printf '%s' "$opts" | sed -n "${ans}p" | cut -f2)
	echo "I will run:  $cmd"
	printf 'Proceed? [Y/n] '
	read -r yn || yn=n
	case $yn in [Nn]*) echo "Nothing done."; return 0 ;; esac
	eval "$cmd" || exit $?
	# After an install of a part with a task: enabling, a second command,
	# Enter declining it.
	case $cmd in
		*" install --server "*)
			n=${cmd##* }
			if [ -n "$(field "$n" server-task)" ]; then
				ecmd="$me enable --server$hx $n"
				echo "Turn it on now?"
				echo "I will run:  $ecmd"
				if offer "Proceed?"; then eval "$ecmd" || exit $?; else echo "$n stays off: $ecmd turns it on."; fi
			fi ;;
	esac
}

if [ "$VERB" = dialogue ]; then dialogue; exit 0; fi

# xpart -- XPART, the Xymon part status and verify read in XYMONHOME: the
# one named; with none, a client's when it names a client's tree -- a
# server's own refused, naming that server -- else the server's.
xpart() {
	XPART=$PART
	[ "$XPART" = both ] || return 0
	XPART=server
	if [ -z "$DESTDIR" ] && [ "$(marks "$XYMONHOME")" = client ]; then own_refused; XPART=client; fi
}
# client_read TREE -- XYMONHOME and its paths set to TREE, a client tree
# detection found: true when status and verify may read it, else its
# refusal said instead, as for one named (S25).
client_read() {
	XYMONHOME=$1; server_paths
	why=$( (client_home_ok read) 2>&1 >/dev/null) && return 0
	echo "  not read: ${why#xymon-plugin: }"
	return 1
}

# The part acted on: named, one at a time; or, on a terminal, the server
# part, said, but on a client's tree named, whose part is given; off a
# terminal a verb that changes something needs it named; status and
# verify and outdated cover every part.
if [ "$(( ${SEL_SERVER:-0} + ${SEL_CLIENT:-0} + ${SEL_TOOLS:-0} ))" -gt 1 ]; then
	case $VERB in
		status|verify|outdated) die "one part at a time: ./xymon-plugin $VERB, with none, covers every part: the servers, the standalone clients and the tools" ;;
	esac
	rest=$(echo $NAMES)${ALL:+ --all}
	cmds=
	[ -z "$SEL_SERVER" ] || cmds="$cmds
  ./xymon-plugin $VERB --server${rest:+ $rest}"
	[ -z "$SEL_CLIENT" ] || cmds="$cmds
  ./xymon-plugin $VERB --client${rest:+ $rest}"
	[ -z "$SEL_TOOLS" ] || cmds="$cmds
  ./xymon-plugin $VERB --tools${rest:+ $rest}"
	die "one part at a time, as the tools are the person's and a Xymon part its tree's owner's: run$cmds"
fi
case $VERB in status|verify|outdated) ;; *)
	if [ -z "$SEL_SERVER$SEL_CLIENT$SEL_TOOLS" ] && [ -n "$XYMONHOME" ] && [ -z "$DESTDIR" ] && [ "$(marks "$XYMONHOME")" = client ]; then
		# A server's own client tree: the server named, as with --server.
		own_refused
		rest=$(echo $NAMES)${ALL:+ --all}
		die "$XYMONHOME is a Xymon client's tree, whose part is named: ./xymon-plugin $VERB --client$(hx)${rest:+ $rest}"
	fi ;;
esac
if [ -n "$SEL_TOOLS" ]; then PART=tools
elif [ -n "$SEL_SERVER" ]; then PART=server
elif [ -n "$SEL_CLIENT" ]; then PART=client
elif [ "$VERB" = status ] || [ "$VERB" = verify ] || [ "$VERB" = outdated ]; then PART=both
elif [ -t 0 ] && [ -t 1 ]; then PART=server; echo "Part: server, as none is named."
else die "$VERB names no part, and there is no terminal to say it: --server, --client, or --tools"
fi
if [ "$PART" = client ]; then
	[ -z "$VENV_FETCH" ] || die "--venv: a client part has no virtualenv"
	[ -z "$DESTDIR" ] || die "DESTDIR: a client part is not staged yet, only installed in a client's tree"
fi
case $VERB in enable|disable) [ "$PART" != tools ] || die "the tools have no task to turn on or off" ;; esac
if [ "$PART" = tools ] && [ -n "$ROOTUSER" ] && [ "$VERB" != status ] && [ "$VERB" != verify ] && [ "$VERB" != outdated ] && [ -z "$DESTDIR" ] && [ -z "$PREFIX_GIVEN" ]; then
	die "the tools go in a person's own directory, not root's: run this without sudo, or give PREFIX= or DESTDIR="
fi
# What needs no installation is checked before one is asked for: the names,
# --all, and, for install and update, which take the code from this
# checkout, a plugin of it.
for n in $NAMES; do plain "$n" || die "not a plugin name: '$n'"; done
[ -z "$NAMES" ] || [ -z "$ALL" ] || die "--all, or plugins named: not both"
case $VERB in
	install|remove|clean)
		[ -n "$NAMES" ] || [ -n "$ALL" ] \
			|| die "name the plugins to $VERB, or --all: the plugins are $(echo $(all_plugins))" ;;
esac
case $VERB in
	install|update)
		for n in $NAMES; do
			[ -f "$ROOT/plugins/$n/PLUGIN" ] || die "no plugin $n here: the plugins are $(echo $(all_plugins))"
			[ "$PART" != client ] || [ -n "$(field "$n" client-files)" ] || die "$n has no client part"
		done ;;
esac
# The installation, named or chosen, once, before anything is looked at in
# it; status reads it apart.
case $PART in server|client) [ "$VERB" = status ] || [ "$VERB" = verify ] || [ "$VERB" = outdated ] || need_home "$PART" ;; esac
[ "$VERB" = clean ] || own_named
if [ "$PART" = tools ]; then PARTROOT=$TOOLSROOT; else PARTROOT=$EXTROOT; fi

# The plugins named, each checked; or, for install and remove, --all, which
# they need when none is named; for an uninstall, the deepest first, so that
# none is removed while one installed needs it.
# clean names plugins gone, which may be in no checkout: a plain name is enough.
[ "$VERB" = clean ] || for n in $NAMES; do known "$n"; done
if [ -n "$NAMES" ]; then LIST=$NAMES; else LIST=$(all_plugins); fi
deepest_first() {
	for n in $LIST; do echo "$(depth "$n" "$2" "$1") $n"; done | sort -rn | cut -d' ' -f2
}

case $VERB in
	install)
		RESUME=1
		for n in $LIST; do [ ! -f "$ROOT/plugins/$n/PLUGIN" ] || declared_ok "$n"; done
		# A plugin named that is installed already is refused, before
		# anything changes; --all and what one needs pass over them.
		for n in $NAMES; do
			v=$(installed "$PARTROOT" "$n") || continue
			# A directory no install completed: client_ok, xymon_ok say so.
			case $PART in client|server) "${PART}_installed" "$n" || continue ;; esac
			die "$n is installed already ($v): ./xymon-plugin update --$PART $n"
		done
		if [ "$PART" = server ]; then
			for n in $LIST; do [ -n "$(field "$n" server-files)" ] || [ -n "$NAMES" ] || continue; xymon_ok "$n"; done
			reads_d
			for n in $LIST; do [ -n "$(field "$n" server-files)" ] || [ -n "$NAMES" ] || continue; install_server "$n"; done
		elif [ "$PART" = client ]; then
			for n in $LIST; do [ -n "$(field "$n" client-files)" ] || [ -n "$NAMES" ] || continue; client_ok "$n"; done
			for n in $LIST; do [ -n "$(field "$n" client-files)" ] || [ -n "$NAMES" ] || continue; install_client "$n"; done
		else
			for n in $LIST; do [ -n "$(field "$n" tools-files)" ] || [ -n "$NAMES" ] || continue; install_tools "$n"; done
		fi
		manifests ;;
	update)
		UPDATING=1 RESUME=1
		for n in $LIST $NAMES; do [ ! -f "$ROOT/plugins/$n/PLUGIN" ] || declared_ok "$n"; done
		for n in $NAMES; do
			# Something there no install left is said as such, not as absent.
			case $PART in server|client) part_left "$PART" "$n" ;; esac
			installed "$PARTROOT" "$n" >/dev/null || { case $PART in server|client) cut_short "$n" ;; *) false ;; esac; } \
				|| die "$n is not installed: ./xymon-plugin install --$PART $n"
		done
		if [ -z "$NAMES" ]; then
			# What is installed, and nothing else ext/ may hold; one this
			# checkout does not have -- a release's archive holds its own
			# plugin alone -- is passed over, said, before anything changes,
			# rather than met halfway (S24).
			case $PART in
				server|client) LIST=$(installs "$PART") ;;
				*) LIST=$(for n in $(with_installed "$PARTROOT"); do [ -f "$PARTROOT/$n/VERSION" ] && echo "$n"; done) ;;
			esac
			[ -n "$LIST" ] || die "nothing is installed in $PARTROOT to update"
			LIST=$(for n in $LIST; do
				if [ -f "$ROOT/plugins/$n/PLUGIN" ]; then echo "$n"; else echo "$n is not in this checkout: left as it is" >&2; fi
			done)
			[ -n "$LIST" ] || die "none of the plugins installed in $PARTROOT is in this checkout: nothing to update"
		fi
		if [ "$PART" = server ]; then
			for n in $LIST; do xymon_ok "$n"; done
			reads_d
			for n in $LIST; do install_server "$n"; done
		elif [ "$PART" = client ]; then
			for n in $LIST; do client_ok "$n"; done
			for n in $LIST; do install_client "$n"; done
		else
			for n in $LIST; do install_tools "$n"; done
		fi
		manifests ;;
	enable|disable)
		# A plugin named with no task is refused; with none named, those
		# with no task are passed over.
		for n in $NAMES; do
			[ -n "$(held "$EXTROOT" "$n" "$TASKKEY")" ] || die "$n has no task to turn on or off"
		done
		[ -n "$NAMES" ] || LIST=$(with_installed "$EXTROOT")
		# enable refuses a plugin whose Python lacks the modules it needs,
		# before any is turned on.
		if [ "$VERB" = enable ] && [ "$PART" = server ]; then
			for n in $(installed_tasks); do
				m=$(missing_modules "$n")
				[ -z "$m" ] || die "$n needs the Python modules $m, which the Python it runs with lacks: ./xymon-plugin update --server --venv $n makes them, or XYMONAPI_PYTHON names a Python that has them"
			done
		fi
		for n in $(installed_tasks); do "$VERB" "$n"; done ;;
	status)
		# None named: every installation found is listed, and nothing is
		# asked, on a terminal as off one.
		if [ "$PART" != tools ] && [ -z "$XYMONHOME" ] && [ -z "$DESTDIR" ]; then
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon server $t:"
				XYMONHOME=$t; server_paths
				L=$LIST; [ -n "$NAMES" ] || L=$(with_installed "$EXTROOT")
				for n in $L; do l=$(status server "$EXTROOT" "$n"); [ -z "$l" ] || echo "  $l"; done
				show_client "$t"
			done <<EOF
$([ "$PART" = client ] || xymon_trees | sed -n 's/^server //p')
EOF
			# Then the standalone clients, each with what it holds.
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon client $t:"
				client_read "$t" || continue
				L=$LIST; [ -n "$NAMES" ] || L=$(with_installed "$EXTROOT")
				for n in $L; do l=$(status client "$EXTROOT" "$n"); [ -z "$l" ] || echo "  $l"; done
			done <<EOF
$([ "$PART" = server ] || xymon_trees | sed -n 's/^client //p')
EOF
			XYMONHOME=
		elif [ "$PART" != tools ]; then
			xpart; need_home "$XPART"
			echo "Xymon $XPART $XYMONHOME:"
			L=$LIST; [ -n "$NAMES" ] || L=$(with_installed "$EXTROOT")
			for n in $L; do l=$(status "$XPART" "$EXTROOT" "$n"); [ -z "$l" ] || echo "  $l"; done
			[ -n "$DESTDIR" ] || [ "$XPART" = client ] || show_client "$XYMONHOME"
		fi
		if [ "$PART" = tools ] || [ "$PART" = both ]; then
			L=$LIST; [ -n "$NAMES" ] || L=$(with_installed "$TOOLSROOT")
			[ "$PART" = tools ] || echo "Your tools, $PREFIX:"
			for n in $L; do
				l=$(status tools "$TOOLSROOT" "$n")
				if [ -z "$l" ]; then :; elif [ "$PART" = tools ]; then echo "$l"; else echo "  $l"; fi
			done
		fi ;;
	outdated)
		# Read-only, as status: what is installed, against the latest
		# release of each plugin. GitHub not reached ends with 1 before
		# anything is read; then a VERSION that cannot be compared with 7,
		# else a newer one released with 6 -- every line said either way.
		NEWER='' UNCOMPARED=''
		RELEASES=$(releases) || exit 1
		if [ "$PART" != tools ] && [ -z "$XYMONHOME" ] && [ -z "$DESTDIR" ]; then
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon server $t:"
				XYMONHOME=$t; server_paths
				outdated_part server "$EXTROOT" "  "
			done <<EOF
$([ "$PART" = client ] || xymon_trees | sed -n 's/^server //p')
EOF
			# Then the standalone clients, as status lists them.
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon client $t:"
				client_read "$t" || { UNCOMPARED=1; continue; }
				outdated_part client "$EXTROOT" "  "
			done <<EOF
$([ "$PART" = server ] || xymon_trees | sed -n 's/^client //p')
EOF
			XYMONHOME=
		elif [ "$PART" != tools ]; then
			xpart; need_home "$XPART"
			echo "Xymon $XPART $XYMONHOME:"
			outdated_part "$XPART" "$EXTROOT" "  "
		fi
		if [ "$PART" = tools ] || [ "$PART" = both ]; then
			[ "$PART" = tools ] || echo "Your tools, $PREFIX:"
			if [ "$PART" = tools ]; then outdated_part tools "$TOOLSROOT" ""; else outdated_part tools "$TOOLSROOT" "  "; fi
		fi
		[ -z "${UNCOMPARED:-}" ] || exit 7
		[ -z "${NEWER:-}" ] || exit 6 ;;
	verify)
		# None named: every installation found, as status lists them.
		if [ "$PART" != tools ] && [ -z "$XYMONHOME" ] && [ -z "$DESTDIR" ]; then
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon server: $t"
				XYMONHOME=$t; server_paths
				verify_part server "$EXTROOT"
			done <<EOF
$([ "$PART" = client ] || xymon_trees | sed -n 's/^server //p')
EOF
			while IFS= read -r t; do
				[ -n "$t" ] || continue
				echo "Xymon client: $t"
				client_read "$t" || continue
				verify_part client "$EXTROOT"
			done <<EOF
$([ "$PART" = server ] || xymon_trees | sed -n 's/^client //p')
EOF
			XYMONHOME=
		elif [ "$PART" != tools ]; then
			xpart; need_home "$XPART"
			echo "Xymon $XPART: $XYMONHOME"
			verify_part "$XPART" "$EXTROOT"
		fi
		if [ "$PART" = tools ] || [ "$PART" = both ]; then
			echo "Your tools: $PREFIX"
			verify_part tools "$TOOLSROOT"
		fi
		[ "$BROKEN" -eq 0 ] || exit 3
		[ "$UNTIDY" -eq 0 ] || exit 4
		exit 0 ;;
	clean)
		# A name given is a plugin gone: one installed is removed, not cleaned.
		for n in $NAMES; do
			[ ! -f "$PARTROOT/$n/VERSION" ] || die "$n is installed: ./xymon-plugin remove --$PART $n"
			[ "$PART" = tools ] || ! cut_short "$n" || die "$(no_install "$PART" "$n")"
		done
		clean_part "$PART" ;;
	remove)
		if [ "$PART" = server ]; then
			# Before anything goes: each name, an install's directory or
			# none, which removes what S9 leaves; any other is left as it
			# is, and so passed over with --all: rm -rf would take it.
			# A run going on is said as such, before what it leaves.
			for n in $NAMES; do running_ok "$n"; part_left server "$n"; done
			[ -n "$NAMES" ] || LIST=$(installs server absent)
			# xymon-plugin stands for its client part in the server's
			# client tree (S36): a client part there needing it keeps it.
			# shellcheck disable=SC2086,SC2116 # LIST, one line
			case " $(echo $LIST) " in *" $self "*)
				# Not under DESTDIR, where the host's own trees are no stage's.
				oc=; [ -n "$DESTDIR" ] || oc=$(client_of "$XYMONHOME")
				[ -z "$oc" ] || for d in "$oc/ext"/*; do
					if ! [ -f "$d/VERSION" ] || ! [ -f "$d/PLUGIN" ] || [ -L "$d/PLUGIN" ]; then continue; fi
					# Read as every need is, NAME:PART forms included.
					ns=$(needs "${d##*/}" client "$oc/ext") || exit 1
					case " $ns " in
						*" $self "*) die "$self is needed by ${d##*/}, in the client tree of this server, $oc, where the server's copy stands for its client part: ./xymon-plugin remove --client --xymon-home $(shq "$XYMONHOME") ${d##*/} first" ;;
					esac
				done ;;
			esac
			for n in $LIST; do running_ok "$n"; done
			# And each needed by no install that stays (S3), before
			# anything goes, the stage included.
			# shellcheck disable=SC2086,SC2116 # LIST, one line
			for n in $LIST; do needed "$n" server "$EXTROOT" "$(echo $LIST)"; done
			# The stage served at /plugins, pruned first, as an install
			# does: a link there would take the removal elsewhere.
			prune_dist
			REMOVED=
			for n in $(deepest_first "$EXTROOT" server); do uninstall_server "$n"; done
			# With the last plugin, what they shared: the virtualenv (S8);
			# only once an install went, not for what S9 leaves alone.
			last=$REMOVED; for d in "$EXTROOT"/*; do present "${d##*/}" && last=; done
			[ -z "$last" ] || [ ! -d "$EXTROOT/venv" ] || { rm -rf "$EXTROOT/venv" && echo "Removed the virtualenv, which no plugin uses now."; }
			# The stage served at /plugins, with no plugin left in it, goes.
			if [ -n "$REMOVED" ] && [ -d "$DIST" ] && [ ! -L "$DIST" ] && [ -z "$(ls -A "$DIST/plugins" 2>/dev/null)" ]; then
				rm -rf "$DIST" || exit 1
				echo "Removed the stage /plugins serves, which no plugin uses now."
			fi
		elif [ "$PART" = client ]; then
			# Before anything goes: each name, a client part an install
			# completed here, needed by no plugin installed that stays, or
			# not there at all, which removes nothing. Any other directory
			# is left as it is: ext/ may hold anything, and rm -rf would
			# take it.
			for n in $NAMES; do
				if [ ! -e "$EXTROOT/$n" ] && [ ! -L "$EXTROOT/$n" ]; then
					[ ! -f "$ROOT/plugins/$n/PLUGIN" ] || [ -n "$(field "$n" client-files)" ] || die "$n has no client part: --server, or --tools"
					continue
				fi
				running_ok "$n"
				part_left client "$n"
				needed "$n" client "$EXTROOT" "$NAMES"
			done
			[ -n "$NAMES" ] || LIST=$(installs client)
			# Remembered only once something is removed.
			REMEMBER=
			REMOVED=
			for n in $(deepest_first "$EXTROOT" client); do uninstall_client "$n"; done
		else
			[ -n "$NAMES" ] || LIST=$(with_installed "$TOOLSROOT")
			for n in $(deepest_first "$TOOLSROOT" tools); do uninstall_tools "$n"; done
			last=1; for d in "$TOOLSROOT"/*; do [ -f "$d/VERSION" ] && last=; done
			if [ -n "$last" ]; then
				[ ! -d "$TOOLSROOT/venv" ] || { rm -rf "$TOOLSROOT/venv" && echo "Removed the virtualenv, which no plugin uses now."; }
				rmdir "$TOOLSROOT" 2>/dev/null || true
			fi
		fi ;;
esac
# A Xymon part changed: install and update by a MANIFEST to write, remove
# by a directory gone.
case $PART$VERB in
	serverinstall|serverupdate|clientinstall|clientupdate) [ -z "$MANIFESTS" ] || COLUMN=1 ;;
	serverremove|clientremove) [ -z "$REMOVED" ] || COLUMN=1 ;;
esac
column
# The installation a run changed, remembered now that it is done (S25).
[ -z "$REMEMBER" ] || remember_tree "$REMEMBER"
